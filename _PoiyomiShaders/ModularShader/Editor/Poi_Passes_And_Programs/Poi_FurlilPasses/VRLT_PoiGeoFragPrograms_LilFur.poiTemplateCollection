#T#PoiInterpolatorsLilFur
#ifdef POI_PASS_LILFUR
	struct PoiVertToGeoLilFur
	{
		float4 uv[2] : TEXCOORD0;
		float3 worldPos : TEXCOORD2;
		// xyz: world space normal
		// w:   renderer scale
		float4 normal : TEXCOORD3;
		uint vertexId : TEXCOORD4;
		float3 furVector : TEXCOORD5;
		float fogData : TEXCOORD6;
		float4 tangent : TEXCOORD9;
		float4 lightmapUV : TEXCOORD10;
		half4 vertexColor : TEXCOORD11;
		#ifdef POI_SQUISH
			float squishAmount : TEXCOORD7;
		#endif
		#ifdef POIBS_BLOOMFOG
			float2 bsFogScreenUV : TEXCOORD8;
		#endif
		UNITY_VERTEX_INPUT_INSTANCE_ID
	};

	struct PoiGeoToFragLilFur
	{
		float4 pos : SV_POSITION;
		float4 uv[2] : TEXCOORD0;
		float3 worldPos : TEXCOORD2;
		// xyz: world space normal
		// w:   renderer scale
		float4 normal : TEXCOORD3;
		float furLayer : TEXCOORD5;
		float fogData : TEXCOORD6;
		float4 tangent : TEXCOORD9;
		float4 lightmapUV : TEXCOORD10;
		half4 vertexColor : TEXCOORD12;
		POI_SHADOW_COORDS(11)
		#ifdef POI_SQUISH
			float squishAmount : TEXCOORD7;
		#endif
