            half4 rimColor = RimColor;
            half4 rimIndirColor = RimIndirColor;
            if(RimTexMaskOnly > 0)
            {
                rimColor.a *= RimColorTex.r;
                rimIndirColor.a *= RimColorTex.r;
            }
            else
            {
                rimColor *= RimColorTex;
                rimIndirColor *= RimColorTex;
