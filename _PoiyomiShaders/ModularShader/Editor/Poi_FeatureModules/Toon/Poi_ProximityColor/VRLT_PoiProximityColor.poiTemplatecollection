#T#PoiProximityColorFunctionCalls
//ifex _FXProximityColor==0
if (_FXProximityColor >= 0.5)
{
	float3 position = _FXProximityColorType ? poiMesh.worldPos : poiMesh.objectPosition;
	float dist = distance(position, poiCam.worldPos);
	float lerpVal = inverseLerp(_FXProximityColorMinDistance, _FXProximityColorMaxDistance, dist);
	lerpVal = poiSampleCurve4(_FXProximityColorCurve, lerpVal);
	float halfW = saturate(_FXProximityColorEdgeWidth * 0.5);
	bool inEdge = (_FXProximityColorSolid >= 0.5) && (lerpVal > (0.5 - halfW)) && (lerpVal < (0.5 + halfW));
	
	if (_FXProximityColorSolid >= 0.5)
	{
		lerpVal = step(0.5, lerpVal);
	}
	half3 proxColor = lerp(
		poiThemeColor(poiMods, _FXProximityColorMinColor.rgb, _FXProximityColorMinColorThemeIndex),
		poiThemeColor(poiMods, _FXProximityColorMaxColor.rgb, _FXProximityColorMaxColorThemeIndex),
		lerpVal);

	if (_FXProximityColorOverrideColor >= 0.5)
	{
		poiFragData.finalColor *= proxColor;
		poiFragData.finalColor *= inEdge ? _FXProximityColorEdgeColor.rgb : 1.0;
	}
	
	if (_FXProximityColorOverrideEmission >= 0.5)
	{
		poiFragData.emission *= proxColor;
		poiFragData.emission *= inEdge ? _FXProximityColorEdgeColor.rgb : 1.0;
	}

	if (_FXProximityColorBackFace >= 0.5)
	{
		poiFragData.finalColor = lerp(
			poiFragData.finalColor * _FXProximityColorMinColor.rgb,
			poiFragData.finalColor,
			saturate(poiMesh.isFrontFace));
	}
}
//endex

#T#PoiProximityColorAlphaReplace
//ifex _FXProximityColor==0
if (_FXProximityColor >= 0.5 && _FXProximityColorOverrideAlpha >= 0.5)
{
	float3 position = _FXProximityColorType ? poiMesh.worldPos : poiMesh.objectPosition;
	float dist = distance(position, poiCam.worldPos);
	float lerpVal = inverseLerp(_FXProximityColorMinDistance, _FXProximityColorMaxDistance, dist);
	lerpVal = poiSampleCurve4(_FXProximityColorCurve, lerpVal);
	if (_FXProximityColorSolid >= 0.5)
	{
		lerpVal = step(0.5, lerpVal);
	}
	poiFragData.alpha *= lerp(_FXProximityColorMinColor.a, _FXProximityColorMaxColor.a, lerpVal);

	#if defined(POI_PASS_SHADOW) || defined(POI_PASS_DEPTH_ONLY) || defined(POI_PASS_DEPTH_NORMALS)
		poiFragData.alpha = poiFragData.alpha < 1.0 ? 0 : 1.0;
	#endif
}
//endex
