    half _BacklightNormalStrength;
    half _BacklightBorder;
    half _BacklightBlur;
    half _BacklightDirectivity;
    half _BacklightViewStrength;
    int _BacklightReceiveShadow;
    int _BacklightBackfaceMask;
    half _BacklightGlobalMask;
    float _BacklightGlobalMaskBlendType;
    float _BacklightApplyGlobalMaskIndex;
