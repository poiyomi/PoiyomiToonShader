half4 grabpassBlur(float2 uv, float camDistance, half smoothness, half depthFade, half blurMask, half pixelMask, float pixelSize, float2 pixelAnchor)
{
	half roughnessInfluence = lerp(1, 1 - smoothness, _GrabBlurUseSmoothness);
	float effectiveDistance = lerp(1, camDistance, _GrabBlurFalloff);
	float scale = WorldToScreenScale(_GrabBlurDistance * roughnessInfluence * depthFade * blurMask * 0.1, effectiveDistance);
	float2 aspectCorrect = GetScreenAspectCorrection();
	float sourceTexelRadius = abs(scale) * _PoiOpaqueTex_TexelSize.w;
	if (sourceTexelRadius < 1.0)
		return POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(uv, pixelMask, pixelSize, pixelAnchor));
	
	half4 color = 0;
	half totalWeight = 0;
	int quality = min((int)floor(_GrabBlurQuality), POI_GRAB_BLUR_MAX_QUALITY);
	int maxSamples = quality * quality;
	float blurPixelRadius = scale * _ScreenParams.y;
	int samples = min((int)clamp(ceil(UNITY_PI * blurPixelRadius * blurPixelRadius), 4.0, (float)maxSamples), POI_GRAB_BLUR_MAX_SAMPLES);

	switch (_GrabBlurPattern)
	{
		case 0: // Sunflower - Golden angle spiral
		{
			const float goldenAngle = 2.39996323;
			[loop]
			for (int i = 0; i < samples; i++)
			{
				float r = sqrt((i + 0.5) / samples);
				float theta = i * goldenAngle;
				float adjustedR = pow(r, _GrabBlurPower + 1);
				float2 offset = float2(cos(theta), sin(theta)) * adjustedR * scale * aspectCorrect;
				half weight = 1.0 - r * _GrabBlurPower;
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(uv + offset, pixelMask, pixelSize, pixelAnchor)) * weight;
				totalWeight += weight;
			}
			break;
		}
		case 1: // Gaussian - Spiral with gaussian weights
		{
			const float goldenAngle = 2.39996323;
			[loop]
			for (int i = 0; i < samples; i++)
			{
				float r = sqrt((i + 0.5) / samples);
				float theta = i * goldenAngle;
				float2 offset = float2(cos(theta), sin(theta)) * r * scale * aspectCorrect;
				half weight = exp(-r * r * (3.0 + _GrabBlurPower * 5.0));
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(uv + offset, pixelMask, pixelSize, pixelAnchor)) * weight;
				totalWeight += weight;
			}
			break;
		}
		case 2: // Hexagonal Bokeh - 6-sided shape (point at bottom)
		{
			const float goldenAngle = 2.39996323;
			const float hexRotation = UNITY_PI / 6.0;
			[loop]
			for (int i = 0; i < samples; i++)
			{
				float r = sqrt((i + 0.5) / samples);
				float theta = i * goldenAngle;
				float2 dir = float2(cos(theta), sin(theta));
				float sectorAngle = atan2(dir.y, dir.x) + hexRotation;
				float angleInSector = fmod(abs(sectorAngle), UNITY_PI / 3.0) - UNITY_PI / 6.0;
				float hexScale = cos(UNITY_PI / 6.0) / cos(angleInSector);
				float2 offset = dir * r * hexScale * scale * aspectCorrect;
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(uv + offset, pixelMask, pixelSize, pixelAnchor));
				totalWeight += 1.0;
			}
			break;
		}
		case 3: // Gaussian - baked progressive kernel
		{
			int sampleBudget = min(_GrabBlurQuality <= 4 ? 4 : (_GrabBlurQuality <= 8 ? 8 : (_GrabBlurQuality <= 16 ? 16 : 32)), POI_GRAB_BLUR_MAX_BAKED_SAMPLES);
			float coveredSamples = ceil(UNITY_PI * sourceTexelRadius * sourceTexelRadius);
			int bakedSamples = 4;
			if (sampleBudget >= 8 && coveredSamples > 4.0) bakedSamples = 8;
			if (sampleBudget >= 16 && coveredSamples > 8.0) bakedSamples = 16;
			if (sampleBudget >= 32 && coveredSamples > 16.0) bakedSamples = 32;
			bakedSamples = min(bakedSamples, POI_GRAB_BLUR_MAX_BAKED_SAMPLES);

			half2 bakedWeightSums = bakedSamples == 4 ? float2(1.71842691, 1.02028086) :
				(bakedSamples == 8 ? float2(2.89948330, 1.39562121) :
				(bakedSamples == 16 ? float2(5.30323938, 2.24210826) : float2(10.13189379, 3.98826393)));

			[loop]
			for (int i = 0; i < bakedSamples; i++)
			{
				half4 kernel = POI_GRAB_BLUR_GAUSSIAN_KERNEL[i];
				half weight = lerp(kernel.z, kernel.w, _GrabBlurPower);
				float2 offset = kernel.xy * scale * aspectCorrect;
				color += POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(uv + offset, pixelMask, pixelSize, pixelAnchor)) * weight;
			}
			totalWeight = lerp(bakedWeightSums.x, bakedWeightSums.y, _GrabBlurPower);
			break;
		}
		default:
			return POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(uv, pixelMask, pixelSize, pixelAnchor));
	}

	color /= max(totalWeight, EPSILON);
	return color;
}

float getGrabBlurDepthFade(float2 screenPos, float4 direction, float3 fragmentWorldPos)
{
	if (_GrabBlurUseDepth < 0.5) return 1;
	if (!DepthTextureExists()) return 1;
	
	float z = SampleScreenDepth(screenPos);
	
	float backgroundDepth = CorrectedLinearEyeDepth(z, direction.w);
	float3 backgroundWorldPos = direction.xyz * backgroundDepth + getCameraPosition(false);
	float depthDiff = distance(backgroundWorldPos, fragmentWorldPos);
	
	return lerp(_GrabBlurDepthRamp.x, _GrabBlurDepthRamp.y, smoothstep(_GrabBlurDepthRamp.z, _GrabBlurDepthRamp.w, depthDiff));
}
//endex

//ifex isNotAnimated(_RefractionEnabled) && _RefractionEnabled==0
inline half4 Refraction(float indexOfRefraction, half chromaticAberration, float camDistance, float4 direction, in PoiMesh poiMesh, in PoiCam poiCam, in PoiMods poiMods, inout PoiLight poiLight, in PoiFragData poiFragData, half refractionMask, half blurMask, half pixelMask, float pixelSize, float2 pixelAnchor, out float2 grabSampleUV)
{
	half4 refractionColor;
	float3 worldViewDir = normalize(PoiWorldSpaceViewDir(poiMesh.worldPos));
	float3 refractionOffset = (((indexOfRefraction - 1.0) * mul(UNITY_MATRIX_V, float4(poiMesh.normals[1], 0.0)).xyz) * (1.0 - dot(poiMesh.normals[1], worldViewDir)));
	float2 cameraRefraction = float2(refractionOffset.x, - (refractionOffset.y * _ProjectionParams.x)) * GetFOVScale() / max(camDistance, 1.0);
	cameraRefraction *= pow(saturate(1.0 - poiLight.nDotV), _RefractionFresnelPower);

	float2 bgRes = poiGetWidthAndHeight(_PoiOpaqueTex);
	float aspect = bgRes.y / max(bgRes.x, 1.0);
	cameraRefraction.x *= aspect;
	cameraRefraction *= refractionMask;

	float2 refractedGrab = poiCam.screenUV + cameraRefraction;
	grabSampleUV = refractedGrab;
	float depthFade = 1;
	//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
	depthFade = getGrabBlurDepthFade(refractedGrab, direction, poiMesh.worldPos);
	//endex

	UNITY_BRANCH
	if (_RefractionChromaticAberration > 0)
	{
		half4 redAlpha = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(poiCam.screenUV + cameraRefraction, pixelMask, pixelSize, pixelAnchor));
		half green = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(poiCam.screenUV + (cameraRefraction * (1.0 - chromaticAberration)), pixelMask, pixelSize, pixelAnchor)).g;
		half blue = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(poiCam.screenUV + (cameraRefraction * (1.0 + chromaticAberration)), pixelMask, pixelSize, pixelAnchor)).b;
		refractionColor = float4(redAlpha.r, green, blue, redAlpha.a);
	}
	else
	{
		//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
		#ifdef CHROMATIC_ABERRATION_LOW
			refractionColor = grabpassBlur(refractedGrab, camDistance, poiFragData.smoothness, depthFade, blurMask, pixelMask, pixelSize, pixelAnchor);
		#else
		//endex
			refractionColor = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(refractedGrab, pixelMask, pixelSize, pixelAnchor));
		//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
		#endif
		//endex
	}
	return refractionColor;
}
//endex

//ifex isNotAnimated(_GrabRampEnabled) && _GrabRampEnabled==0
void poiGrabRampPalette(int preset, out half3 c0, out half3 c1, out half3 c2, out half3 c3)
{
	// Custom Ramp with no texture assigned falls through to plain grayscale.
	c0 = half3(0.0h, 0.0h, 0.0h);
	c1 = half3(0.333333h, 0.333333h, 0.333333h);
	c2 = half3(0.666667h, 0.666667h, 0.666667h);
	c3 = half3(1.0h, 1.0h, 1.0h);

	switch (preset)
	{
		case 1: // Gameboy
			c0 = half3(0.058824h, 0.219608h, 0.058824h);
			c1 = half3(0.188235h, 0.384314h, 0.188235h);
			c2 = half3(0.545098h, 0.674510h, 0.058824h);
			c3 = half3(0.607843h, 0.737255h, 0.058824h);
			break;
		case 2: // Virtual Boy
			c0 = half3(0.0h, 0.0h, 0.0h);
			c1 = half3(0.333333h, 0.0h, 0.0h);
			c2 = half3(0.666667h, 0.0h, 0.0h);
			c3 = half3(1.0h, 0.0h, 0.0h);
			break;
		case 3: // CGA palette 1
			c0 = half3(0.0h, 0.0h, 0.0h);
			c1 = half3(0.333333h, 1.0h, 1.0h);
			c2 = half3(1.0h, 0.333333h, 1.0h);
			c3 = half3(1.0h, 1.0h, 1.0h);
			break;
		case 4: // Sepia
			c0 = half3(0.105882h, 0.070588h, 0.023529h);
			c1 = half3(0.419608h, 0.309804h, 0.164706h);
			c2 = half3(0.752941h, 0.627451h, 0.501961h);
			c3 = half3(1.0h, 0.941176h, 0.847059h);
			break;
		case 5: // Cyberpunk Neon
			c0 = half3(0.074510h, 0.027451h, 0.121569h);
			c1 = half3(0.329412h, 0.125490h, 0.470588h);
			c2 = half3(0.901961h, 0.215686h, 0.588235h);
			c3 = half3(0.282353h, 0.866667h, 0.890196h);
			break;
	}
}

half3 poiGrabColorRamp(half3 grabpassColor, float2 screenPixels)
{
	half3 gammaColor = max(grabpassColor, 0.0h);
	#if !UNITY_COLORSPACE_GAMMA
		gammaColor = LinearToGammaSpace(gammaColor);
	#endif
	half t = saturate(LinearRgbToLuminance(gammaColor));
	t = saturate((t - 0.5h) * (_GrabRampContrast + 1.0h) + 0.5h + _GrabRampOffset);

	if (_GrabRampQuantize >= 0.5)
	{
		half levels = max(floor(_GrabRampLevels), 2.0h);
		t = saturate(t + (PoiBayer8(floor(screenPixels)) - 0.5h) * _GrabRampDither / levels);
		t = min(floor(t * levels), levels - 1.0h) / (levels - 1.0h);
	}

	#if defined(PROP_GRABRAMPTEX) || !defined(OPTIMIZER_ENABLED)
		if (_GrabRampPreset == 0 && max(_GrabRampTex_TexelSize.z, _GrabRampTex_TexelSize.w) > 16)
		{
			return _GrabRampTex.SampleLevel(sampler_linear_clamp, float2(t, 0.5), 0).rgb;
		}
	#endif

	half3 c0, c1, c2, c3;
	poiGrabRampPalette(_GrabRampPreset, c0, c1, c2, c3);

	half s = t * 3.0h;
	half3 ramped = lerp(c0, c1, saturate(s));
	ramped = lerp(ramped, c2, saturate(s - 1.0h));
	ramped = lerp(ramped, c3, saturate(s - 2.0h));

	#if !UNITY_COLORSPACE_GAMMA
		ramped = GammaToLinearSpace(ramped);
	#endif
	return ramped;
}
//endex

half3 poiGrabSaturation(half3 color)
{
	half luminance = LinearRgbToLuminance(color);

	half chroma = max(color.r, max(color.g, color.b)) - min(color.r, min(color.g, color.b));
	color = lerp(luminance, color, 1.0h + _GrabVibrance * (1.0h - saturate(chroma)));

	return lerp(luminance, color, _GrabSaturation);
}

void applyGrabEffects(inout PoiFragData poiFragData, in PoiCam poiCam, in PoiMesh poiMesh, inout PoiLight poiLight, in PoiMods poiMods)
{
	half4 blendMask = 1;
	#if defined(PROP_GRABPASSBLENDMAP) || !defined(OPTIMIZER_ENABLED)
		if (_GrabPassMaskType == 0)
		{
			blendMask = POI2D_SAMPLER_PAN(_GrabPassBlendMap, _MainTex, poiUV(poiMesh.uv[_GrabPassBlendMapUV], _GrabPassBlendMap_ST), _GrabPassBlendMapPan);
		}
	#endif
	if (_GrabPassMaskType == 1) blendMask = poiMesh.vertexColor;

	//ifex isNotAnimated(_RefractionEnabled) && _RefractionEnabled==0
	half refractionMask = 1;
	//endex
	half blurMask       = 1;
	half colorMask      = 1;
	half alphaMask      = 1;
	half pixelMask      = 1;
	//ifex isNotAnimated(_GrabRampEnabled) && _GrabRampEnabled==0
	half rampMask       = 1;
	//endex

	//ifex isNotAnimated(_RefractionEnabled) && _RefractionEnabled==0
	if (_GrabRefractionMaskChannel < 4) refractionMask = _GrabRefractionMaskInvert ? 1 - blendMask[min(_GrabRefractionMaskChannel, 3)] : blendMask[min(_GrabRefractionMaskChannel, 3)];
	//endex
	//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
	if (_GrabBlurMaskChannel < 4)       blurMask       = _GrabBlurMaskInvert       ? 1 - blendMask[min(_GrabBlurMaskChannel, 3)]       : blendMask[min(_GrabBlurMaskChannel, 3)];
	//endex
	if (_GrabColorMaskChannel < 4)      colorMask      = _GrabColorMaskInvert      ? 1 - blendMask[min(_GrabColorMaskChannel, 3)]      : blendMask[min(_GrabColorMaskChannel, 3)];
	if (_GrabAlphaMaskChannel < 4)      alphaMask      = _GrabAlphaMaskInvert      ? 1 - blendMask[min(_GrabAlphaMaskChannel, 3)]      : blendMask[min(_GrabAlphaMaskChannel, 3)];
	//ifex isNotAnimated(_GrabPixelationEnabled) && _GrabPixelationEnabled==0
	if (_GrabPixelMaskChannel < 4)      pixelMask      = _GrabPixelMaskInvert      ? 1 - blendMask[min(_GrabPixelMaskChannel, 3)]      : blendMask[min(_GrabPixelMaskChannel, 3)];
	//endex
	//ifex isNotAnimated(_GrabRampEnabled) && _GrabRampEnabled==0
	if (_GrabRampMaskChannel < 4)       rampMask       = _GrabRampMaskInvert       ? 1 - blendMask[min(_GrabRampMaskChannel, 3)]       : blendMask[min(_GrabRampMaskChannel, 3)];
	//endex

	//ifex isNotAnimated(_RefractionEnabled) && _RefractionEnabled==0
	refractionMask = globalMaskBlend(refractionMask, _GrabRefractionGlobalMask, _GrabRefractionGlobalMaskBlendType, poiMods);
	//endex
	//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
	blurMask       = globalMaskBlend(blurMask,       _GrabBlurGlobalMask,       _GrabBlurGlobalMaskBlendType,       poiMods);
	//endex
	colorMask      = globalMaskBlend(colorMask,      _GrabColorGlobalMask,      _GrabColorGlobalMaskBlendType,      poiMods);
	alphaMask      = globalMaskBlend(alphaMask,      _GrabAlphaGlobalMask,      _GrabAlphaGlobalMaskBlendType,      poiMods);
	//ifex isNotAnimated(_GrabPixelationEnabled) && _GrabPixelationEnabled==0
	pixelMask      = globalMaskBlend(pixelMask,      _GrabPixelGlobalMask,      _GrabPixelGlobalMaskBlendType,      poiMods);
	//endex
	//ifex isNotAnimated(_GrabRampEnabled) && _GrabRampEnabled==0
	rampMask       = globalMaskBlend(rampMask,       _GrabRampGlobalMask,       _GrabRampGlobalMaskBlendType,       poiMods);
	//endex
	half blendFactor = lerp(0.0, (1 - poiFragData.alpha) * alphaMask, _GrabPassBlendFactor);
	#ifdef POI_PASS_SELF_GRAB
		blendFactor = _GrabPassBlendFactor * alphaMask;
	#endif

	//ifex isNotAnimated(_RefractionEnabled) && _RefractionEnabled==0
		if (_RefractionEnabled >= 0.5)
			poiLight.finalLighting = max(poiLight.finalLighting, EPSILON);
	//endex

	#ifdef POI_PASS_ADD
		poiFragData.baseColor = poiGrabClamp(poiBlend(_GrabSrcBlend, float4(poiFragData.baseColor, poiFragData.alpha), _GrabDstBlend, float4(0, 0, 0, 1), blendFactor).rgb);
		return;
	#endif

	float camDistance = poiCam.distanceToVert;
	float pixelSize = 1;
	float2 pixelAnchor = 0;
	//ifex isNotAnimated(_GrabPixelationEnabled) && _GrabPixelationEnabled==0
	pixelSize = poiGrabPixelSize(poiCam, poiMesh);
	pixelAnchor = poiGrabPixelAnchorUV(poiMesh);
	//endex

	float perspectiveDivide = 1.0f / poiCam.clipPos.w;
	float4 direction = poiCam.worldDirection * perspectiveDivide;
	
	#ifdef POI_PASS_SELF_GRAB
		half3 selfGrabSurface = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiCam.screenUV).rgb;
	#endif

	half3 grabpassColor = 1;
	float2 grabSampleUV = poiCam.screenUV;
	//ifex isNotAnimated(_RefractionEnabled) && _RefractionEnabled==0
	UNITY_BRANCH
	if (_RefractionEnabled >= 0.5)
	{
		grabpassColor = Refraction(_RefractionIndex, _RefractionChromaticAberration, camDistance, direction, poiMesh, poiCam, poiMods, poiLight, poiFragData, refractionMask, blurMask, pixelMask, pixelSize, pixelAnchor, grabSampleUV).rgb;
	}
	else
	//endex
	{
		float depthFade = 1;
		//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
		depthFade = getGrabBlurDepthFade(poiCam.screenUV, direction, poiMesh.worldPos);
		//endex
		//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
		#ifdef CHROMATIC_ABERRATION_LOW
			grabpassColor = grabpassBlur(poiCam.screenUV, camDistance, poiFragData.smoothness, depthFade, blurMask, pixelMask, pixelSize, pixelAnchor);
		#else
		//endex
			grabpassColor = POI_SAMPLE_SCREEN(_PoiOpaqueTex, sampler_linear_clamp, poiGrabPixelateUV(poiCam.screenUV, pixelMask, pixelSize, pixelAnchor)).rgb;
		//ifex isNotAnimated(_EnableBlur) && _EnableBlur==0
		#endif
		//endex
	}

	half3 tintedColor = (_GrabpassColor.rgb * grabpassColor * _GrabPassBrightness) + (_GrabPassAddBrightness * _GrabpassColor.rgb);

	//ifex isNotAnimated(_GrabPassHueShiftToggle) && _GrabPassHueShiftToggle==0
		UNITY_BRANCH
		if (_GrabPassHueShiftToggle >= 0.5)
		{
			tintedColor = hueShift(tintedColor, frac(_GrabPassHueShift + _GrabPassHueShiftSpeed * POI_TIME.x), _GrabPassHueShiftColorSpace, _GrabPassHueSelectOrShift);
		}
	//endex

	tintedColor = poiGrabSaturation(tintedColor);

	grabpassColor = lerp(grabpassColor, tintedColor, colorMask);

	//ifex isNotAnimated(_GrabRampEnabled) && _GrabRampEnabled==0
		UNITY_BRANCH
		if (_GrabRampEnabled >= 0.5)
		{
			half3 rampedColor = poiGrabColorRamp(grabpassColor, poiCam.posScreenPixels);
			grabpassColor = lerp(grabpassColor, rampedColor, _GrabRampBlend * rampMask);
		}
	//endex

	//ifex isNotAnimated(_GrabPixelationEnabled) && _GrabPixelationEnabled==0
		UNITY_BRANCH
		if (_GrabPixelationEnabled >= 0.5 && _GrabPixelGap > 0)
		{
			half gap = poiGrabPixelGapCut(grabSampleUV, poiGrabPixelBlock(pixelMask, pixelSize), pixelAnchor);
			poiFragData.alpha *= 1.0 - gap;
			blendFactor *= 1.0 - gap;
		}
	//endex

	// grabpassColor is the finished screen grab here, before it is blended onto the surface.
	// Modules that color the grab hook in at this point; anything filling it has to be queued
	// above 100, which is where this template lands.
	#K#GRABPASS_COLOR

	#ifdef POI_PASS_SELF_GRAB
		poiFragData.baseColor = poiGrabClamp(poiBlend(_GrabSrcBlend, float4(selfGrabSurface, 1), _GrabDstBlend, float4(grabpassColor, 1), blendFactor).rgb);
		return;
	#endif
	#ifdef POI_PASS_BASE
		half3 unlitGrab = grabpassColor / max(poiLight.finalLighting, EPSILON);
		poiFragData.baseColor = poiGrabClamp(poiBlend(_GrabSrcBlend, float4(poiFragData.baseColor, poiFragData.alpha), _GrabDstBlend, float4(unlitGrab, 1), blendFactor).rgb);
	#endif
}
//endex

#T#PoiGrabPassBlendingFunctionCalls
//ifex _EnableGrabpass==0
if (_EnableGrabpass >= 0.5)
{
	applyGrabEffects(poiFragData, poiCam, poiMesh, poiLight, poiMods);
}
//endex
