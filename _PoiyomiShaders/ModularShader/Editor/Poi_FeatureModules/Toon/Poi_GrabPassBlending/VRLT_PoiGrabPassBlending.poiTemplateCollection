half3 poiGrabClamp(half3 color)
{
	return clamp(color, 0, 1024);
}

//ifex isNotAnimated(_GrabPixelationEnabled) && _GrabPixelationEnabled==0
float2 poiGrabPixelBlock(half pixelMask, float pixelSize)
{
	half halvings = floor(saturate(1.0h - pixelMask) * 8.0h);
	float2 pixelBlock = _PoiOpaqueTex_TexelSize.xy * max(pixelSize * exp2(-halvings), 1.0);
	return clamp(pixelBlock, -1.0, 1.0);
}

float poiGrabPixelSize(in PoiCam poiCam, in PoiMesh poiMesh)
{
	float pixelSize = _GrabPixelSize;
	if (_GrabPixelDistanceScaling >= 0.5)
	{
		float camToObject = distance(poiCam.worldPos, poiMesh.objectPosition);
		pixelSize *= pow(poiMesh.objectScale / max(camToObject, EPSILON), _GrabPixelDistanceScalingAmount);
	}
	return pixelSize;
}

float2 poiGrabPixelAnchorUV(in PoiMesh poiMesh)
{
	float4 objectScreenPos = PoiComputeScreenPos(PoiWorldToClipPos(poiMesh.objectPosition));
	return clamp(objectScreenPos.xy / max(objectScreenPos.w, EPSILON), -8.0, 8.0);
}

// How much of the fragment the block gap eats, 0 outside it and 1 in its core.
half poiGrabPixelGapCut(float2 grabSampleUV, float2 pixelBlock, float2 pixelAnchor)
{
	float2 inBlock = frac((grabSampleUV - pixelAnchor) / pixelBlock);
	float edge = min(min(inBlock.x, 1.0 - inBlock.x), min(inBlock.y, 1.0 - inBlock.y));
	float2 fw = fwidth(grabSampleUV) / pixelBlock;
	float aa = max(fw.x, fw.y) * 0.5 + EPSILON;
	half gapEdge = _GrabPixelGap * 0.5;
	return 1.0 - smoothstep(gapEdge - aa, gapEdge + aa, edge);
}

//endex

float2 poiGrabPixelateUV(float2 uv, half pixelMask, float pixelSize, float2 pixelAnchor)
{
	//ifex isNotAnimated(_GrabPixelationEnabled) && _GrabPixelationEnabled==0
	if (_GrabPixelationEnabled >= 0.5)
	{
		float2 pixelBlock = poiGrabPixelBlock(pixelMask, pixelSize);
		return (floor((uv - pixelAnchor) / pixelBlock) + 0.5) * pixelBlock + pixelAnchor;
	}
	//endex

	return uv;
}

