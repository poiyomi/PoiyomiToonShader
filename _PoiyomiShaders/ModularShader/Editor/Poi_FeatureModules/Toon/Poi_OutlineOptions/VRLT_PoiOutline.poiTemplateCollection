#T#OutlineVertexOffset
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
		half4 outlineMaskTex = UNITY_SAMPLE_TEX2D_SAMPLER_LOD(_OutlineMask, _linear_repeat, poiUV(vertexUV(v, _OutlineMaskUV), _OutlineMask_ST) + POI_TIME.x * _OutlineMaskPan, 0);
		half outlineMask = outlineMaskTex[_OutlineMaskChannel];
		float outLineZOffset = abs(lerp(1, outlineMaskTex[_OutlineZOffsetChannel], _OutlineZOffsetMaskStrength) - _OutlineZOffsetInvertMaskChannel);
	#else
		half outlineMask = 1;
		float outLineZOffset = 1;
	#endif
	if (_OutlineVertexColorMask > 0)
	{
		outlineMask *= lerp(1, v.color[_OutlineVertexColorMask - 1], _OutlineVertexColorMaskStrength);
	}
	if (_OutlineZOffsetVertexColor)
	{
		outLineZOffset *= lerp(1, v.color[_OutlineZOffsetVertexColor - 1], _OutlineZOffsetVertexColorStrength);
	}

	float3 outlineNormal = _OutlineSpace ? o.normal.xyz : v.normal;
	//UNITY_BRANCH
	if (_OutlineUseVertexColorNormals >= 0.5)
	{
		float3 outlineTangent;
		float3 outlineBinormal;
		if (_OutlineSpace) // 0 Local, 1 World

		{
			outlineTangent = o.tangent.xyz;
			outlineBinormal = cross(o.normal.xyz, o.tangent.xyz) * (v.tangent.w * unity_WorldTransformParams.w);
		}
		else
		{
			outlineTangent = v.tangent.xyz;
			outlineBinormal = normalize(cross(outlineNormal, outlineTangent)) * (v.tangent.w * length(outlineNormal));
		}
		float3 outlineVectorTS = v.color.rgb * 2.0 - 1.0;
		outlineNormal = outlineVectorTS.x * outlineTangent + outlineVectorTS.y * outlineBinormal + outlineVectorTS.z * outlineNormal;
	}

	float offsetMultiplier = 1;
	float distanceOffset = 1;
	//UNITY_BRANCH
	if (_OutlineFixedSize >= 0.5)
	{
		distanceOffset *= lerp(1.0, clamp((distance(getCameraPosition(), mul(unity_ObjectToWorld, o.localPos).xyz)) / o.normal.w, 0.0f, _OutlinesMaxDistance), _OutlineFixWidth);
	}

	float lineWidth = _LineWidth;
	#ifdef POI_AUDIOLINK
		// Due to PoiMods.audioLink being frag only I'll just
		// recreate what it does here for this vertex function
		//UNITY_BRANCH
		if (_AudioLinkAnimToggle >= 0.5)
		{
			if (AudioLinkIsAvailable())
			{
				lineWidth += lerp(_AudioLinkOutlineSize.x, _AudioLinkOutlineSize.y, AudioLinkData(uint2(0, _AudioLinkOutlineSizeBand)));
			}
		}
	#endif
	
	float3 offset = outlineNormal * (lineWidth * _EnableOutlines / 100) * outlineMask * distanceOffset;
	
	//UNITY_BRANCH
	if (_OutlineExpansionMode == 2)
	{
		#if POI_PIPE == POI_BIRP
			float3 lightDirection = normalize(_WorldSpaceLightPos0 + PoiSHAr.xyz + PoiSHAg.xyz + PoiSHAb.xyz);
		#elif POI_PIPE == POI_URP
			Light mainLight = GetMainLight();
			float3 lightDirection = normalize(mainLight.direction + PoiSHAr.xyz + PoiSHAg.xyz + PoiSHAb.xyz);
		#endif
		offsetMultiplier = saturate(dot(lightDirection, outlineNormal));
		offset *= offsetMultiplier;
		offset *= distanceOffset;
	}
	else if (_OutlineExpansionMode == 3)
	{
		float3 viewNormal = mul((float3x3)UNITY_MATRIX_V, outlineNormal);
		offsetMultiplier = saturate(dot(viewNormal.xy, normalize(_OutlinePersonaDirection.xy)));
		
		offset *= offsetMultiplier;
		offset *= distanceOffset;
	}
	else if (_OutlineExpansionMode == 4)
	{
		offset = mul((float3x3)transpose(UNITY_MATRIX_V), _OutlineDropShadowOffset.xyz);
		offset *= distanceOffset;
	}
	if (_OutlineSpace == 0)
	{
		localOffset += offset;
		worldOffset += mul((float3x3)unity_ObjectToWorld, offset);
	}
	else
	{
		offset *= o.normal.w;
		localOffset += mul((float3x3)unity_WorldToObject, offset);
		worldOffset += offset;
	}
#endif
//endex

#T#OutLineZOffset
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	#if defined(UNITY_REVERSED_Z)
		//DX
		o.pos.z += _Offset_Z * outLineZOffset * - 0.0001;
	#else
		//OpenGL
		o.pos.z += _Offset_Z * outLineZOffset * 0.0001;
	#endif
#endif
//endex

#T#OutlineFragmentFunction
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	// Shared by the outline body and the highlight so both stay in step under Color Adjust
	half3 poiOutlineColorAdjust(half3 color)
	{
		float hue = frac(_OutlineHue + _OutlineHueOffsetSpeed * POI_TIME.x);
		color = hueShift(color, hue, _OutlineHueShiftColorSpace, 1.0);
		[flatten]
		switch ((int)_OutlineSaturationMethod)
		{
			// Saturation/Value (old)
			case 0:
			{
				color = ModifyViaHSV(color, 0.0, _OutlineSaturation, _OutlineValue);
				break;
			}
			// Saturation/Brightness (new)
			case 1:
			{
				color = lerp(color, dot(color, float3(0.3, 0.59, 0.11)), -_OutlineSaturation);
				color = saturate(color * (_OutlineBrightness + 1));
				break;
			}
		}
		return pow(abs(color), _OutlineGamma);
	}
	void applyOutlineColor(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiLight poiLight, in PoiMods poiMods, in PoiCam poiCam)
	{
		clip(_EnableOutlines - 0.01);
		#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
			half OutlineMask = UNITY_SAMPLE_TEX2D_SAMPLER(_OutlineMask, _linear_repeat, TRANSFORM_TEX(poiMesh.uv[_OutlineMaskUV], _OutlineMask) + POI_TIME.x * _OutlineMaskPan)[_OutlineMaskChannel];
		#else
			half OutlineMask = 1;
		#endif
		if (_OutlineVertexColorMask > 0)
		{
			OutlineMask *= lerp(1, poiMesh.vertexColor[_OutlineVertexColorMask - 1], _OutlineVertexColorMaskStrength);
		}
		if (_OutlineClipAtZeroWidth >= 0.5)
		{
			float lineWidth = _LineWidth;
			#ifdef POI_AUDIOLINK
				//UNITY_BRANCH
				if (poiMods.audioLinkAvailable)
				{
					lineWidth += lerp(_AudioLinkOutlineSize.x, _AudioLinkOutlineSize.y, poiMods.audioLink[_AudioLinkOutlineSizeBand]);
				}
			#endif
			clip(OutlineMask * lineWidth - 0.001);
		}
		#if defined(PROP_OUTLINETEXTURE) || !defined(OPTIMIZER_ENABLED)
			float4 col = POI2D_SAMPLER_PAN(_OutlineTexture, _MainTex, poiUV(poiMesh.uv[_OutlineTextureUV], _OutlineTexture_ST), _OutlineTexturePan);
		#else
			float4 col = float4(1, 1, 1, 1);
		#endif
		poiFragData.baseColor = lerp(col.rgb, col.rgb * poiFragData.baseColor * lerp(1, poiFragData.baseColor, _PoiUTSStyleOutlineBlend), _OutlineTintMix);
		half4 outlineColor = _LineColor;
		#ifdef POI_AUDIOLINK
			if (_OutlineALColorEnabled >= 0.5 && poiMods.audioLinkAvailable)
			{
				half alColorOverrideIntensity = poiMods.audioLink[_AudioLinkOutlineColorBand];
				half alColorOverrideBlend = evalRamp4(alColorOverrideIntensity, _AudioLinkOutlineColorRamp);
				if(alColorOverrideBlend > 0)
				{
					half3 alOverrideColor = _AudioLinkOutlineColor.rgb;
					if(_AudioLinkOutlineColorThemeIndex > 0)
					{
						alOverrideColor = poiThemeColor(poiMods, alOverrideColor, _AudioLinkOutlineColorThemeIndex);
					}
					outlineColor.rgb = lerp(outlineColor.rgb, alOverrideColor, alColorOverrideBlend);
				}
			}
		#endif

		// Untinted outline color, used as the optional tint source for the highlight below
    	half3 outlineHighlightTint = poiFragData.baseColor;

		poiFragData.baseColor *= poiThemeColor(poiMods, outlineColor.rgb, _LineColorThemeIndex);
		col.a *= outlineColor.a;
		if (_OutlineHueShift >= 0.5)
		{
			poiFragData.baseColor.rgb = poiOutlineColorAdjust(poiFragData.baseColor.rgb);
		}
		
		if (_OutlineExpansionMode == 2)
		{
			poiFragData.baseColor = lerp(poiFragData.baseColor, poiLight.directColor, _OutlineRimLightBlend);
		}

		half outlineHighlight = 0;
		if (_OutlineHighlightEnabled >= 0.5)
		{
			// Screen space N dot L: the outline is a hull with no visible shading of its own,
			// so the highlight is driven by where the light sits around the silhouette.
			float3 viewNormal = mul((float3x3)UNITY_MATRIX_V, poiMesh.normals[0]);
			float3 viewLight = mul((float3x3)UNITY_MATRIX_V, poiLight.direction);
			float2 highlightN = length(viewNormal.xy) > 1e-6 ? normalize(viewNormal.xy) : float2(0, 1);
			float2 highlightL = length(viewLight.xy) > 1e-6 ? normalize(viewLight.xy) : float2(0, 1);
			half highlightNDotL = dot(highlightN, highlightL) * 0.5 + 0.5;
			outlineHighlight = poiEdgeLinear(highlightNDotL, _OutlineHighlightBorder, _OutlineHighlightBlur) * _OutlineHighlightColor.a;
			if (_OutlineHighlightReceiveShadow >= 0.5)
			{
				outlineHighlight *= poiLight.attenShadowsStrength;
			}
			half3 highlightColor = _OutlineHighlightColor.rgb;
			#ifdef POI_AUDIOLINK
				if (_OutlineHighlightALColorEnabled >= 0.5 && poiMods.audioLinkAvailable)
				{
					half alHighlightOverrideIntensity = poiMods.audioLink[_AudioLinkOutlineHighlightColorBand];
					half alHighlightOverrideBlend = evalRamp4(alHighlightOverrideIntensity, _AudioLinkOutlineHighlightColorRamp);
					if (alHighlightOverrideBlend > 0)
					{
						half3 alHighlightOverrideColor = _AudioLinkOutlineHighlightColor.rgb;
						if (_AudioLinkOutlineHighlightColorThemeIndex > 0)
						{
							alHighlightOverrideColor = poiThemeColor(poiMods, alHighlightOverrideColor, _AudioLinkOutlineHighlightColorThemeIndex);
						}
						highlightColor = lerp(highlightColor, alHighlightOverrideColor, alHighlightOverrideBlend);
					}
				}
			#endif
			highlightColor = poiThemeColor(poiMods, highlightColor, _OutlineHighlightColorThemeIndex);
			if (_OutlineHighlightApplyTex >= 0.5)
			{
				highlightColor *= outlineHighlightTint;
			}
			// Applied here rather than earlier so the highlight sees the same tex * color input the body does
			if (_OutlineHueShift >= 0.5)
			{
				highlightColor = poiOutlineColorAdjust(highlightColor);
			}
			poiFragData.baseColor = lerp(poiFragData.baseColor, highlightColor, outlineHighlight);
		}
		
		if (_OutlineOverrideAlpha >= 0.5)
		{
			poiFragData.alpha = col.a;
		}
		else
		{
			poiFragData.alpha *= col.a;
		}
		
		if (_OutlineAlphaDistanceFade >= 0.5)
		{
			float3 position = _OutlineAlphaDistanceFadeType ? poiMesh.worldPos : poiMesh.objectPosition;
			poiFragData.alpha *= lerp(_OutlineAlphaDistanceFadeMinAlpha, _OutlineAlphaDistanceFadeMaxAlpha, smoothstep(_OutlineAlphaDistanceFadeMin, _OutlineAlphaDistanceFadeMax, distance(position, poiCam.worldPos)));
		}
		
		half emission = _OutlineEmission;
		half highlightEmission = _OutlineHighlightEmission;  
		#ifdef POI_AUDIOLINK
			//UNITY_BRANCH
			if (poiMods.audioLinkAvailable)
			{
				emission += lerp(_AudioLinkOutlineEmission.x, _AudioLinkOutlineEmission.y, poiMods.audioLink[_AudioLinkOutlineEmissionBand]);
				highlightEmission += lerp(_AudioLinkOutlineHighlightEmission.x, _AudioLinkOutlineHighlightEmission.y, poiMods.audioLink[_AudioLinkOutlineHighlightEmissionBand]);
			}
		#endif

		// Stacks on top of the outline emission so the highlight can glow on a non-emissive outline
    	emission += highlightEmission * outlineHighlight; 
		
		poiFragData.emission += poiFragData.baseColor * emission;
	}
#endif
//endex

#T#OutlineFragmentFunctionCall
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	applyOutlineColor(poiFragData, poiMesh, poiLight, poiMods, poiCam);
#endif
//endex

#T#OutlineForceSmoothNormals
//ifex _EnableOutlines!=1
#ifdef POI_PASS_OUTLINE
	poiMesh.normals[1] = poiMesh.normals[0];
#endif
//endex
