	}
	if (_ShadingRampedLightMapInverseApplyGlobalMaskIndex > 0)
	{
		applyToGlobalMask(poiMods, _ShadingRampedLightMapInverseApplyGlobalMaskIndex - 1, _ShadingRampedLightMapInverseApplyGlobalMaskBlendType, (1 - saturate(poiMax(poiLight.rampedLightMap * _ShadingRampedLightMapInverseApplyGlobalMaskStrength))));
	}
}

