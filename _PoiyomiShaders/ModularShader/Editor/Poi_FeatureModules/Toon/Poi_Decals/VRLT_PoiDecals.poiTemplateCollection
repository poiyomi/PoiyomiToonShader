	void applyDecals(in half4 decalMask, inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiCam poiCam, inout PoiMods poiMods, in PoiLight poiLight)
	{
		// check if _Udon_VideoTex is greater than 16 pixels in width
		float udonVideoTexAvailable = 0;
		float2 udonVideoAspectRatio = 1;
		if (_Udon_VideoTex_TexelSize.z > 16)
		{
			udonVideoTexAvailable = 1;
		}

		half decalAlpha = 1;
		half alphaOverride = 0;

		PoiDecal decalData;
