#T#PoiInternalParallaxFunctions
//ifex _PoiInternalParallax==0
#ifdef POI_INTERNALPARALLAX
	float2 internalParallaxUV(float uvNumber, float2 position, half rotation, half2 scale, float4 sideOffset, in PoiMesh poiMesh)
	{
		sideOffset = float4(-sideOffset.x, sideOffset.y, -sideOffset.z, sideOffset.w);
		float2 centerOffset = float2((sideOffset.x + sideOffset.y) / 2, (sideOffset.z + sideOffset.w) / 2);
		float2 uv = poiMesh.uv[uvNumber];
		float2 center = position + centerOffset;
		float cs, sn;
		sincos(radians(rotation), sn, cs);
		uv = float2((uv.x - center.x) * cs - (uv.y - center.y) * sn + center.x, (uv.x - center.x) * sn + (uv.y - center.y) * cs + center.y);
		uv = remap(uv, position - scale / 2 + sideOffset.xz, position + scale / 2 + sideOffset.yw, float2(0, 0), float2(1, 1));
		return uv;
	}

	void applyInternalParallax(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiCam poiCam, in PoiMods poiMods)
	{
		half parallaxMask = 1;
		#if defined(PROP_PARALLAXINTERNALMAPMASK) || !defined(OPTIMIZER_ENABLED)
			parallaxMask = POI2D_SAMPLER_PAN(_ParallaxInternalMapMask, _MainTex, poiUV(poiMesh.uv[_ParallaxInternalMapMaskUV], _ParallaxInternalMapMask_ST), _ParallaxInternalMapMaskPan)[_ParallaxInternalMapMaskChannel];
		#endif

		parallaxMask = _ParallaxInternalMapMaskInvert ? 1.0 - parallaxMask : parallaxMask;
		if (_ParallaxInternalMapMaskGlobalMask > 0)
		{
			parallaxMask = maskBlend(parallaxMask, poiMods.globalMask[_ParallaxInternalMapMaskGlobalMask - 1], _ParallaxInternalMapMaskGlobalMaskBlendType);
		}

		// Decal style placement of the map in the selected UV set
		float2 placedUV = internalParallaxUV(_ParallaxInternalMapUV, _ParallaxInternalPosition.xy, _ParallaxInternalRotation, _ParallaxInternalScale.xy, _ParallaxInternalSideOffset, poiMesh);

		if (parallaxMask <= 0) return;

		// Hoist loop-invariants out of the iteration loop.
		half3 minColor = poiThemeColor(poiMods, _ParallaxInternalMinColor.rgb, _ParallaxInternalMinColorThemeIndex);
		half3 maxColor = poiThemeColor(poiMods, _ParallaxInternalMaxColor.rgb, _ParallaxInternalMaxColorThemeIndex);
		float2 panBase = POI_TIME.y * _ParallaxInternalMapPan;
		float hueShiftAmount = _ParallaxInternalHueShift + _ParallaxInternalHueShiftSpeed * POI_TIME.x;
		//ifex _EnableAudioLink==0
		#ifdef POI_AUDIOLINK
			half alEmissionMod = 0;
			float alMinDepthMod = 0;
			float alMaxDepthMod = 0;
			float2 alPanMod = float2(0, 0);
			half alMinColorOverrideBlend = 0;
			half3 alMinColorOverrideColor = float3(1, 1, 1);
			half alMaxColorOverrideBlend = 0;
			half3 alMaxColorOverrideColor = float3(1, 1, 1);
			if (poiMods.audioLinkAvailable && _ParallaxInternalAudioLinkEnabled >= 0.5)
			{
				alEmissionMod = lerp(_ParallaxInternalALEmissionMod.x, _ParallaxInternalALEmissionMod.y, poiMods.audioLink[_ParallaxInternalALEmissionBand]);
				alMinDepthMod = lerp(_ParallaxInternalALMinDepthMod.x, _ParallaxInternalALMinDepthMod.y, poiMods.audioLink[_ParallaxInternalALMinDepthBand]);
				alMaxDepthMod = lerp(_ParallaxInternalALMaxDepthMod.x, _ParallaxInternalALMaxDepthMod.y, poiMods.audioLink[_ParallaxInternalALMaxDepthBand]);
				alPanMod = AudioLinkGetChronoTime(_ParallaxInternalALPanType, _ParallaxInternalALPanBand) * _ParallaxInternalALPanSpeed.xy;
				hueShiftAmount += AudioLinkGetChronoTime(_ParallaxInternalALHueShiftType, _ParallaxInternalALHueShiftBand) * _ParallaxInternalALHueShiftSpeed;
				if (_ParallaxInternalALMinColorOverrideEnabled >= 0.5)
				{
					half alMinIntensity = poiMods.audioLink[_ParallaxInternalALMinColorOverrideBand];
					alMinColorOverrideBlend = evalRamp4(alMinIntensity, _ParallaxInternalALMinColorOverrideRamp);
					alMinColorOverrideColor = poiThemeColor(poiMods, _ParallaxInternalALMinColorOverride.rgb, _ParallaxInternalALMinColorOverrideThemeIndex);
				}
				if (_ParallaxInternalALMaxColorOverrideEnabled >= 0.5)
				{
					half alMaxIntensity = poiMods.audioLink[_ParallaxInternalALMaxColorOverrideBand];
					alMaxColorOverrideBlend = evalRamp4(alMaxIntensity, _ParallaxInternalALMaxColorOverrideRamp);
					alMaxColorOverrideColor = poiThemeColor(poiMods, _ParallaxInternalALMaxColorOverride.rgb, _ParallaxInternalALMaxColorOverrideThemeIndex);
				}
			}
			minColor = lerp(minColor, alMinColorOverrideColor, alMinColorOverrideBlend);
			maxColor = lerp(maxColor, alMaxColorOverrideColor, alMaxColorOverrideBlend);
			panBase += alPanMod;
		#endif
		//endex

		float minFade = _ParallaxInternalMinFade;
		float maxFade = _ParallaxInternalMaxFade;

		float2 viewOffset = 0;
		float2 invMapTiling = 1;
		#if defined(PROP_PARALLAXINTERNALMAP) || !defined(OPTIMIZER_ENABLED)
			float grazingBias = 0.3;
			float tangentZ = poiCam.tangentViewDir.z < 0 ? poiCam.tangentViewDir.z - grazingBias : poiCam.tangentViewDir.z + grazingBias;
			viewOffset = -(poiCam.tangentViewDir.xy * (1 + grazingBias) / tangentZ);
			// Layer offsets are authored in tiled map space, this brings them back to placement space
			float2 mapTiling = abs(_ParallaxInternalMap_ST.xy) < 1e-5 ? 1.0 : _ParallaxInternalMap_ST.xy;
			invMapTiling = 1.0 / mapTiling;
		#endif

		//ifex _EnableAudioLink==0
		#ifdef POI_AUDIOLINK
			bool historyEnabled = poiMods.audioLinkAvailable && _ParallaxInternalAudioLinkEnabled >= 0.5 && _ParallaxInternalALHistoryEnabled >= 0.5;
			half3 historyColor = float3(1, 1, 1);
			if (historyEnabled)
			{
				historyColor = poiThemeColor(poiMods, _ParallaxInternalALHistoryColor.rgb, _ParallaxInternalALHistoryColorThemeIndex);
			}
			half3 historyEmission = 0;
		#endif
		//endex

		float distanceToCamera = distance(poiMesh.objectPosition, poiCam.worldPos);
		float distanceFalloff = saturate((distanceToCamera - _ParallaxInternalIterationsDistance.x) / max(_ParallaxInternalIterationsDistance.y - _ParallaxInternalIterationsDistance.x, 1e-5));
		float minIterations = min(_ParallaxInternalIterationsMin, _ParallaxInternalIterations);
		int iterations = (int)round(lerp(_ParallaxInternalIterations, minIterations, distanceFalloff));
		iterations = max(iterations, 1);

		float3 parallax = 0;
		[loop]
		for (int j = iterations - 1; j >= 0; j--)
		{
			float ratio = saturate((float)j / max(iterations - 1, 1));
			float2 parallaxOffset = panBase + ratio * _ParallaxInternalPerLevelOffset;
			float fade = lerp(minFade, maxFade, ratio);
			fade = pow(max(fade, 0), 2.2);
			//ifex _EnableAudioLink==0
			#ifdef POI_AUDIOLINK
				half historyIntensity = 0;
				if (historyEnabled)
				{
					uint historyT = (uint)floor(ratio * _ParallaxInternalALHistoryDepth);
					historyIntensity = AudioLinkData(uint2(historyT, (uint)_ParallaxInternalALHistoryBand)).r;
					parallaxOffset += historyIntensity * _ParallaxInternalALHistoryBump.xy * 0.01;
				}
			#endif
			//endex
			#if defined(PROP_PARALLAXINTERNALMAP) || !defined(OPTIMIZER_ENABLED)
				float depth = lerp(_ParallaxInternalMinDepth, _ParallaxInternalMaxDepth, ratio);
				//ifex _EnableAudioLink==0
				#ifdef POI_AUDIOLINK
					depth = lerp(_ParallaxInternalMinDepth + alMinDepthMod, _ParallaxInternalMaxDepth + alMaxDepthMod, ratio);
				#endif
				//endex
				float2 layerOffset = depth * viewOffset + parallaxOffset;
				float2 layerUV = placedUV + layerOffset * invMapTiling;
				layerUV = _ParallaxInternalTiled >= 0.5 ? layerUV : clamp(layerUV, 0, 1);
				half4 parallaxColor = UNITY_SAMPLE_TEX2D_SAMPLER_LOD(_ParallaxInternalMap, _MainTex, layerUV * _ParallaxInternalMap_ST.xy + _ParallaxInternalMap_ST.zw, 0);
			#else
				half4 parallaxColor = 0;
			#endif
			half3 parallaxTint = lerp(minColor, maxColor, ratio);
			float parallaxHeight;
			if (_ParallaxInternalHeightFromAlpha >= 0.5)
			{
				parallaxTint *= parallaxColor.rgb;
				parallaxHeight = parallaxColor.a;
			}
			else
			{
				parallaxHeight = parallaxColor.r;
			}
			UNITY_BRANCH
			if (_ParallaxInternalHueShiftEnabled >= 0.5 && _ParallaxInternalHueShiftPerLevel != 0)
			{
				parallaxTint = hueShift(parallaxTint, frac(ratio * _ParallaxInternalHueShiftPerLevel), _ParallaxInternalHueShiftColorSpace, _ParallaxInternalHueSelectOrShift);
			}
			float3 contrib = parallaxTint * fade;
			if (_ParallaxInternalHeightmapMode == 1)
			{
				parallax = lerp(parallax, contrib, parallaxHeight >= 1 - ratio);
			}
			else
			{
				contrib *= parallaxHeight;
				if (_ParallaxInternalBlendMode == 0) parallax += contrib;
				else parallax = max(parallax, contrib);
			}
			//ifex _EnableAudioLink==0
			#ifdef POI_AUDIOLINK
				if (historyIntensity > 0)
				{
					historyEmission += parallaxTint * historyColor * historyIntensity * parallaxHeight * fade;
				}
			#endif
			//endex
		}
		parallax = hueShift(parallax, frac(hueShiftAmount) * _ParallaxInternalHueShiftEnabled, _ParallaxInternalHueShiftColorSpace, _ParallaxInternalHueSelectOrShift);
		//parallax /= _ParallaxInternalIterations;

		poiFragData.baseColor.rgb = customBlend(poiFragData.baseColor.rgb, parallax.rgb, _ParallaxInternalSurfaceBlendMode, parallaxMask);
		//ifex _EnableAudioLink==0
		#ifdef POI_AUDIOLINK
			poiFragData.emission.rgb += parallax.rgb * alEmissionMod * parallaxMask;
			poiFragData.emission.rgb += historyEmission * _ParallaxInternalALHistoryEmission * parallaxMask;
		#endif
		//endex
	}
#endif
//endex

