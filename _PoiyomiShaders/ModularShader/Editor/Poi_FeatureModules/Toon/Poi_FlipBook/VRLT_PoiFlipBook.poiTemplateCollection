    void applyFlipbook__mIDx__(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiMods poiMods)
    {
        #if defined(PROP_FLIPBOOKTEXARRAY__mIDx__) || !defined(OPTIMIZER_ENABLED)
            float4 flipBookPixel = float4(0, 0, 0, 0);
            #if defined(PROP_FLIPBOOKMASK__mIDx__) || !defined(OPTIMIZER_ENABLED)
                half flipBookMask = POI2D_SAMPLER_PAN(_FlipbookMask__mIDx__, _MainTex, poiUV(poiMesh.uv[_FlipbookMaskUV__mIDx__], _FlipbookMask__mIDx___ST), _FlipbookMaskPan__mIDx__)[_FlipbookMaskChannel__mIDx__];
            #else
                half flipBookMask = 1;
            #endif
            if (_FlipbookMaskGlobalMask__mIDx__ > 0)
            {
                flipBookMask = maskBlend(flipBookMask, poiMods.globalMask[_FlipbookMaskGlobalMask__mIDx__ - 1], _FlipbookMaskGlobalMaskBlendType__mIDx__);
            }

            float2 flipbookScale = _FlipbookScale__mIDx__.xy;
            #ifdef POI_AUDIOLINK
                if (poiMods.audioLinkAvailable)
                {
                    flipbookScale += lerp(_AudioLinkFlipbookScale__mIDx__.xy, _AudioLinkFlipbookScale__mIDx__.zw, poiMods.audioLink[_AudioLinkFlipbookScaleBand__mIDx__]);
                }
            #endif

            // Aspect ratio correction
            if (_FlipbookAspectRatioMode__mIDx__ > 0)
            {
                float texWidth;
                float texHeight;
                float texFrames;
                _FlipbookTexArray__mIDx__.GetDimensions(texWidth, texHeight, texFrames);

                if (_FlipbookAspectRatioMode__mIDx__ == 1) // Shrink to Fit
                {
                    if (texWidth > texHeight)
                        flipbookScale *= float2(1, texHeight / texWidth);
                    else
                        flipbookScale *= float2(texWidth / texHeight, 1);
                }
                else // Grow to Fit
                {
                    if (texWidth > texHeight)
                        flipbookScale *= float2(texWidth / texHeight, 1);
                    else
                        flipbookScale *= float2(1, texHeight / texWidth);
                }
            }

            float4 sideOffset = float4(-_FlipbookSideOffset__mIDx__.x, _FlipbookSideOffset__mIDx__.y, -_FlipbookSideOffset__mIDx__.z, _FlipbookSideOffset__mIDx__.w);
            float2 centerOffset = float2((sideOffset.x + sideOffset.y) / 2, (sideOffset.z + sideOffset.w) / 2);
            float2 uv = poiMesh.uv[_FlipbookTexArrayUV__mIDx__];

            // Symmetry mode
            if (_FlipbookSymmetryMode__mIDx__ == 1) uv.x = abs(uv.x - 0.5) + 0.5;
            if (_FlipbookSymmetryMode__mIDx__ == 2 && uv.x < 0.5) uv.x = uv.x + 0.5;

            // Mirrored UV mode
            if ((_FlipbookMirroredUVMode__mIDx__ == 1 || _FlipbookMirroredUVMode__mIDx__ == 4) && poiMesh.isRightHand) uv.x = 1.0 - uv.x;
            if (_FlipbookMirroredUVMode__mIDx__ == 2 && poiMesh.isRightHand) uv.x = -1.0;
            if ((_FlipbookMirroredUVMode__mIDx__ == 3 || _FlipbookMirroredUVMode__mIDx__ == 4) && !poiMesh.isRightHand) uv.x = -1.0;

            float2 flipbookCenter = _FlipbookPosition__mIDx__ + centerOffset;
            float theta = radians(_FlipbookRotation__mIDx__ + POI_TIME.z * _FlipbookRotationSpeed__mIDx__);
            float cs = cos(theta);
            float sn = sin(theta);
            uv = float2((uv.x - flipbookCenter.x) * cs - (uv.y - flipbookCenter.y) * sn + flipbookCenter.x, (uv.x - flipbookCenter.x) * sn + (uv.y - flipbookCenter.y) * cs + flipbookCenter.y);
            float2 newUV = remap(uv, float2(0, 0) - flipbookScale / 2 + _FlipbookPosition__mIDx__ + sideOffset.xz, flipbookScale / 2 + _FlipbookPosition__mIDx__ + sideOffset.yw, float2(0, 0), float2(1, 1));

            half edgeAlpha = 1.0;

            if (_FlipbookTiled__mIDx__ == 0)
            {
                float2 pixelWidth = fwidth(newUV) + 1.0e-7;
                float2 edgeFactor = (1.0 - abs(newUV * 2.0 - 1.0)) / pixelWidth;
                edgeAlpha = saturate(min(edgeFactor.x, edgeFactor.y));
            }
            else if (_FlipbookTiled__mIDx__ == 2)
            {
                float2 tiledUVs = frac(newUV);
                float2 pixelWidth = fwidth(newUV) + 1.0e-7;
                float2 edgeFactor = (1.0 - abs(tiledUVs * 2.0 - 1.0)) / pixelWidth;
                edgeAlpha = saturate(min(edgeFactor.x, edgeFactor.y));
            }

            float currentFrame = 0;
            float width;
            float height;
            float totalFrames;
            _FlipbookTexArray__mIDx__.GetDimensions(width, height, totalFrames);

            if (_FlipbookStartAndEnd__mIDx__ >= 0.5)
            {
                totalFrames -= (totalFrames - min(max(_FlipbookStartFrame__mIDx__, _FlipbookEndFrame__mIDx__), totalFrames));
                totalFrames -= max(0, _FlipbookStartFrame__mIDx__);
            }
            if (_FlipbookManualFrameControl__mIDx__ < 0.5)
            {
                if (_FlipbookFPS__mIDx__ != 0)
                {
                    currentFrame = ((POI_TIME.y / (1 / _FlipbookFPS__mIDx__)) + _FlipbookFrameOffset__mIDx__) % totalFrames;
                    if (_FlipbookStartAndEnd__mIDx__ >= 0.5)
                    {
                        currentFrame += _FlipbookStartFrame__mIDx__;
                    }
                }
            }
            else
            {
                currentFrame = fmod(_FlipbookCurrentFrame__mIDx__, totalFrames);
            }
            #ifdef POI_AUDIOLINK
                if (poiMods.audioLinkAvailable)
                {
                    if (_FlipbookChronotensityEnabled__mIDx__ >= 0.5)
                    {
                        currentFrame += AudioLinkGetChronoTime(_FlipbookChronoType__mIDx__, _FlipbookChronotensityBand__mIDx__) * _FlipbookChronotensitySpeed__mIDx__;
                    }
                    currentFrame += lerp(_AudioLinkFlipbookFrame__mIDx__.x, _AudioLinkFlipbookFrame__mIDx__.y, poiMods.audioLink[_AudioLinkFlipbookFrameBand__mIDx__]);
                    float totalFramesAL = totalFrames;
                    if (_FlipbookStartAndEnd__mIDx__ >= 0.5)
                    {
                        totalFramesAL += max(0, _FlipbookStartFrame__mIDx__);
                    }
                    currentFrame %= totalFramesAL;
                }
            #endif

            float2 finalUV = TRANSFORM_TEX(newUV, _FlipbookTexArray__mIDx__) + POI_TIME.x * _FlipbookTexArrayPan__mIDx__;
            float2 ddxUV = ddx(finalUV);
            float2 ddyUV = ddy(finalUV);
