#T#PoiStatsOverlayFunctions
//ifex _TextEnabled==0
#ifdef EFFECT_BUMP

	float2 TransformUV(float2 offset, float rotation, float2 scale, float2 uv)
	{
		float theta = radians(rotation);
		// A zero or near-zero scale collapses the remap range
		float2 scaleSign = float2(scale.x < 0 ? -1 : 1, scale.y < 0 ? -1 : 1);
		scale = scaleSign * max(abs(scale), float2(1e-4, 1e-4));
		scale = 1 - scale;
		float cs = cos(theta);
		float sn = sin(theta);
		float2 centerPoint = offset + .5;
		uv = float2((uv.x - centerPoint.x) * cs - (uv.y - centerPoint.y) * sn + centerPoint.x, (uv.x - centerPoint.x) * sn + (uv.y - centerPoint.y) * cs + centerPoint.y);

		return remap(uv, float2(0, 0) + offset + (scale * .5), float2(1, 1) + offset - (scale * .5), float2(0, 0), float2(1, 1));
	}

	float2 getAsciiCoordinate(float index)
	{
		return float2((index - 1) / 16, 1 - ((floor(index / 16 - glyphWidth)) / 16));
	}

	float median(float r, float g, float b)
	{
		return max(min(r, g), min(max(r, g), b));
	}

	bool GetTextGlyphIndex(inout float2 uv, float2 offset, float rotation, float2 scale, float totalCharacters, out float glyphIndex)
	{
		glyphIndex = 0;
		uv = TransformUV(offset, rotation, scale, uv);

		if (uv.x >= 1 || uv.x < 0 || uv.y >= 1 || uv.y < 0)
		{
			return false;
		}

		glyphIndex = min(floor(uv.x * totalCharacters), totalCharacters - 1);
		return true;
	}

	float SampleTextDistance(float2 uv, float2 uvDx, float2 uvDy)
	{
		float2 sampleUV = TRANSFORM_TEX(uv, _TextGlyphs);
		float2 sampleDx = uvDx * _TextGlyphs_ST.xy;
		float2 sampleDy = uvDy * _TextGlyphs_ST.xy;
		float3 samp = tex2Dgrad(_TextGlyphs, sampleUV, sampleDx, sampleDy).rgb;
		return median(samp.r, samp.g, samp.b);
	}

	void BlendTextLayer(inout float3 dstColor, inout float dstAlpha, float3 srcColor, float srcAlpha)
	{
		dstColor = srcColor * srcAlpha + dstColor * (1 - srcAlpha);
		dstAlpha = srcAlpha + dstAlpha * (1 - srcAlpha);
	}

	void DrawTextGlyph(inout PoiFragData poiFragData, inout float3 globalTextEmission, in PoiMods poiMods, float2 uv, float asciiCode, float glyphIndex, float totalCharacters, float4 padding, float4 color, float emissionStrength, float themeIndex)
	{
		float2 glyphPos = getAsciiCoordinate(asciiCode);
		float cellWidth = 1 / totalCharacters;
		float2 startUV = float2(cellWidth * glyphIndex, 0);
		float2 endUV = float2(cellWidth * (glyphIndex + 1), 1);
		// Capture derivatives while the text UV is still continuous.
		float2 textUvDx = ddx(uv);
		float2 textUvDy = ddy(uv);

		float2 textScaleSign = float2(_TextScale.x < 0 ? -1 : 1, _TextScale.y < 0 ? -1 : 1);
		float2 safeTextScale = textScaleSign * max(abs(_TextScale), float2(1e-4, 1e-4));
		float2 scale = float2(cellWidth, 1) * (1 - safeTextScale) * 0.5;
		startUV += scale;
		endUV -= scale;

		padding *= cellWidth;
		float2 glyphMin = float2(glyphPos.x + padding.x, glyphPos.y - glyphWidth + padding.y);
		float2 glyphMax = float2(glyphPos.x + glyphWidth - padding.z, glyphPos.y - padding.w);
		float2 atlasRemapScale = (glyphMax - glyphMin) / (endUV - startUV);
		float2 atlasUvDx = textUvDx * atlasRemapScale;
		float2 atlasUvDy = textUvDy * atlasRemapScale;

		uv = remapClamped(startUV, endUV, uv, glyphMin, glyphMax);

		// Keep bilinear filtering inside the selected atlas cell at every scale.
		float2 atlasInset = max(_TextGlyphs_TexelSize.xy * 0.5, float2(.001, .001));
		if (uv.x >= glyphMax.x - atlasInset.x || uv.x <= glyphMin.x + atlasInset.x || uv.y >= glyphMax.y - atlasInset.y || uv.y <= glyphMin.y + atlasInset.y)
		{
			return;
		}

		float2 msdfUnit = _TextPixelRange / _TextGlyphs_TexelSize.zw;
		float2 atlasFwidth = max(abs(atlasUvDx) + abs(atlasUvDy), float2(1e-7, 1e-7));
		float screenPxRange = max(dot(msdfUnit, 0.5 / atlasFwidth), 1);
		float fieldPerPixel = 1 / screenPxRange;	// one screen pixel in distance field units

		float thiccnessBias = 0;
		//ifex _TextThiccness==0 && isNotAnimated(_TextThiccness)
		thiccnessBias = _TextThiccness;
		//endex

		float glyphDistance = SampleTextDistance(uv, atlasUvDx, atlasUvDy) - 0.5 + thiccnessBias;
		float coverage = saturate(screenPxRange * glyphDistance + 0.5);

		//ifex _TextHollowEnabled==0 && isNotAnimated(_TextHollowEnabled)
		if (_TextHollowEnabled >= 0.5)
		{
			float hollowWidth = max(_TextHollowWidth, fieldPerPixel);
			coverage = saturate(screenPxRange * (hollowWidth - abs(glyphDistance)) + 0.5);
		}
		//endex

		float3 textColor = 0;
		float textAlpha = 0;

		//ifex _TextShadowEnabled==0 && isNotAnimated(_TextShadowEnabled)
		if (_TextShadowEnabled >= 0.5)
		{
			float2 shadowUV = uv - _TextShadowOffset * glyphWidth;
			float2 shadowMin = glyphMin + atlasInset;
			float2 shadowMax = glyphMax - atlasInset;
			bool shadowInTile = all(shadowUV > shadowMin) && all(shadowUV < shadowMax);
			float shadowDistance = -0.5;
			if (shadowInTile)
			{
				shadowDistance = SampleTextDistance(shadowUV, atlasUvDx, atlasUvDy) - 0.5;
			}

			float shadowSize = _TextShadowSize * 0.4;
			float shadowStart = -shadowSize;
			float shadowEnd = max(-shadowSize * (1 - _TextShadowSoftness), shadowStart + fieldPerPixel);
			float shadowCoverage = smoothstep(shadowStart, shadowEnd, shadowDistance);

			float3 shadowColor = poiThemeColor(poiMods, _TextShadowColor.rgb, _TextShadowColorThemeIndex);
			BlendTextLayer(textColor, textAlpha, shadowColor, shadowCoverage * _TextShadowColor.a);
			float shadowVisible = shadowCoverage * (1 - coverage * color.a);
			globalTextEmission += shadowColor * shadowVisible * _TextShadowEmissionStrength;
		}
		//endex

		float3 themedColor = poiThemeColor(poiMods, color.rgb, themeIndex);

		//ifex _TextBevelEnabled==0 && isNotAnimated(_TextBevelEnabled)
		if (_TextBevelEnabled >= 0.5)
		{
			float2 bevelGradient = float2(ddx(glyphDistance), ddy(glyphDistance));
			float2 bevelNormal = bevelGradient * rsqrt(max(dot(bevelGradient, bevelGradient), 1e-12));
			float bevelAngle = radians(_TextBevelLightAngle);
			float bevelLight = 0.5 * (1 + dot(bevelNormal, float2(cos(bevelAngle), sin(bevelAngle))));

			float bevelBlend = (1 - smoothstep(0, _TextBevelWidth, glyphDistance)) * _TextBevelStrength;
			themedColor = lerp(themedColor, themedColor * bevelLight * 2, bevelBlend);
		}
		//endex

		BlendTextLayer(textColor, textAlpha, themedColor, coverage * color.a);
		globalTextEmission += themedColor * coverage * emissionStrength;

		poiFragData.baseColor = textColor + poiFragData.baseColor * (1 - textAlpha);
	}

	//ifex _TextPositionEnabled==0 && isNotAnimated(_TextPositionEnabled)
	void ApplyPositionText(inout PoiFragData poiFragData,  inout float3 globalTextEmission, float2 uv, in PoiMods poiMods)
	{
		#ifdef POI_PASS_META
			float3 cameraPos = 0;
		#else
			float3 cameraPos = clamp(getCameraPosition(), -999, 999);
		#endif
		float3 absCameraPos = abs(cameraPos);
		float totalCharacters = 20;
		float positionArray[20];
		positionArray[0] = cameraPos.x < 0 ? ASCII_NEGATIVE : ASCII_POSITIVE;
		positionArray[1] = floor((absCameraPos.x * .01) % 10) + 48;
		positionArray[2] = floor((absCameraPos.x * .1) % 10) + 48;
		positionArray[3] = floor(absCameraPos.x % 10) + 48;
		positionArray[4] = ASCII_PERIOD;
		positionArray[5] = floor((absCameraPos.x * 10) % 10) + 48;
		positionArray[6] = ASCII_COMMA;
		positionArray[7] = cameraPos.y < 0 ? ASCII_NEGATIVE : ASCII_POSITIVE;
		positionArray[8] = floor((absCameraPos.y * .01) % 10) + 48;
		positionArray[9] = floor((absCameraPos.y * .1) % 10) + 48;
		positionArray[10] = floor(absCameraPos.y % 10) + 48;
		positionArray[11] = ASCII_PERIOD;
		positionArray[12] = floor((absCameraPos.y * 10) % 10) + 48;
		positionArray[13] = ASCII_COMMA;
		positionArray[14] = cameraPos.z < 0 ? ASCII_NEGATIVE : ASCII_POSITIVE;
		positionArray[15] = floor((absCameraPos.z * .01) % 10) + 48;
		positionArray[16] = floor((absCameraPos.z * .1) % 10) + 48;
		positionArray[17] = floor(absCameraPos.z % 10) + 48;
		positionArray[18] = ASCII_PERIOD;
		positionArray[19] = floor((absCameraPos.z * 10) % 10) + 48;

		float glyphIndex;
		if (!GetTextGlyphIndex(uv, _TextPositionOffset, _TextPositionRotation, _TextPositionScale, totalCharacters, glyphIndex))
		{
			return;
		}

		DrawTextGlyph(poiFragData, globalTextEmission, poiMods, uv, positionArray[glyphIndex], glyphIndex, totalCharacters, _TextPositionPadding, _TextPositionColor, _TextPositionEmissionStrength, _TextPositionColorThemeIndex);
	}
