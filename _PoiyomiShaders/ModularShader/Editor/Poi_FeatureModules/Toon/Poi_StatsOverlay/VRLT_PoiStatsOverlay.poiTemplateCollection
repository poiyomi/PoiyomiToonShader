	void ApplyTextOverlayColor(inout PoiFragData poiFragData, PoiMesh poiMesh, in PoiMods poiMods)
	{
		float3 globalTextEmission = 0;

		//ifex _TextFPSEnabled==0 && isNotAnimated(_TextFPSEnabled)
		if (_TextFPSEnabled >= 0.5)
			ApplyFPSText(poiFragData, globalTextEmission, poiMesh.uv[_TextFPSUV], poiMods);
		//endex
		//ifex _TextPositionEnabled==0 && isNotAnimated(_TextPositionEnabled)
		if (_TextPositionEnabled >= 0.5)
			ApplyPositionText(poiFragData, globalTextEmission, poiMesh.uv[_TextPositionUV], poiMods);
		//endex
		//ifex _TextTimeEnabled==0 && isNotAnimated(_TextTimeEnabled)
		if (_TextTimeEnabled >= 0.5)
			ApplyTimeText(poiFragData, globalTextEmission, poiMesh.uv[_TextTimeUV], poiMods);
		//endex
		//ifex _TextUTCTimeEnabled==0 && isNotAnimated(_TextUTCTimeEnabled)
		if (_TextUTCTimeEnabled >= 0.5)
			ApplyUTCTimeText(poiFragData, globalTextEmission, poiMesh.uv[_TextUTCTimeUV], poiMods);
		//endex
		//ifex _TextNumericEnabled==0 && isNotAnimated(_TextNumericEnabled)
		if (_TextNumericEnabled >= 0.5)
			ApplyNumericText(poiFragData, globalTextEmission, poiMesh.uv[_TextNumericUV], poiMods);
