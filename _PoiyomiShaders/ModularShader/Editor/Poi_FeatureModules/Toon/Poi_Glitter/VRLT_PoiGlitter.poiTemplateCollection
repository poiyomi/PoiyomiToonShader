    struct PoiGlitterData
    {
        half3  norm;
        float  jaggyFix;
        half  glitterFwidth;
        float  glitterSpeedOffset;
        float  glitterTotalSpeed;          // _GlitterSpeed + glitterSpeedOffset
        float  glitterRotationTimeOffset;
        bool   needsRotation;
        half   glitterMask;
        half   glitterMaxBrightness;
        half   glitterBrightnessOffset;
        half3  baseColor;                  // poiThemeColor(_GlitterColor.rgb, _GlitterColorThemeIndex)
        half3  colorMap;                   // _GlitterColorMap.rgb
        float  sizeALAdd;
        half3  linearCamDir;               // lerp(forwardDir, viewDir, _GlitterLinearVRParallax)
        half3  linearHalfDir;              // normalize(viewDir + lightDir * _GlitterLinearLightDirection)
        float  linearTimeFactor;           // (POI_TIME.x + glitterSpeedOffset) * _GlitterLinearSpeed
        half3  lightHalfDir;               // normalize(lightDir + viewDir)
        half3  alOverrideColor;
        half   alOverrideBlend;
    };
