#T#PoiGlitterFunctions
//ifex _GlitterEnable==0
#ifdef _SUNDISK_SIMPLE

    half3 RandomColorFromPoint(float2 rando, float hue)
    {
        half saturation = lerp(_GlitterMinMaxSaturation.x, _GlitterMinMaxSaturation.y, rando.x);
        float value = lerp(_GlitterMinMaxBrightness.x, _GlitterMinMaxBrightness.y, rando.y);
        return HSVtoRGB(float3(hue, saturation, value));
    }

    float2 glitterComputeRotation(float2 pos, float2 center, float2 randomSeed, float timeOffset)
    {
        float randomBoy = poiRand(randomSeed);
        float rotSpeed = lerp(_GlitterRandomRotationSpeed.x, _GlitterRandomRotationSpeed.y, randomBoy);
        float randomOffset = _GlitterRandomRotation ? randomBoy : 0;
        float totalSpeed = _GlitterTextureRotation + rotSpeed;
        if (totalSpeed == 0 && timeOffset != 0)
            totalSpeed = 1;
        if (_GlitterRandomRotationDirection && randomBoy < 0.5)
            totalSpeed = -totalSpeed;
        float theta = radians(randomOffset * 360 + (POI_TIME.x + timeOffset) * totalSpeed * 360);
        float sn, cs;
        sincos(theta, sn, cs);
        return float2((pos.x - center.x) * cs - (pos.y - center.y) * sn + center.x,
                      (pos.x - center.x) * sn + (pos.y - center.y) * cs + center.y);
    }

    void processGlitterParticle(
        inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiCam poiCam, in PoiLight poiLight, in PoiMods poiMods,
        in PoiGlitterData poiGlitterData,
        float2 randPoint, float2 diff)
    {
        float size = _GlitterSize;
        if (_GlitterRandomSize >= 0.5)
            size = lerp(_GlitterMinMaxSize.x, _GlitterMinMaxSize.y, poiRand(randPoint));
        size = saturate(size + poiGlitterData.sizeALAdd);

        float2 rotatedDiff = diff;
        half glitterAlpha = 1;
        switch (_GlitterShape)
        {
            case 0:
            {
                if (_GlitterMode == 1)
                {
                    float sqDist = dot(diff, diff);
                    glitterAlpha = saturate((size - sqDist) / clamp(fwidth(sqDist), 0.0001, 1.0));
                }
                else
                {
                    float dist = length(diff);
                    glitterAlpha = saturate((size - dist) / poiGlitterData.glitterFwidth);
                }
                break;
            }
            case 1:
            {
                if (poiGlitterData.needsRotation)
                    rotatedDiff = glitterComputeRotation(diff, 0, randPoint * 200, poiGlitterData.glitterRotationTimeOffset);
                float squareAA = max(poiGlitterData.glitterFwidth, .1 * poiGlitterData.jaggyFix);
                glitterAlpha = (1. - smoothstep(size - squareAA, size, abs(rotatedDiff.x))) * (1. - smoothstep(size - squareAA, size, abs(rotatedDiff.y)));
                break;
            }
        }

        if (glitterAlpha <= 0) return;

        half finalGlitter = 0;
        half3 glitterColor = poiGlitterData.baseColor;
        float3 randomRotation = 0;

        switch (_GlitterMode)
        {
            case 0:
            {
                if (poiGlitterData.glitterTotalSpeed > 0)
                    randomRotation = randomFloat3WiggleRange(randPoint, _GlitterAngleRange, _GlitterSpeed, poiGlitterData.glitterSpeedOffset);
                else
                    randomRotation = poiRand3Range(randPoint, _GlitterAngleRange);
                half3 glitterReflectionDirection = normalize(mul(poiRotationMatrixFromAngles(randomRotation), poiGlitterData.norm));
				finalGlitter = lerp(0, _GlitterMinBrightness * glitterAlpha, glitterAlpha) + max(pow(saturate(dot(lerp(glitterReflectionDirection, poiCam.eyeViewDir, _GlitterBias), poiCam.eyeViewDir)), _GlitterContrast), 0);
                finalGlitter *= glitterAlpha;
                break;
            }
            case 1:
            {
                float3 cellRand3 = float3(poiRand(randPoint), poiRand(randPoint + 0.5), poiRand(randPoint.yx));
                half3 glitterNorm = abs(frac(cellRand3 * 14.274 + poiGlitterData.linearTimeFactor) * 2.0 - 1.0);
                glitterNorm = normalize(glitterNorm * 2.0 - 1.0);
                half glitterDot = dot(glitterNorm, poiGlitterData.linearCamDir);
                half glitterVal = abs(frac(glitterDot * _GlitterLinearSensitivity + _GlitterLinearSensitivity) - 0.5) * 4.0 - 1.0;
                glitterVal = saturate(1.0 - (glitterVal * _GlitterLinearContrast + _GlitterLinearContrast));
                glitterVal = pow(glitterVal, _GlitterLinearPostContrast);
                half linearNDotH = saturate(dot(poiGlitterData.norm, poiGlitterData.linearHalfDir));
                glitterVal = saturate(glitterVal * saturate(linearNDotH * _GlitterLinearAngle + 1.0 - _GlitterLinearAngle));
                finalGlitter = max(_GlitterLinearMinBrightness, glitterVal) * glitterAlpha;
                break;
            }
            case 2:
            {
                if (poiGlitterData.glitterTotalSpeed > 0)
                    randomRotation = randomFloat3WiggleRange(randPoint, _GlitterAngleRange, _GlitterSpeed, poiGlitterData.glitterSpeedOffset);
                else
                    randomRotation = poiRand3Range(randPoint, _GlitterAngleRange);
                half3 glitterLightReflectionDirection = normalize(mul(poiRotationMatrixFromAngles(randomRotation), poiGlitterData.norm));
                half lightAlpha = glitterAlpha * poiLight.nDotLSaturated;
                half specAngle = max(dot(poiGlitterData.lightHalfDir, glitterLightReflectionDirection), 0.0);
                finalGlitter = lerp(0, _GlitterMinBrightness * lightAlpha, lightAlpha) + max(pow(specAngle, _GlitterContrast), 0);
                glitterColor *= poiLight.directColor;
                finalGlitter *= lightAlpha;
                break;
            }
        }

        glitterColor *= lerp(1, poiFragData.baseColor, _GlitterUseSurfaceColor);
        glitterColor *= poiGlitterData.colorMap;

        float2 uv = remapClamped(-size, size, rotatedDiff, 0, 1);
        if (!_GlitterShape && poiGlitterData.needsRotation)
            uv = glitterComputeRotation(uv, .5, randPoint * 200, poiGlitterData.glitterRotationTimeOffset);

        #if defined(PROP_GLITTERTEXTURE) || !defined(OPTIMIZER_ENABLED)
            float2 glitterTexUV = uv;
            if (_GlitterSpriteSheetEnabled >= 0.5)
            {
                float glitterSeed = poiRand(randPoint);
                float frameMode = _GlitterSpriteSheetFrameSelection == 1 ? 2 : 0;
                float glitterFrameIndex = poiSpriteSheetFrameIndex(
                    _GlitterSpriteSheetColumns, _GlitterSpriteSheetRows, _GlitterSpriteSheetTotalFrames,
                    frameMode, _GlitterSpriteSheetFPS, _GlitterSpriteSheetRandomStart,
                    0, glitterSeed);
                glitterTexUV = poiSpriteSheetUV(uv, _GlitterSpriteSheetColumns, _GlitterSpriteSheetRows, glitterFrameIndex, 0, _GlitterTexture_ST.xy);
            }
            float2 finalGlitterTexUV = poiUV(glitterTexUV, _GlitterTexture_ST);
            if (_GlitterTexturePixelMode >= 0.5)
                finalGlitterTexUV = sharpSample(_GlitterTexture_TexelSize, finalGlitterTexUV);
            half4 glitterTexture = POI2D_SAMPLER_PANGRAD(_GlitterTexture, _linear_clamp, finalGlitterTexUV, 0, poiMesh.dx, poiMesh.dy);
        #else
            half4 glitterTexture = 1;
        #endif
        glitterColor *= glitterTexture.rgb;

        if (_GlitterRandomColors >= 0.5 || _GlitterHueShiftEnabled >= 0.5)
        {
            half2 colorRando = poiRand2(randPoint.x + randPoint.y);
            float randomHue = poiRand(colorRando);
            if (_GlitterRandomColors >= 0.5)
                glitterColor *= RandomColorFromPoint(colorRando, randomHue);
            if (_GlitterHueShiftEnabled >= 0.5)
            {
                float hueOffset = _GlitterHueShift + POI_TIME.x * _GlitterHueShiftSpeed;
                if (_GlitterHueShiftRandomOffset >= 0.5)
                    hueOffset += randomHue;
                glitterColor.rgb = hueShift(glitterColor.rgb, hueOffset, _GlitterHueShiftColorSpace, _GlitterHueSelectOrShift);
            }
        }

        if (poiGlitterData.alOverrideBlend > 0)
            glitterColor = lerp(glitterColor, poiGlitterData.alOverrideColor, poiGlitterData.alOverrideBlend);

        half brightness = poiGlitterData.glitterMaxBrightness + poiGlitterData.glitterBrightnessOffset;
        half maskedAlpha = finalGlitter * glitterTexture.a * poiGlitterData.glitterMask;
        if (_GlitterBlendType == 1)
        {
            poiFragData.baseColor = lerp(poiFragData.baseColor, finalGlitter * glitterColor * brightness, maskedAlpha);
            poiFragData.emission += finalGlitter * glitterColor * max(0, (brightness - 1) * glitterTexture.a) * poiGlitterData.glitterMask;
        }
        else
        {
            poiFragData.emission += glitterColor * brightness * maskedAlpha;
        }
    }

    void applyGlitter(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiCam poiCam, in PoiLight poiLight, in PoiMods poiMods)
    {
        PoiGlitterData poiGlitterData;
        PoiInitStruct(PoiGlitterData, poiGlitterData);

        #if defined(PROP_GLITTERMASK) || !defined(OPTIMIZER_ENABLED)
            half glitterMask = POI2D_SAMPLER_PAN(_GlitterMask, _MainTex, poiUV(poiMesh.uv[_GlitterMaskUV], _GlitterMask_ST), _GlitterMaskPan)[_GlitterMaskChannel];
        #else
            half glitterMask = 1;
        #endif
        #ifdef POI_AUDIOLINK
            if (_GlitterALEnabled >= 0.5)
                glitterMask = clamp(glitterMask + lerp(_GlitterALAlphaAdd.x, _GlitterALAlphaAdd.y, poiMods.audioLink[_GlitterALAlphaAddBand]), 0, glitterMask);
        #endif
        if (_GlitterMaskInvert >= 0.5)
            glitterMask = 1 - glitterMask;
        glitterMask *= lerp(1, poiLight.rampedLightMap * poiLight.lightMap, _GlitterHideInShadow);
        glitterMask *= lerp(1, poiLight.directLuminance, _GlitterScaleWithLighting);
        glitterMask *= _GlitterColor.a;
        if (_GlitterMaskGlobalMask > 0)
            glitterMask = maskBlend(glitterMask, poiMods.globalMask[_GlitterMaskGlobalMask - 1], _GlitterMaskGlobalMaskBlendType);
        
        if (glitterMask <= 0) return;
        poiGlitterData.glitterMask = glitterMask;

        poiGlitterData.glitterBrightnessOffset = 0;
        #ifdef POI_AUDIOLINK
            if (_GlitterALEnabled >= 0.5)
            {
                poiGlitterData.glitterRotationTimeOffset = AudioLinkGetChronoTime(_GlitterALChronoRotationSpeedType, _GlitterALChronoRotationSpeedBand) * _GlitterALChronoRotationSpeed;
                poiGlitterData.glitterSpeedOffset = AudioLinkGetChronoTime(_GlitterALChronoSparkleSpeedType, _GlitterALChronoSparkleSpeedBand) * _GlitterALChronoSparkleSpeed;
                poiGlitterData.sizeALAdd = lerp(_GlitterALSizeAdd.x, _GlitterALSizeAdd.y, poiMods.audioLink[_GlitterALSizeAddBand]);
                poiGlitterData.glitterBrightnessOffset = max(lerp(_GlitterALMaxBrightnessAdd.x, _GlitterALMaxBrightnessAdd.y, poiMods.audioLink[_GlitterALMaxBrightnessBand]), 0);
            }
        #endif
        poiGlitterData.glitterMaxBrightness = _GlitterMode == 1 ? _GlitterLinearBrightness : _GlitterBrightness;
        poiGlitterData.needsRotation = _GlitterRandomRotation || _GlitterTextureRotation != 0 || any(_GlitterRandomRotationSpeed.xy) || poiGlitterData.glitterRotationTimeOffset != 0;
        poiGlitterData.norm = lerp(poiMesh.normals[0], poiMesh.normals[1], _GlitterUseNormals);
        poiGlitterData.jaggyFix = poiCam.distanceToVert * poiCam.distanceToVert * _GlitterJaggyFix;
        poiGlitterData.glitterTotalSpeed = _GlitterSpeed + poiGlitterData.glitterSpeedOffset;

        UNITY_BRANCH
        if (_GlitterMode == 1)
        {
            poiGlitterData.linearCamDir = lerp(poiCam.forwardDir, poiCam.eyeViewDir, _GlitterLinearVRParallax);
			poiGlitterData.linearHalfDir = normalize(poiGlitterData.linearCamDir + poiLight.direction * _GlitterLinearLightDirection);
            poiGlitterData.linearTimeFactor = (POI_TIME.x + poiGlitterData.glitterSpeedOffset) * _GlitterLinearSpeed;
        }
        else if (_GlitterMode == 2)
        {
            poiGlitterData.lightHalfDir = poiLight.halfDir;
        }

        poiGlitterData.baseColor = poiThemeColor(poiMods, _GlitterColor.rgb, _GlitterColorThemeIndex);
        poiGlitterData.colorMap = 1;
        #if defined(PROP_GLITTERCOLORMAP) || !defined(OPTIMIZER_ENABLED)
            poiGlitterData.colorMap = POI2D_SAMPLER_PANGRAD(_GlitterColorMap, _MainTex, poiUV(poiMesh.uv[_GlitterColorMapUV], _GlitterColorMap_ST), _GlitterColorMapPan, poiMesh.dx, poiMesh.dy).rgb;
        #endif

        #ifdef POI_AUDIOLINK
            if (poiMods.audioLinkAvailable && _GlitterALEnabled >= 0.5 && _GlitterALColorOverrideEnabled >= 0.5)
            {
                half alIntensity = poiMods.audioLink[_GlitterALColorOverrideBand];
                poiGlitterData.alOverrideBlend = evalRamp4(alIntensity, _GlitterALColorOverrideRamp);
                if (poiGlitterData.alOverrideBlend > 0)
                {
                    poiGlitterData.alOverrideColor = _GlitterALColorOverride.rgb;
                    if (_GlitterALColorOverrideThemeIndex > 0)
                        poiGlitterData.alOverrideColor = poiThemeColor(poiMods, poiGlitterData.alOverrideColor, _GlitterALColorOverrideThemeIndex);
                }
            }
        #endif

        float maxSize = _GlitterRandomSize ? _GlitterMinMaxSize.y : _GlitterSize;
        #ifdef POI_AUDIOLINK
            if (_GlitterALEnabled >= 0.5)
                maxSize += max(_GlitterALSizeAdd.x, _GlitterALSizeAdd.y);
        #endif
        maxSize = saturate(maxSize);

        float maxParticleDistSq = _GlitterShape == 1
            ? 2.0 * maxSize * maxSize
            : (_GlitterMode == 1 ? maxSize : maxSize * maxSize);

        float2 st = (poiMesh.uv[_GlitterUV] + _GlitterUVPanning.xy * POI_TIME.x) * _GlitterFrequency;
        float2 dd = fwidth(st);
        float distanceLODEnabled = _GlitterMode == 1 ? _GlitterLinearDistanceLOD : _GlitterDistanceLOD;
        poiGlitterData.glitterFwidth = clamp(length(dd), 0.0001, 1.0);
        if (distanceLODEnabled)
        {
            float lodFactor = frac(sin(dot(floor(st / floor(dd + 3.0)), float2(12.9898, 78.233))) * 46203.4357) + 0.5;
            float2 lodScale = floor(dd + lodFactor * 0.5);
            st = st / max(1.0, lodScale) + _GlitterFrequency * lodScale;
        }

        float2 i_st = floor(st);
        float2 f_st = frac(st);

        uint glitterLayerCount = min(uint(_GlitterLayers), 4);
        [loop] for (uint glitterLayer = 0; glitterLayer < glitterLayerCount; glitterLayer++)
        {
            float2 neighborhoodSeed = i_st + glitterLayer * 0.5141;
            float2 neighborhoodOrigin = -f_st;

            UNITY_BRANCH
            if (_GlitterFullCoverage >= 0.5)
            {
                // Process every cell whose particle could overlap this fragment.
                [loop] for (int cellJ = -1; cellJ <= 1; cellJ++)
                {
                    [loop] for (int cellI = -1; cellI <= 1; cellI++)
                    {
                        float2 neighbor = float2(cellI, cellJ);
                        float2 cellRando = poiRand2(neighborhoodSeed + neighbor);
                        float2 cellDiff = neighborhoodOrigin + neighbor + cellRando * _GlitterRandomLocation;
                        if (dot(cellDiff, cellDiff) >= maxParticleDistSq) continue;
                        processGlitterParticle(poiFragData, poiMesh, poiCam, poiLight, poiMods, poiGlitterData, cellRando, cellDiff);
                    }
                }
            }
            else
            {
                // Default: find the closest cell and process its particle only.
                float m_distSq = 100.;
                float2 randoPoint = 0;
                float2 closestDiff = 0;

                [loop] for (int cellJ = -1; cellJ <= 1; cellJ++)
                {
                    [loop] for (int cellI = -1; cellI <= 1; cellI++)
                    {
                        float2 neighbor = float2(cellI, cellJ);
                        float2 cellRando = poiRand2(neighborhoodSeed + neighbor);
                        float2 cellDiff = neighborhoodOrigin + neighbor + cellRando * _GlitterRandomLocation;
                        float cellDistSq = dot(cellDiff, cellDiff);
                        if (cellDistSq < m_distSq)
                        {
                            closestDiff = cellDiff;
                            m_distSq = cellDistSq;
                            randoPoint = cellRando;
                        }
                    }
                }

                if (m_distSq < maxParticleDistSq)
                    processGlitterParticle(poiFragData, poiMesh, poiCam, poiLight, poiMods, poiGlitterData, randoPoint, closestDiff);
            }
        }
    }
#endif
//endex

#T#PoiGlitterFunctionCalls
