#T#PoiSkinFunctions
//ifex _PoiSkinEnabled==0
#ifdef POI_SKIN
float3 PoiSampleSkinLUT(Texture2D lut, float melanin, float melaninRedness, float hemoglobin)
{
	// Skip non-monotonic zones at LUT edges
	melanin = lerp(0.08, 0.92, melanin);

	float blend = (1.0 - melaninRedness) * 2.0;
	int panelA = min((int)blend, 1);
	int panelB = panelA + 1;
	float panelLerp = blend - (float)panelA;

	float margin = 1.0 / 384.0;
	float pw = 1.0 / 3.0;

	float uA = panelA * pw + margin + (pw - 2.0 * margin) * melanin;
	float uB = panelB * pw + margin + (pw - 2.0 * margin) * melanin;

	float v = 1.0 - hemoglobin;

	half3 colorA = lut.SampleLevel(sampler_linear_clamp, float2(uA, v), 0).rgb;
	half3 colorB = lut.SampleLevel(sampler_linear_clamp, float2(uB, v), 0).rgb;
	return lerp(colorA, colorB, panelLerp);
}

void applySkin(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiMods poiMods)
{
	float localMelanin = _PoiSkinMelanin;
	float localMelaninRedness = _PoiSkinMelaninRedness;
	float localHemoglobin = _PoiSkinHemoglobin;

	#if defined(PROP_POISKINDETAILMAP) || !defined(OPTIMIZER_ENABLED)
	{
		// Freckles (R channel) - adds localized melanin
		if (_PoiSkinFrecklesEnabled >= 0.5)
		{
			float2 freckleUV = poiMesh.uv[_PoiSkinFreckleMapUV].xy * _PoiSkinFreckleMapTiling.xy;
			half freckleMask = _PoiSkinDetailMap.Sample(sampler_MainTex, freckleUV).g;
			freckleMask = pow(freckleMask, _PoiSkinFreckleSharpness) * _PoiSkinFreckleStrength;
			localMelanin += freckleMask;
			localMelaninRedness += freckleMask * _PoiSkinFreckleRedness;
		}

	}
	#endif

	// Tan - increases melanin, shifts redness toward eumelanin
	if (_PoiSkinTanEnabled >= 0.5)
	{
		half tanMask = 1.0;
		#if defined(PROP_POISKINDETAILMAP) || !defined(OPTIMIZER_ENABLED)
		{
			float2 tanUV = poiMesh.uv[_PoiSkinTanMapUV].xy * _PoiSkinTanMapTiling.xy;
			tanMask = _PoiSkinDetailMap.Sample(sampler_MainTex, tanUV).b;
		}
		#endif
		localMelanin += _PoiSkinTanAmount * tanMask;
		localMelaninRedness += _PoiSkinTanRednessShift * tanMask;
	}

	localMelanin = saturate(localMelanin);
	localMelaninRedness = saturate(localMelaninRedness);
	localHemoglobin = saturate(localHemoglobin);

	half3 skinColor = float3(1, 1, 1);
	#if defined(PROP_POISKINLUT) || !defined(OPTIMIZER_ENABLED)
	{
		skinColor = PoiSampleSkinLUT(_PoiSkinLUT, localMelanin, localMelaninRedness, localHemoglobin);
	}
	#endif

	skinColor *= _PoiSkinBrightness;
	skinColor *= poiThemeColor(poiMods, _PoiSkinColorTint.rgb, _PoiSkinColorTintThemeIndex);

	// Mask (R channel) - black = no masking (full effect), white = masked out
	float skinBlend = _PoiSkinBlend;
	#if defined(PROP_POISKINDETAILMAP) || !defined(OPTIMIZER_ENABLED)
	{
		half mask = 1.0 - _PoiSkinDetailMap.Sample(sampler_MainTex, poiMesh.uv[0].xy).r;
		skinBlend *= mask;
	}
	#endif

	UNITY_BRANCH
	if (_PoiSkinBlendMode == 0)
	{
		poiFragData.baseColor = lerp(poiFragData.baseColor, skinColor, skinBlend);
	}
	else
	{
		poiFragData.baseColor = lerp(poiFragData.baseColor, poiFragData.baseColor * skinColor, skinBlend);
	}
}
#endif
//endex

#T#PoiSkinFunctionCall
//ifex _PoiSkinEnabled==0
#ifdef POI_SKIN
	applySkin(poiFragData, poiMesh, poiMods);
	#K#SKIN_HOOK
#endif
//endex
