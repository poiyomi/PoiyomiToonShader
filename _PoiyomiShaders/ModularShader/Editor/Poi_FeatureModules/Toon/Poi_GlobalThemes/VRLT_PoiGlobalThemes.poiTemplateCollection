#T#PoiGlobalThemesFunctions
// Saturation for theme colors. Below 0 this is a plain OKLab chroma reduction toward grey.
// From 0 to 1 it strips the achromatic content out of the color, which is what "more saturated"
// conventionally means. Past 1 there is no chroma left for sRGB to give at this hue, so the
// remainder deepens the color by dropping its level instead of the slider going dead.
half3 poiThemeSaturation(half3 color, half amount)
{
	if (amount <= 0.0)
	{
		return PoiApplyChromatize(color, amount);
	}
	half minRgb = min(color.r, min(color.g, color.b));
	half maxRgb = max(color.r, max(color.g, color.b));
	half rangeRgb = maxRgb - minRgb;
	// A greyscale color has no hue to push toward, so leave it alone.
	half3 pureHue = (rangeRgb > 0.0001) ? ((color - minRgb) / rangeRgb) * maxRgb : color;
	half3 saturated = lerp(color, pureHue, saturate(amount));
	return saturated / (1.0 + 0.35 * max(amount - 1.0, 0.0));
}

void calculateGlobalThemes(inout PoiMods poiMods)
{
	// Theme colors are defined as HDR; convert to SDR and do the HSV adjustment, then re-apply exposure
	half4 themeColorExposures = 0;
	half4 themeColor0, themeColor1, themeColor2, themeColor3 = 0;

	DecomposeHDRColor(_GlobalThemeColor0.rgb, themeColor0.rgb, themeColorExposures.x);
	DecomposeHDRColor(_GlobalThemeColor1.rgb, themeColor1.rgb, themeColorExposures.y);
	DecomposeHDRColor(_GlobalThemeColor2.rgb, themeColor2.rgb, themeColorExposures.z);
	DecomposeHDRColor(_GlobalThemeColor3.rgb, themeColor3.rgb, themeColorExposures.w);

	// Global Theme 0
	float themeHue0 = frac(_GlobalThemeHue0 + _GlobalThemeHueSpeed0 * POI_TIME.x);
	[flatten]
	switch((int)_GlobalThemeSaturationMethod0)
	{
		// Saturation/Value (old)
		case 0:
		{
			themeColor0.rgb = ModifyViaHSV(themeColor0.rgb, 0.0, _GlobalThemeSaturation0, _GlobalThemeValue0);
			themeColor0.rgb = hueShift(themeColor0.rgb, themeHue0, _GlobalThemeHueShiftColorSpace0, 1.0);
			break;
		}
		// Saturation/Brightness (new)
		case 1:
		{
			themeColor0.rgb = hueShift(themeColor0.rgb, themeHue0, _GlobalThemeHueShiftColorSpace0, 1.0);
			// Hue shifting in OKLab can land outside the sRGB gamut; clamp first so a negative channel
			// never reaches linear_srgb_to_oklab (pow of a negative is NaN).
			themeColor0.rgb = max(0.0, themeColor0.rgb);
			themeColor0.rgb = poiThemeSaturation(themeColor0.rgb, _GlobalThemeSaturation0);
			// Brightness rides on the exposure rather than the color. Scaling the color here instead was
			// undone by the peak rescale below - for a color already peaking at 1, multiplying by k and
			// then dividing by k left the original exactly, so the slider could darken but never brighten.
			// The exposure is applied after that rescale, which is the only place a gain survives.
			themeColorExposures.x += log2(max(_GlobalThemeBrightness0 + 1.0, 0.0001));
			themeColor0.rgb = max(0.0, themeColor0.rgb);
			break;
		}
		default:
		{
			themeColor0.rgb = float3(1.0, 0.0, 0.0);
			break;
		}
	}
	// DecomposeHDRColor guarantees max(channel) <= 1 on the normalized color; hue shifting, saturation
	// and brightness can each break that. Rescale by the peak instead of clamping per channel, so the hue
	// survives and the authored HDR intensity in themeColorExposures stays the only source of overbrightness.
	themeColor0.rgb = max(0.0, themeColor0.rgb);
	themeColor0.rgb /= max(1.0, max(themeColor0.r, max(themeColor0.g, themeColor0.b)));
	poiMods.globalColorTheme[0] = float4(ApplyHDRExposure(themeColor0.rgb, themeColorExposures.x), _GlobalThemeColor0.a);

	// Global Theme 1
	float themeHue1 = frac(_GlobalThemeHue1 + _GlobalThemeHueSpeed1 * POI_TIME.x);
	[flatten]
	switch((int)_GlobalThemeSaturationMethod1)
	{
		// Saturation/Value (old)
		case 0:
		{
			themeColor1.rgb = ModifyViaHSV(themeColor1.rgb, 0.0, _GlobalThemeSaturation1, _GlobalThemeValue1);
			themeColor1.rgb = hueShift(themeColor1.rgb, themeHue1, _GlobalThemeHueShiftColorSpace1, 1.0);
			break;
		}
		// Saturation/Brightness (new)
		case 1:
		{
			themeColor1.rgb = hueShift(themeColor1.rgb, themeHue1, _GlobalThemeHueShiftColorSpace1, 1.0);
			themeColor1.rgb = max(0.0, themeColor1.rgb);
			themeColor1.rgb = poiThemeSaturation(themeColor1.rgb, _GlobalThemeSaturation1);
			// See the note on theme 0: brightness has to go through the exposure to survive the rescale.
			themeColorExposures.y += log2(max(_GlobalThemeBrightness1 + 1.0, 0.0001));
			themeColor1.rgb = max(0.0, themeColor1.rgb);
			break;
		}
		default:
		{
			themeColor1.rgb = float3(1.0, 0.0, 0.0);
			break;
		}
	}
	themeColor1.rgb = max(0.0, themeColor1.rgb);
	themeColor1.rgb /= max(1.0, max(themeColor1.r, max(themeColor1.g, themeColor1.b)));
	poiMods.globalColorTheme[1] = float4(ApplyHDRExposure(themeColor1.rgb, themeColorExposures.y), _GlobalThemeColor1.a);

	// Global Theme 2
	float themeHue2 = frac(_GlobalThemeHue2 + _GlobalThemeHueSpeed2 * POI_TIME.x);
	[flatten]
	switch((int)_GlobalThemeSaturationMethod2)
	{
		// Saturation/Value (old)
		case 0:
		{
			themeColor2.rgb = ModifyViaHSV(themeColor2.rgb, 0.0, _GlobalThemeSaturation2, _GlobalThemeValue2);
			themeColor2.rgb = hueShift(themeColor2.rgb, themeHue2, _GlobalThemeHueShiftColorSpace2, 1.0);
			break;
		}
		// Saturation/Brightness (new)
		case 1:
		{
			themeColor2.rgb = hueShift(themeColor2.rgb, themeHue2, _GlobalThemeHueShiftColorSpace2, 1.0);
			themeColor2.rgb = max(0.0, themeColor2.rgb);
      		themeColor2.rgb = poiThemeSaturation(themeColor2.rgb, _GlobalThemeSaturation2);
			// See the note on theme 0: brightness has to go through the exposure to survive the rescale.
			themeColorExposures.z += log2(max(_GlobalThemeBrightness2 + 1.0, 0.0001));
			themeColor2.rgb = max(0.0, themeColor2.rgb);
			break;
		}
		default:
		{
			themeColor2.rgb = float3(1.0, 0.0, 0.0);
			break;
		}
	}
	themeColor2.rgb = max(0.0, themeColor2.rgb);
	themeColor2.rgb /= max(1.0, max(themeColor2.r, max(themeColor2.g, themeColor2.b)));
	poiMods.globalColorTheme[2] = float4(ApplyHDRExposure(themeColor2.rgb, themeColorExposures.z), _GlobalThemeColor2.a);

	// Global Theme 3
	float themeHue3 = frac(_GlobalThemeHue3 + _GlobalThemeHueSpeed3 * POI_TIME.x);
	[flatten]
	switch((int)_GlobalThemeSaturationMethod3)
	{
		// Saturation/Value (old)
		case 0:
		{
			themeColor3.rgb = ModifyViaHSV(themeColor3.rgb, 0.0, _GlobalThemeSaturation3, _GlobalThemeValue3);
			themeColor3.rgb = hueShift(themeColor3.rgb, themeHue3, _GlobalThemeHueShiftColorSpace3, 1.0);
			break;
		}
		// Saturation/Brightness (new)
		case 1:
		{
			themeColor3.rgb = hueShift(themeColor3.rgb, themeHue3, _GlobalThemeHueShiftColorSpace3, 1.0);
			themeColor3.rgb = max(0.0, themeColor3.rgb);
      		themeColor3.rgb = poiThemeSaturation(themeColor3.rgb, _GlobalThemeSaturation3);
			// See the note on theme 0: brightness has to go through the exposure to survive the rescale.
			themeColorExposures.w += log2(max(_GlobalThemeBrightness3 + 1.0, 0.0001));
			themeColor3.rgb = max(0.0, themeColor3.rgb);
			break;
		}
		default:
		{
			themeColor3.rgb = float3(1.0, 0.0, 0.0);
			break;
		}
	}
	themeColor3.rgb = max(0.0, themeColor3.rgb);
	themeColor3.rgb /= max(1.0, max(themeColor3.r, max(themeColor3.g, themeColor3.b)));
	poiMods.globalColorTheme[3] = float4(ApplyHDRExposure(themeColor3.rgb, themeColorExposures.w), _GlobalThemeColor3.a);
}

