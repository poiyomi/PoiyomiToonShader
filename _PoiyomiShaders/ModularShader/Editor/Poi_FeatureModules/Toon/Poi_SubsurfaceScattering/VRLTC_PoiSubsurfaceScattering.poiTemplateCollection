#T#PoiSubsurfaceScatteringFunctions
//ifex _SubsurfaceScattering==0
#ifdef POI_SUBSURFACESCATTERING
    void applySubsurfaceScattering(in PoiCam poiCam, inout PoiLight poiLight, in PoiMesh poiMesh, in PoiFragData poiFragData, in PoiMods poiMods)
    {
        float4 SSS = 1;
        #if defined(PROP_SSSTHICKNESSMAP) || !defined(OPTIMIZER_ENABLED)
            SSS = POI2D_SAMPLER_PAN(_SSSThicknessMap, _MainTex, poiUV(poiMesh.uv[_SSSThicknessMapUV], _SSSThicknessMap_ST), _SSSThicknessMapPan);
        #endif
        SSS.a = 1 - SSS.a;

        float3 sssLightDir = poiLight.direction;
        #if POI_PIPE == POI_BIRP
            if (poiLight.lightType == POI_POINT_SPOT)
                sssLightDir = normalize(_WorldSpaceLightPos0.xyz - poiMesh.worldPos.xyz);
        #endif

        // directColor hard-clips the transmitted light for point/spot, don't use the shadowAtten
        half3 sssLightColor = poiLight.directColor;
        float sssReach = 1;
        if (poiLight.lightType == POI_POINT_SPOT)
        {
            sssLightColor = poiLight.unityLight.color.rgb;
            sssReach = poiLight.attenDistance * CalculateLuminance(poiLight.lightCookie);
        }

        float3 vLTLight = sssLightDir + poiMesh.normals[1] * _SSSDistortion;
		float flTDot = pow(saturate(dot(poiCam.eyeViewDir, -vLTLight)), _SSSSpread) * _SSSStrength;
        float3 fLT = (flTDot) * saturate(SSS.a + - 1 * _SSSThicknessMod);

        half sssLightMap = poiLight.lightMap;
        half sssShadow = lerp(1, sssLightMap, _SSSShadowStrength);

        half sssMask = 1;
        if (_SSSGlobalMaskIndex > 0)
            sssMask = maskBlend(sssMask, poiMods.globalMask[_SSSGlobalMaskIndex - 1], _SSSGlobalMaskBlendType);

        half3 sssTint = _SSSColor.rgb * SSS.rgb;
        float3 sssLight = lerp(1, sssLightColor, _SSSLightColorMix);

        poiLight.finalLightAdd += fLT * sssReach * sssLight * sssTint * sssShadow  * lerp(1, poiFragData.baseColor, _SSSBaseColorMix) * sssMask;
    }
#endif
//endex

#T#PoiSubsurfaceScatteringFunctionCalls
//ifex _SubsurfaceScattering==0
#ifdef POI_SUBSURFACESCATTERING
    applySubsurfaceScattering(poiCam, poiLight, poiMesh, poiFragData, poiMods);
#endif
//endex
