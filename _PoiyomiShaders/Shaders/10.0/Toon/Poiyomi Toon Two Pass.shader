				if (_BlackLightMasking3GlobalMaskIndex > 0)
				{
					applyToGlobalMask(poiMods, _BlackLightMasking3GlobalMaskIndex - 1, _BlackLightMasking3GlobalMaskBlendType, 0);
				}
				#endif
			}
