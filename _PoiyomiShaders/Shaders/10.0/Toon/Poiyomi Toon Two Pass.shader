			//ifex _MochieBRDF==0
			#ifdef MOCHIE_PBR
			void MetallicAndSpecularFragDataInit(inout PoiFragData poiFragData, inout MochieBRDFData mochieBRDFData, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				half smoothness = _MochieRoughnessMultiplier;
				half smoothness2 = _MochieRoughnessMultiplier2;
				half metallic = _MochieMetallicMultiplier;
				half specularMask = 1;
				half reflectionMask = 1;
				
				smoothness *= poiFragData.smoothness;
				smoothness2 *= poiFragData.smoothness2;
				metallic *= poiFragData.metallic;
				specularMask *= poiFragData.specularMask;
				reflectionMask *= poiFragData.reflectionMask;
				
				#if defined(PROP_MOCHIEMETALLICMAPS) || !defined(OPTIMIZER_ENABLED)
				half4 PBRMaps = POI2D_SAMPLER_PAN_STOCHASTIC(_MochieMetallicMaps, _MainTex, poiUV(poiMesh.uv[_MochieMetallicMapsUV], _MochieMetallicMaps_ST), _MochieMetallicMapsPan, _MochieMetallicMapsStochastic);
				UNITY_BRANCH
				if (_PBRSplitMaskSample >= 0.5)
				{
					half4 PBRSplitMask = POI2D_SAMPLER_PAN_STOCHASTIC(_MochieMetallicMaps, _MainTex, poiUV(poiMesh.uv[_MochieMetallicMasksUV], _PBRMaskScaleTiling), _MochieMetallicMasksPan.xy, _PBRSplitMaskStochastic);
					half reflVal = _MochieMetallicMapsReflectionMaskChannel < 4 ? PBRSplitMask[min(_MochieMetallicMapsReflectionMaskChannel, 3)] : 1.0h;
					half specVal = _MochieMetallicMapsSpecularMaskChannel < 4 ? PBRSplitMask[min(_MochieMetallicMapsSpecularMaskChannel, 3)] : 1.0h;
					if (_MochieMetallicMapsReflectionMaskChannel < 4) assignValueToVectorFromIndex(PBRMaps, _MochieMetallicMapsReflectionMaskChannel, reflVal);
					if (_MochieMetallicMapsSpecularMaskChannel < 4) assignValueToVectorFromIndex(PBRMaps, _MochieMetallicMapsSpecularMaskChannel, specVal);
				}
				
				// Locking makes channels literal constants; even unused branches need valid vector indices.
				if (_MochieMetallicMapsMetallicChannel < 4)
				{
					metallic *= PBRMaps[min(_MochieMetallicMapsMetallicChannel, 3)];
				}
				if (_MochieMetallicMapsRoughnessChannel < 4)
				{
					smoothness *= PBRMaps[min(_MochieMetallicMapsRoughnessChannel, 3)];
					smoothness2 *= PBRMaps[min(_MochieMetallicMapsRoughnessChannel, 3)];
				}
				if (_MochieMetallicMapsReflectionMaskChannel < 4)
				{
					reflectionMask *= PBRMaps[min(_MochieMetallicMapsReflectionMaskChannel, 3)];
				}
				if (_MochieMetallicMapsSpecularMaskChannel < 4)
				{
					specularMask *= PBRMaps[min(_MochieMetallicMapsSpecularMaskChannel, 3)];
				}
				#endif
				
				reflectionMask *= _MochieReflectionStrength;
				specularMask *= _MochieSpecularStrength;
				
				if (_MochieMetallicMapInvert >= 0.5)
				{
					metallic = 1 - metallic;
				}
				if (_MochieRoughnessMapInvert >= 0.5)
				{
					smoothness = 1 - smoothness;
					smoothness2 = 1 - smoothness2;
				}
				if (_MochieReflectionMaskInvert >= 0.5)
				{
					reflectionMask = 1 - reflectionMask;
				}
				if (_MochieSpecularMaskInvert >= 0.5)
				{
					specularMask = 1 - specularMask;
				}
				
				poiFragData.smoothness *= smoothness;
				poiFragData.smoothness2 *= smoothness2;
				poiFragData.metallic *= metallic;
				poiFragData.specularMask *= specularMask;
				poiFragData.reflectionMask *= reflectionMask;
				
				// specific metallics and specular data for mochie brdf
				
				mochieBRDFData.smoothness = poiFragData.smoothness;
				mochieBRDFData.smoothness2 = poiFragData.smoothness2;
				mochieBRDFData.metallic = poiFragData.metallic;
				mochieBRDFData.specularMask = poiFragData.specularMask;
				mochieBRDFData.reflectionMask = poiFragData.reflectionMask;
				
				float2 adjustedAnisotropy = 0;
				#ifdef GGX_ANISOTROPICS
				#if defined(PROP_ANISOTROPYMAP) || !defined(OPTIMIZER_ENABLED)
				float4 anisotropyMap = POI2D_SAMPLER_PAN(_AnisotropyMap, _MainTex, poiUV(poiMesh.uv[_AnisotropyMapUV], _AnisotropyMap_ST), _AnisotropyMapPan);
				adjustedAnisotropy = (anisotropyMap[_AnisotropyMapChannel] - .5) * 2;
				#endif
				adjustedAnisotropy = clamp(adjustedAnisotropy + _Anisotropy, -1, 1);
				adjustedAnisotropy.y = abs(adjustedAnisotropy.y);
				#endif
				
				mochieBRDFData.adjustedAnisotropy = adjustedAnisotropy;
				
				float3 pbrNSelect = lerp(poiMesh.normals[0], poiMesh.normals[1], _PBRNormalSelect);
				float3 pbrTSelect = lerp(poiMesh.tangent[0], poiMesh.tangent[1], _PBRNormalSelect);
				float3 pbrBSelect = lerp(poiMesh.binormal[0], poiMesh.binormal[1], _PBRNormalSelect);
				
				mochieBRDFData.pbrNSelect = pbrNSelect;
				mochieBRDFData.pbrTSelect = pbrTSelect;
				mochieBRDFData.pbrBSelect = pbrBSelect;
			}
			
			void FinalizeMochieBRDFData(inout MochieBRDFData mochieBRDFData, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				if (mochieBRDFData.isInitialized >= 0.5)
				{
					return;
				}
				mochieBRDFData.isInitialized = 1;
				
				if (_MochieMetallicGlobalMask > 0)
				{
					mochieBRDFData.metallic = maskBlend(mochieBRDFData.metallic, poiMods.globalMask[_MochieMetallicGlobalMask - 1], _MochieMetallicGlobalMaskBlendType);
				}
				if (_MochieSmoothnessGlobalMask > 0)
				{
					mochieBRDFData.smoothness = maskBlend(mochieBRDFData.smoothness, poiMods.globalMask[_MochieSmoothnessGlobalMask - 1], _MochieSmoothnessGlobalMaskBlendType);
					mochieBRDFData.smoothness2 = maskBlend(mochieBRDFData.smoothness2, poiMods.globalMask[_MochieSmoothnessGlobalMask - 1], _MochieSmoothnessGlobalMaskBlendType);
				}
				if (_MochieReflectionStrengthGlobalMask > 0)
				{
					mochieBRDFData.reflectionMask = customBlend(mochieBRDFData.reflectionMask, poiMods.globalMask[_MochieReflectionStrengthGlobalMask - 1], _MochieReflectionStrengthGlobalMaskBlendType);
				}
				if (_MochieSpecularStrengthGlobalMask > 0)
				{
					mochieBRDFData.specularMask = customBlend(mochieBRDFData.specularMask, poiMods.globalMask[_MochieSpecularStrengthGlobalMask - 1], _MochieSpecularStrengthGlobalMaskBlendType);
				}
				
				#ifdef TPS_Penetrator
				if (_BRDFTPSDepthEnabled >= 0.5)
				{
					mochieBRDFData.reflectionMask = lerp(0, mochieBRDFData.reflectionMask * TPSBufferedDepth(poiMesh.localPos, poiMesh.vertexColor), _BRDFTPSReflectionMaskStrength);
					mochieBRDFData.specularMask = lerp(0, mochieBRDFData.specularMask * TPSBufferedDepth(poiMesh.localPos, poiMesh.vertexColor), _BRDFTPSSpecularMaskStrength);
				}
				#endif
				
				//ifex _RGBMaskEnabled==0
				#ifdef VIGNETTE
				// Apply RGBA Masking PBR values to mochieBRDFData
				if (_RGBAPBRRedEnabled >= 0.5 || _RGBAPBRGreenEnabled >= 0.5 || _RGBAPBRBlueEnabled >= 0.5 || _RGBAPBRAlphaEnabled >= 0.5)
				{
					half4 rgbMaskPBR = float4(1, 1, 1, 1);
					
					#if defined(PROP_RGBMASK)
					if (_RGBMaskType == 0)
					{
						rgbMaskPBR = POI2D_SAMPLER_PAN(_RGBMask, _MainTex, poiUV(poiMesh.uv[_RGBMaskUV], _RGBMask_ST), _RGBMaskPan);
					}
					#endif
					
					if (_RGBMaskType == 1)
					{
						rgbMaskPBR = poiMesh.vertexColor;
					}
					
					#if defined(PROP_RGBASMOOTHNESSMAPS)
					half4 smoothnessMaps = 1;
					if (_RGBARedPBRSplitMaskSample < 0.5 || _RGBAGreenPBRSplitMaskSample < 0.5 || _RGBABluePBRSplitMaskSample < 0.5 || _RGBAAlphaPBRSplitMaskSample < 0.5)
					{
						smoothnessMaps = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBASmoothnessMaps, _MainTex, poiUV(poiMesh.uv[_RGBASmoothnessMapsUV], _RGBASmoothnessMaps_ST), _RGBASmoothnessMapsPan.xy, _RGBASmoothnessMapsStochastic);
					}
					
					if (_RGBARedPBRSplitMaskSample >= 0.5 && _RGBAPBRRedEnabled >= 0.5 && _RGBARedEnable >= 0.5)
					{
						smoothnessMaps.r = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBASmoothnessMaps, _MainTex, poiUV(poiMesh.uv[_RGBARedPBRUV], PoiUVMerge(_RGBARedPBRMaskScaleTiling, _RGBARedScaleOffset)), _RGBARedPBRMasksPan.xy, _RGBARedPBRSplitMaskStochastic).r;
					}
					if (_RGBAGreenPBRSplitMaskSample >= 0.5 && _RGBAPBRGreenEnabled >= 0.5 && _RGBAGreenEnable >= 0.5)
					{
						smoothnessMaps.g = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBASmoothnessMaps, _MainTex, poiUV(poiMesh.uv[_RGBAGreenPBRUV], PoiUVMerge(_RGBAGreenPBRMaskScaleTiling, _RGBAGreenScaleOffset)), _RGBAGreenPBRMasksPan.xy, _RGBAGreenPBRSplitMaskStochastic).g;
					}
					if (_RGBABluePBRSplitMaskSample >= 0.5 && _RGBAPBRBlueEnabled >= 0.5 && _RGBABlueEnable >= 0.5)
					{
						smoothnessMaps.b = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBASmoothnessMaps, _MainTex, poiUV(poiMesh.uv[_RGBABluePBRUV], PoiUVMerge(_RGBABluePBRMaskScaleTiling, _RGBABlueScaleOffset)), _RGBABluePBRMasksPan.xy, _RGBABluePBRSplitMaskStochastic).b;
					}
					if (_RGBAAlphaPBRSplitMaskSample >= 0.5 && _RGBAPBRAlphaEnabled >= 0.5 && _RGBAAlphaEnable >= 0.5)
					{
						smoothnessMaps.a = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBASmoothnessMaps, _MainTex, poiUV(poiMesh.uv[_RGBAAlphaPBRUV], PoiUVMerge(_RGBAAlphaPBRMaskScaleTiling, _RGBAAlphaScaleOffset)), _RGBAAlphaPBRMasksPan.xy, _RGBAAlphaPBRSplitMaskStochastic).a;
					}
					
					mochieBRDFData.smoothness = lerp(mochieBRDFData.smoothness, poiInvertToggle(smoothnessMaps.r, _RGBARedSmoothnessInvert), rgbMaskPBR[_RgbRedMaskChannel] * (_RGBAPBRRedEnabled >= 0.5 && _RGBARedEnable >= 0.5));
					mochieBRDFData.smoothness = lerp(mochieBRDFData.smoothness, poiInvertToggle(smoothnessMaps.g, _RGBAGreenSmoothnessInvert), rgbMaskPBR[_RgbGreenMaskChannel] * (_RGBAPBRGreenEnabled >= 0.5 && _RGBAGreenEnable >= 0.5));
					mochieBRDFData.smoothness = lerp(mochieBRDFData.smoothness, poiInvertToggle(smoothnessMaps.b, _RGBABlueSmoothnessInvert), rgbMaskPBR[_RgbBlueMaskChannel] * (_RGBAPBRBlueEnabled >= 0.5 && _RGBABlueEnable >= 0.5));
					mochieBRDFData.smoothness = lerp(mochieBRDFData.smoothness, poiInvertToggle(smoothnessMaps.a, _RGBAAlphaSmoothnessInvert), rgbMaskPBR[_RgbAlphaMaskChannel] * (_RGBAPBRAlphaEnabled >= 0.5 && _RGBAAlphaEnable >= 0.5));
					#endif
					
					#if defined(PROP_RGBAMETALLICMAPS)
					half4 metallicMaps = 1;
					if (_RGBARedPBRSplitMaskSample < 0.5 || _RGBAGreenPBRSplitMaskSample < 0.5 || _RGBABluePBRSplitMaskSample < 0.5 || _RGBAAlphaPBRSplitMaskSample < 0.5)
					{
						metallicMaps = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBAMetallicMaps, _MainTex, poiUV(poiMesh.uv[_RGBAMetallicMapsUV], _RGBAMetallicMaps_ST), _RGBAMetallicMapsPan.xy, _RGBAMetallicMapsStochastic);
					}
					
					if (_RGBARedPBRSplitMaskSample >= 0.5 && _RGBAPBRRedEnabled >= 0.5 && _RGBARedEnable >= 0.5)
					{
						metallicMaps.r = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBAMetallicMaps, _MainTex, poiUV(poiMesh.uv[_RGBARedPBRUV], PoiUVMerge(_RGBARedPBRMaskScaleTiling, _RGBARedScaleOffset)), _RGBARedPBRMasksPan.xy, _RGBARedPBRSplitMaskStochastic).r;
					}
					if (_RGBAGreenPBRSplitMaskSample >= 0.5 && _RGBAPBRGreenEnabled >= 0.5 && _RGBAGreenEnable >= 0.5)
					{
						metallicMaps.g = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBAMetallicMaps, _MainTex, poiUV(poiMesh.uv[_RGBAGreenPBRUV], PoiUVMerge(_RGBAGreenPBRMaskScaleTiling, _RGBAGreenScaleOffset)), _RGBAGreenPBRMasksPan.xy, _RGBAGreenPBRSplitMaskStochastic).g;
					}
					if (_RGBABluePBRSplitMaskSample >= 0.5 && _RGBAPBRBlueEnabled >= 0.5 && _RGBABlueEnable >= 0.5)
					{
						metallicMaps.b = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBAMetallicMaps, _MainTex, poiUV(poiMesh.uv[_RGBABluePBRUV], PoiUVMerge(_RGBABluePBRMaskScaleTiling, _RGBABlueScaleOffset)), _RGBABluePBRMasksPan.xy, _RGBABluePBRSplitMaskStochastic).b;
					}
					if (_RGBAAlphaPBRSplitMaskSample >= 0.5 && _RGBAPBRAlphaEnabled >= 0.5 && _RGBAAlphaEnable >= 0.5)
					{
						metallicMaps.a = POI2D_SAMPLER_PAN_STOCHASTIC(_RGBAMetallicMaps, _MainTex, poiUV(poiMesh.uv[_RGBAAlphaPBRUV], PoiUVMerge(_RGBAAlphaPBRMaskScaleTiling, _RGBAAlphaScaleOffset)), _RGBAAlphaPBRMasksPan.xy, _RGBAAlphaPBRSplitMaskStochastic).a;
					}
					
					mochieBRDFData.metallic = lerp(mochieBRDFData.metallic, poiInvertToggle(metallicMaps.r, _RGBARedMetallicInvert), rgbMaskPBR[_RgbRedMaskChannel] * (_RGBAPBRRedEnabled >= 0.5 && _RGBARedEnable >= 0.5));
					mochieBRDFData.metallic = lerp(mochieBRDFData.metallic, poiInvertToggle(metallicMaps.g, _RGBAGreenMetallicInvert), rgbMaskPBR[_RgbGreenMaskChannel] * (_RGBAPBRGreenEnabled >= 0.5 && _RGBAGreenEnable >= 0.5));
					mochieBRDFData.metallic = lerp(mochieBRDFData.metallic, poiInvertToggle(metallicMaps.b, _RGBABlueMetallicInvert), rgbMaskPBR[_RgbBlueMaskChannel] * (_RGBAPBRBlueEnabled >= 0.5 && _RGBABlueEnable >= 0.5));
					mochieBRDFData.metallic = lerp(mochieBRDFData.metallic, poiInvertToggle(metallicMaps.a, _RGBAAlphaMetallicInvert), rgbMaskPBR[_RgbAlphaMaskChannel] * (_RGBAPBRAlphaEnabled >= 0.5 && _RGBAAlphaEnable >= 0.5));
					#endif
				}
				#endif
				//endex
				
				half roughness = GetRoughness(mochieBRDFData.smoothness);
				half roughness2 = GetRoughness(mochieBRDFData.smoothness2);
				
				float omr = unity_ColorSpaceDielectricSpec.a - mochieBRDFData.metallic * unity_ColorSpaceDielectricSpec.a;
				float percepRough = 1 - mochieBRDFData.smoothness;
				float percepRough2 = 1 - mochieBRDFData.smoothness2;
				UNITY_BRANCH
				if (_MochieGSAAEnabled >= 0.5)
				{
					float3 normals = lerp(poiMesh.normals[0], poiMesh.normals[1], _PBRNormalSelect);
					percepRough = GSAA_Filament(normals, percepRough, _PoiGSAAVariance, _PoiGSAAThreshold);
					if (_Specular2ndLayer >= 0.5 && _MochieSpecularStrength2 > 0)
					{
						percepRough2 = GSAA_Filament(normals, percepRough2, _PoiGSAAVariance, _PoiGSAAThreshold);
					}
				}
				half brdfRoughness = percepRough * percepRough;
				brdfRoughness = max(brdfRoughness, 0.002);
				
				half brdfRoughness2 = percepRough2 * percepRough2;
				brdfRoughness2 = max(brdfRoughness2, 0.002);
				
				mochieBRDFData.roughness = roughness;
				mochieBRDFData.brdfRoughness = brdfRoughness;
				mochieBRDFData.brdfRoughness2 = brdfRoughness2;
				mochieBRDFData.percepRough = percepRough;
				mochieBRDFData.percepRough2 = percepRough2;
				mochieBRDFData.omr = omr;
			}
			
			void MochieBRDFSpecular(inout PoiFragData poiFragData, inout MochieBRDFData mochieBRDFData, in PoiCam poiCam, inout PoiLight poiLight, in PoiMesh poiMesh, inout PoiMods poiMods)
			{
				FinalizeMochieBRDFData(mochieBRDFData, poiMesh, poiMods);
				
				half specularMask = mochieBRDFData.specularMask;
				half3 specTint = poiThemeColor(poiMods, _MochieSpecularTint.rgb, _MochieSpecularTintThemeIndex);
				
				float3 specCol = lerp(unity_ColorSpaceDielectricSpec.rgb, poiFragData.baseColor, mochieBRDFData.metallic);
				mochieBRDFData.specCol = specCol;
				
				half roughness = mochieBRDFData.roughness;
				half brdfRoughness = mochieBRDFData.brdfRoughness;
				half brdfRoughness2 = mochieBRDFData.brdfRoughness2;
				
				float omr = mochieBRDFData.omr;
				
				half3 specular = 0;
				half3 specular2 = 0;
				half3 vSpecular = 0;
				half3 vSpecular2 = 0;
				float3 environment = 0;
				
				// In the additive pass directColor already carries atten
				half specLightMap = poiLight.lightMap;
				half attenuation = lerp(specLightMap, 1, _IgnoreCastedShadows);
				
				half3 fresnelTerm = 1;
				half3 specularTerm = 1;
				
				float pbrNDotL = lerp(poiLight.vertexNDotL, poiLight.nDotL, _PBRNormalSelect);
				float pbrNDotV = lerp(poiLight.vertexNDotV, poiLight.nDotV, _PBRNormalSelect);
				float pbrNDotH = lerp(poiLight.vertexNDotH, poiLight.nDotH, _PBRNormalSelect);
				
				float3 pbrNSelect = mochieBRDFData.pbrNSelect;
				float3 pbrTSelect = mochieBRDFData.pbrTSelect;
				float3 pbrBSelect = mochieBRDFData.pbrBSelect;
				
				float pbrTDotV = dot(pbrTSelect, poiCam.eyeViewDir);
				float pbrBDotV = dot(pbrBSelect, poiCam.eyeViewDir);
				float pbrTDotL = dot(pbrTSelect, poiLight.direction);
				float pbrBDotL = dot(pbrBSelect, poiLight.direction);
				float pbrTDotH = dot(pbrTSelect, poiLight.halfDir);
				float pbrBDotH = dot(pbrBSelect, poiLight.halfDir);
				
				#ifdef GGX_ANISOTROPICS
				float2 adjustedAnisotropy = mochieBRDFData.adjustedAnisotropy;
				GetSpecFresTerm(pbrNDotL, pbrNDotV, pbrNDotH, poiLight.lDotH, specularTerm, fresnelTerm, specCol, brdfRoughness, pbrTDotV, pbrBDotV, pbrTDotL, pbrBDotL, pbrTDotH, pbrBDotH, adjustedAnisotropy);
				#else
				GetSpecFresTerm(pbrNDotL, pbrNDotV, pbrNDotH, poiLight.lDotH, specularTerm, fresnelTerm, specCol, brdfRoughness);
				#endif
				half specOcclusion = poiLight.occlusion;
				#ifdef POI_BENTNORMALMAP
				if (poiMesh.hasBentNormal > 0.5)
				{
					float3 specReflDir = reflect(-poiCam.eyeViewDir, lerp(poiMesh.normals[0], poiMesh.normals[1], _PBRNormalSelect));
					specOcclusion = lerp(poiLight.occlusion, PoiSpecularOcclusionBentNormal(specReflDir, poiMesh.bentNormal, poiLight.occlusion, mochieBRDFData.percepRough), _BentNormalSpecOccStrength);
				}
				#endif
				specular = poiLight.directColor * specularTerm * fresnelTerm * specularMask * specTint * specOcclusion * attenuation;
				
				if (poiFragData.toggleVertexLights)
				{
					#if defined(VERTEXLIGHT_ON)
					float3 vSpecBase = specularMask * specTint * specOcclusion;
					for (int index = 0; index < 4; index++)
					{
						fresnelTerm = 1;
						specularTerm = 1;
						float pbrVDotNL = lerp(poiLight.vertexVDotNL[index], poiLight.vDotNL[index], _PBRNormalSelect);
						float pbrVDotNH = lerp(poiLight.vertexVDotNH[index], poiLight.vDotNH[index], _PBRNormalSelect);
						
						#ifdef GGX_ANISOTROPICS
						float pbrTDotvL = dot(pbrTSelect, poiLight.vDirection[index]);
						float pbrBDotvL = dot(pbrBSelect, poiLight.vDirection[index]);
						float pbrTDotvH = dot(pbrTSelect, poiLight.vHalfDir[index]);
						float pbrBDotvH = dot(pbrBSelect, poiLight.vHalfDir[index]);
						GetSpecFresTerm(pbrVDotNL, pbrNDotV, pbrVDotNH, poiLight.vDotLH[index], specularTerm, fresnelTerm, specCol, brdfRoughness, pbrTDotV, pbrBDotV, pbrTDotvL, pbrBDotvL, pbrTDotvH, pbrBDotvH, adjustedAnisotropy);
						#else
						GetSpecFresTerm(pbrVDotNL, pbrNDotV, pbrVDotNH, poiLight.vDotLH[index], specularTerm, fresnelTerm, specCol, brdfRoughness);
						#endif
						vSpecular += poiLight.vColor[index] * specularTerm * fresnelTerm * vSpecBase;
					}
					#endif
				}
				
				if (_Specular2ndLayer >= 0.5)
				{
					half3 fresnelTerm = 1;
					half3 specularTerm = 1;
					#ifdef GGX_ANISOTROPICS
					GetSpecFresTerm(pbrNDotL, pbrNDotV, pbrNDotH, poiLight.lDotH, specularTerm, fresnelTerm, specCol, brdfRoughness2, pbrTDotV, pbrBDotV, pbrTDotL, pbrBDotL, pbrTDotH, pbrBDotH, adjustedAnisotropy);
					#else
					GetSpecFresTerm(pbrNDotL, pbrNDotV, pbrNDotH, poiLight.lDotH, specularTerm, fresnelTerm, specCol, brdfRoughness2);
					#endif
					specular2 = poiLight.directColor * specularTerm * fresnelTerm * specularMask * specTint * specOcclusion * attenuation * _MochieSpecularStrength2;
					
					if (poiFragData.toggleVertexLights)
					{
						#if defined(VERTEXLIGHT_ON)
						float3 vSpec2Base = specularMask * specTint * specOcclusion * _MochieSpecularStrength2;
						for (int index = 0; index < 4; index++)
						{
							fresnelTerm = 1;
							specularTerm = 1;
							float pbrVDotNL = lerp(poiLight.vertexVDotNL[index], poiLight.vDotNL[index], _PBRNormalSelect);
							float pbrVDotNH = lerp(poiLight.vertexVDotNH[index], poiLight.vDotNH[index], _PBRNormalSelect);
							
							#ifdef GGX_ANISOTROPICS
							float pbrTDotvL = dot(pbrTSelect, poiLight.vDirection[index]);
							float pbrBDotvL = dot(pbrBSelect, poiLight.vDirection[index]);
							float pbrTDotvH = dot(pbrTSelect, poiLight.vHalfDir[index]);
							float pbrBDotvH = dot(pbrBSelect, poiLight.vHalfDir[index]);
							GetSpecFresTerm(pbrVDotNL, pbrNDotV, pbrVDotNH, poiLight.vDotLH[index], specularTerm, fresnelTerm, specCol, brdfRoughness2, pbrTDotV, pbrBDotV, pbrTDotvL, pbrBDotvL, pbrTDotvH, pbrBDotvH, adjustedAnisotropy);
							#else
							GetSpecFresTerm(pbrVDotNL, pbrNDotV, pbrVDotNH, poiLight.vDotLH[index], specularTerm, fresnelTerm, specCol, brdfRoughness2);
							#endif
							vSpecular2 += poiLight.vColor[index] * specularTerm * fresnelTerm * vSpec2Base;
						}
						#endif
					}
				}
				environment = max(specular + vSpecular, specular2 + vSpecular2);
				//ifex (_LightingEnableLightVolumes==0 && isNotAnimated(_LightingEnableLightVolumes)) || (_LightingLightVolumesSpecular==0 && isNotAnimated(_LightingLightVolumesSpecular))
				#if (POI_PIPE == POI_BIRP) && defined(POI_PASS_BASE)
				if (_UdonLightVolumeEnabled && _LightingEnableLightVolumes >= 0.5 && _LightingLightVolumesSpecular > 0)
				{
					environment += LightVolumeSpecularDominant(specCol, 1.0 - mochieBRDFData.percepRough, normalize(pbrNSelect), poiCam.eyeViewDir, float3(PoiSHAr.w, PoiSHAg.w, PoiSHAb.w), PoiSHAr.xyz, PoiSHAg.xyz, PoiSHAb.xyz) * specularMask * specTint * specOcclusion * _LightingLightVolumesIntensity * _LightingLightVolumesSpecular;
				}
				#endif
				//endex
				poiLight.finalLightAdd += environment;
			}
			
			void MochieBRDFMetallics(inout PoiFragData poiFragData, inout MochieBRDFData mochieBRDFData, in PoiCam poiCam, inout PoiLight poiLight, in PoiMesh poiMesh, inout PoiMods poiMods)
			{
				FinalizeMochieBRDFData(mochieBRDFData, poiMesh, poiMods);
				
				half roughness = mochieBRDFData.roughness;
				
				half reflectionMask = mochieBRDFData.reflectionMask;
				float percepRough = mochieBRDFData.percepRough;
				half brdfRoughness = mochieBRDFData.brdfRoughness;
				
				float3 specCol = lerp(unity_ColorSpaceDielectricSpec.rgb, poiFragData.baseColor, mochieBRDFData.metallic);
				
				float3 reflections = 0;
				
				float pbrNDotL = lerp(poiLight.vertexNDotL, poiLight.nDotL, _PBRNormalSelect);
				float pbrNDotV = lerp(poiLight.vertexNDotV, poiLight.nDotV, _PBRNormalSelect);
				float pbrNDotH = lerp(poiLight.vertexNDotH, poiLight.nDotH, _PBRNormalSelect);
				
				float3 pbrReflectionDir = lerp(poiCam.vertexReflectionDir, poiCam.reflectionDir, _PBRNormalSelect);
				
				#ifdef GGX_ANISOTROPICS
				float2 adjustedAnisotropy = mochieBRDFData.adjustedAnisotropy;
				float3 pbrNSelect = mochieBRDFData.pbrNSelect;
				float3 pbrTSelect = mochieBRDFData.pbrTSelect;
				float3 pbrBSelect = mochieBRDFData.pbrBSelect;
				
				pbrReflectionDir = float3(dot(pbrReflectionDir, pbrTSelect), dot(pbrReflectionDir, pbrBSelect), dot(pbrReflectionDir, pbrNSelect));
				half pbrReflRoughness = lerp(1, roughness, _RoughnessAnisotropy);
				pbrReflectionDir.xy *= float2((1 - roughness * adjustedAnisotropy.y) * ((1) - pbrReflRoughness * adjustedAnisotropy.x * (_ReflectionAnisotropicStretch * adjustedAnisotropy.y)), (1 - roughness * adjustedAnisotropy.y) * ((1) + pbrReflRoughness * adjustedAnisotropy.x * (_ReflectionAnisotropicStretch * adjustedAnisotropy.y)));
				pbrReflectionDir = normalize(pbrReflectionDir.x * pbrTSelect + pbrReflectionDir.y * pbrBSelect + pbrReflectionDir.z * pbrNSelect);
				#endif
				
				float surfaceReduction = (1.0 / (brdfRoughness * brdfRoughness + 1.0));
				// float grazingTerm = saturate(smoothness + (1 - omr));
				#if defined(PROP_MOCHIEREFLCUBE) || !defined(OPTIMIZER_ENABLED)
				float3 reflCol = GetReflections(poiCam, poiLight, poiMesh, percepRough, _MochieForceFallback, _MochieLitFallback, _MochieReflCube, _MochieReflCube_HDR, pbrReflectionDir);
				#else
				float3 reflCol = GetReflections(poiCam, poiLight, poiMesh, percepRough, pbrReflectionDir);
				#endif
				reflections = surfaceReduction * reflCol * FresnelLerp(specCol, specCol + lerp(specCol, 1, _RefSpecFresnelStrength) * _RefSpecFresnelStrength, pbrNDotV) * SFVisibility(brdfRoughness, poiLight.directColor, pbrNDotV, _SFExposureOcclusion);
				reflections *= poiThemeColor(poiMods, _MochieReflectionTint.rgb, _MochieReflectionTintThemeIndex);
				
				//ifex (_LightingEnableLightVolumes==0 && isNotAnimated(_LightingEnableLightVolumes)) || (_LightingLightVolumesSpecular==0 && isNotAnimated(_LightingLightVolumesSpecular))
				#if (POI_PIPE == POI_BIRP) && defined(POI_PASS_BASE)
				if (_UdonLightVolumeEnabled && _LightingEnableLightVolumes >= 0.5 && _LightingLightVolumesSpecular > 0)
				{
					reflections += LightVolumeSpecularDominant(specCol, 1.0 - percepRough, normalize(mochieBRDFData.pbrNSelect), poiCam.eyeViewDir, float3(PoiSHAr.w, PoiSHAg.w, PoiSHAb.w), PoiSHAr.xyz, PoiSHAg.xyz, PoiSHAb.xyz) * _LightingLightVolumesIntensity * _LightingLightVolumesSpecular;
				}
				#endif
				//endex
				
				#ifdef POI_BENTNORMALMAP
				if (poiMesh.hasBentNormal > 0.5)
				{
					float bentNormalSO = PoiSpecularOcclusionBentNormal(pbrReflectionDir, poiMesh.bentNormal, poiLight.occlusion, percepRough);
					half occlusionRatio = (poiLight.occlusion > 0.001) ? (bentNormalSO / poiLight.occlusion) : bentNormalSO;
					reflections *= lerp(1.0, occlusionRatio, _BentNormalSpecOccStrength);
				}
				#endif
				
				reflections *= reflectionMask;
				poiLight.finalLightAdd += reflections;
				
				// Apply metallic diffuse darkening
				poiFragData.finalColor = lerp(poiFragData.finalColor, poiFragData.finalColor * mochieBRDFData.omr, mochieBRDFData.reflectionMask);
				
				// Correct specular/reflections for baseColor changes after specCol was computed
				// (e.g., effects like matcap or decals that modify baseColor post-specular)
				if (any(mochieBRDFData.specCol > 0))
				{
					float3 currentSpecCol = lerp(unity_ColorSpaceDielectricSpec.rgb, poiFragData.baseColor, mochieBRDFData.metallic);
					float3 safeSpecCol = max(mochieBRDFData.specCol, unity_ColorSpaceDielectricSpec.rgb);
					poiLight.finalLightAdd *= lerp(float3(1, 1, 1), currentSpecCol / safeSpecCol, mochieBRDFData.reflectionMask);
				}
			}
			
			#endif
			//endex
			//ifex _ClearCoatBRDF==0
			#ifdef POI_CLEARCOAT
			void poiClearCoat(inout PoiFragData poiFragData, in PoiCam poiCam, inout PoiLight poiLight, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				half clearCoatMask = _ClearCoatStrength;
				half smoothness = _ClearCoatSmoothness;
				half reflectionMask = _ClearCoatReflectionStrength;
				half specularMask = _ClearCoatSpecularStrength;
				
				#if defined(PROP_CLEARCOATMAPS) || !defined(OPTIMIZER_ENABLED)
				float4 PBRMaps = POI2D_SAMPLER_PAN_STOCHASTIC(_ClearCoatMaps, _MainTex, poiUV(poiMesh.uv[_ClearCoatMapsUV], _ClearCoatMaps_ST), _ClearCoatMapsPan, _ClearCoatMapsStochastic);
				
				if (_ClearCoatMapsClearCoatMaskChannel < 4)
				{
					clearCoatMask *= PBRMaps[min(_ClearCoatMapsClearCoatMaskChannel, 3)];
				}
				if (_ClearCoatMapsRoughnessChannel < 4)
				{
					smoothness *= PBRMaps[min(_ClearCoatMapsRoughnessChannel, 3)];
				}
				if (_ClearCoatMapsReflectionMaskChannel < 4)
				{
					reflectionMask *= PBRMaps[min(_ClearCoatMapsReflectionMaskChannel, 3)];
				}
				if (_ClearCoatMapsSpecularMaskChannel < 4)
				{
					specularMask *= PBRMaps[min(_ClearCoatMapsSpecularMaskChannel, 3)];
				}
				#endif
				
				if (_ClearCoatGlobalMask > 0)
				{
					clearCoatMask = maskBlend(clearCoatMask, poiMods.globalMask[_ClearCoatGlobalMask - 1], _ClearCoatGlobalMaskBlendType);
				}
				if (_ClearCoatSmoothnessGlobalMask > 0)
				{
					smoothness = maskBlend(smoothness, poiMods.globalMask[_ClearCoatSmoothnessGlobalMask - 1], _ClearCoatSmoothnessGlobalMaskBlendType);
				}
				if (_ClearCoatReflectionStrengthGlobalMask > 0)
				{
					reflectionMask = maskBlend(reflectionMask, poiMods.globalMask[_ClearCoatReflectionStrengthGlobalMask - 1], _ClearCoatReflectionStrengthGlobalMaskBlendType);
				}
				if (_ClearCoatSpecularStrengthGlobalMask > 0)
				{
					specularMask = maskBlend(specularMask, poiMods.globalMask[_ClearCoatSpecularStrengthGlobalMask - 1], _ClearCoatSpecularStrengthGlobalMaskBlendType);
				}
				
				if (_ClearCoatMaskInvert >= 0.5)
				{
					clearCoatMask = 1 - clearCoatMask;
				}
				if (_ClearCoatSmoothnessMapInvert >= 0.5)
				{
					smoothness = 1 - smoothness;
				}
				if (_ClearCoatReflectionMaskInvert >= 0.5)
				{
					reflectionMask = 1 - reflectionMask;
				}
				if (_ClearCoatSpecularMaskInvert >= 0.5)
				{
					specularMask = 1 - specularMask;
				}
				#ifdef TPS_Penetrator
				if (_ClearCoatTPSDepthMaskEnabled >= 0.5)
				{
					clearCoatMask = lerp(0, clearCoatMask * TPSBufferedDepth(poiMesh.localPos, poiMesh.vertexColor), _ClearCoatTPSMaskStrength);
				}
				#endif
				
				if (clearCoatMask < 0.001) return;
				
				half roughness = GetRoughness(smoothness);
				float3 specCol = 0.220916301;
				float omr = unity_ColorSpaceDielectricSpec.a;
				float percepRough = 1 - smoothness;
				UNITY_BRANCH
				if (_ClearCoatGSAAEnabled >= 0.5)
				{
					percepRough = GSAA_Filament(poiMesh.normals[_ClearCoatNormalSelect], percepRough, _ClearCoatGSAAVariance, _ClearCoatGSAAThreshold);
				}
				half brdfRoughness = percepRough * percepRough;
				brdfRoughness = max(brdfRoughness, 0.002);
				
				half3 diffuse = 0;
				half3 specular = 0;
				half3 vSpecular = 0;
				float3 reflections = 0;
				float3 environment = 0;
				half ccLightMap = poiLight.lightMap;
				half attenuation = min(poiLight.nDotLSaturated, lerp(ccLightMap, 1, _CCIgnoreCastedShadows));
				
				half3 fresnelTerm = 1;
				half3 specularTerm = 1;
				
				float clearcoatNDotL = lerp(poiLight.vertexNDotL, poiLight.nDotL, _ClearCoatNormalSelect);
				float clearcoatNDotV = lerp(poiLight.vertexNDotV, poiLight.nDotV, _ClearCoatNormalSelect);
				float clearcoatNDotH = lerp(poiLight.vertexNDotH, poiLight.nDotH, _ClearCoatNormalSelect);
				float3 clearcoatReflectionDir = lerp(poiCam.vertexReflectionDir, poiCam.reflectionDir, _ClearCoatNormalSelect);
				
				half3 ccSpecTint = poiThemeColor(poiMods, _ClearCoatSpecularTint.rgb, _ClearCoatSpecularTintThemeIndex);
				GetSpecFresTerm(clearcoatNDotL, clearcoatNDotV, clearcoatNDotH, poiLight.lDotH, specularTerm, fresnelTerm, specCol, brdfRoughness);
				specular = poiLight.directColor * specularTerm * fresnelTerm * specularMask * ccSpecTint * poiLight.occlusion * attenuation;
				if (poiFragData.toggleVertexLights)
				{
					#if defined(VERTEXLIGHT_ON)
					float3 ccVSpecBase = specularMask * ccSpecTint * poiLight.occlusion;
					for (int index = 0; index < 4; index++)
					{
						fresnelTerm = 1;
						specularTerm = 1;
						float clearcoatVDotNL = lerp(poiLight.vertexVDotNL[index], poiLight.vDotNL[index], _ClearCoatNormalSelect);
						float clearcoatVDotNH = lerp(poiLight.vertexVDotNH[index], poiLight.vDotNH[index], _ClearCoatNormalSelect);
						GetSpecFresTerm(clearcoatVDotNL, clearcoatNDotV, clearcoatVDotNH, poiLight.vDotLH[index], specularTerm, fresnelTerm, specCol, brdfRoughness);
						vSpecular += poiLight.vColor[index] * specularTerm * fresnelTerm * ccVSpecBase;
					}
					#endif
				}
				
				float surfaceReduction = (1.0 / (brdfRoughness * brdfRoughness + 1.0));
				// float grazingTerm = saturate(smoothness + (1 - omr));
				#if defined(PROP_CLEARCOATFALLBACK) || !defined(OPTIMIZER_ENABLED)
				float3 reflCol = GetReflections(poiCam, poiLight, poiMesh, percepRough, _ClearCoatForceFallback, _ClearCoatLitFallback, _ClearCoatFallback, _ClearCoatFallback_HDR, clearcoatReflectionDir);
				#else
				float3 reflCol = GetReflections(poiCam, poiLight, poiMesh, percepRough, clearcoatReflectionDir);
				#endif
				reflections = surfaceReduction * reflCol * FresnelLerp(specCol, specCol + lerp(specCol, 1, _ClearcoatFresnelStrength) * _ClearcoatFresnelStrength, clearcoatNDotV) * SFVisibility(brdfRoughness, poiLight.directColor, clearcoatNDotV, _ClearcoatExposureOcclusion);
				reflections *= poiThemeColor(poiMods, _ClearCoatReflectionTint.rgb, _ClearCoatReflectionTintThemeIndex) * reflectionMask;
				diffuse = lerp(diffuse, diffuse * omr, reflectionMask);
				
				environment = specular + vSpecular;
				if (poiLight.lightType == POI_DIRECTIONAL)
				{
					environment += reflections;
				}
				//ifex (_LightingEnableLightVolumes==0 && isNotAnimated(_LightingEnableLightVolumes)) || (_LightingLightVolumesSpecular==0 && isNotAnimated(_LightingLightVolumesSpecular))
				#if (POI_PIPE == POI_BIRP) && defined(POI_PASS_BASE)
				if (_UdonLightVolumeEnabled && _LightingEnableLightVolumes >= 0.5 && _LightingLightVolumesSpecular > 0)
				{
					environment += LightVolumeSpecularDominant(specCol, smoothness, poiMesh.normals[_ClearCoatNormalSelect], poiCam.eyeViewDir, float3(PoiSHAr.w, PoiSHAg.w, PoiSHAb.w), PoiSHAr.xyz, PoiSHAg.xyz, PoiSHAb.xyz) * specularMask * _LightingLightVolumesIntensity * _LightingLightVolumesSpecular;
				}
				#endif
				//endex
				//diffuse *= poiLight.finalLighting;
				diffuse += environment;
				poiLight.finalLightAdd += saturate(diffuse * clearCoatMask);
			}
			#endif
			//endex
			
			//ifex _StylizedSpecular==0
			#ifdef POI_STYLIZED_StylizedSpecular
			#ifdef _STYLIZEDREFLECTIONMODE_UNITYCHAN
			void CalculateUTSSpecular(inout PoiFragData poiFragData, in PoiCam poiCam, inout PoiLight poiLight, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				float3 blendedNormal = lerp(poiMesh.normals[0], poiMesh.normals[1], _StylizedSpecularNormalStrength);
				float nDotH = dot(blendedNormal, poiLight.halfDir);
				float specArea = 0.5 * nDotH + 0.5;
				#if defined(PROP_HIGHCOLOR_TEX) || !defined(OPTIMIZER_ENABLED)
				half3 specularMap = POI2D_SAMPLER_PAN(_HighColor_Tex, _MainTex, poiUV(poiMesh.uv[_HighColor_TexUV], _HighColor_Tex_ST), _HighColor_TexPan);
				#else
				half3 specularMap = 1;
				#endif
				
				float layer1Exp = exp2(lerp(11, 1, _HighColor_Power));
				float layer2Exp = exp2(lerp(11, 1, _Layer2Size));
				float layer1Thresh = 1.0 - pow(_HighColor_Power, 5);
				float layer2Thresh = 1.0 - pow(_Layer2Size, 5);
				half specMask1 = 0;
				half specMask2 = 0;
				if (_Is_SpecularToHighColor)
				{
					specMask1 += pow(specArea, layer1Exp) * _Layer1Strength;
					specMask2 += pow(specArea, layer2Exp) * _Layer2Strength;
				}
				else
				{
					specMask1 += poiEdgeNonLinear(specArea, layer1Thresh, _StylizedSpecularFeather) * _Layer1Strength;
					specMask2 += poiEdgeNonLinear(specArea, layer2Thresh, _StylizedSpecular2Feather) * _Layer2Strength;
				}
				
				#if defined(PROP_SET_HIGHCOLORMASK) || !defined(OPTIMIZER_ENABLED)
				half specularMask = POI2D_SAMPLER_PAN(_Set_HighColorMask, _MainTex, poiUV(poiMesh.uv[_Set_HighColorMaskUV], _Set_HighColorMask_ST), _Set_HighColorMaskPan)[_Set_HighColorMaskChannel];
				#else
				half specularMask = 1;
				#endif
				if (_StylizedSpecularInvertMask >= 0.5)
				{
					specularMask = 1 - specularMask;
				}
				specularMask = saturate(specularMask + _Tweak_HighColorMaskLevel);
				
				half specMask = saturate(specMask1 + specMask2) * specularMask * lerp(poiLight.rampedLightMap, 1, _StylizedSpecularIgnoreShadow);
				half specLightMap = poiLight.lightMap;
				half attenuation = min(lerp(poiLight.nDotLSaturated, 1, _StylizedSpecularIgnoreNormal), lerp(lerp(specLightMap, 1, _SSIgnoreCastedShadows), 1, _StylizedSpecularIgnoreShadow));
				
				half finalSpecMask = min(min(specMask, poiLight.occlusion), attenuation) * _StylizedSpecularStrength;
				half3 specColorBase = specularMap * poiThemeColor(poiMods, _HighColor.rgb, _HighColorThemeIndex);
				half3 finalSpecColor = specColorBase * lerp(1, poiLight.directColor, _UseLightColor);
				switch (_Is_BlendAddToHiColor)
				{
					case 0:
					{
						poiFragData.baseColor = lerp(poiFragData.baseColor, finalSpecColor, finalSpecMask);
						break;
					}
					case 1:
					{
						poiLight.finalLightAdd += max(0, finalSpecColor * finalSpecMask);
						break;
					}
					case 2:
					{
						poiFragData.baseColor = lerp(poiFragData.baseColor, blendScreen(poiFragData.baseColor, finalSpecColor), finalSpecMask);
						break;
					}
					case 3:
					{
						poiFragData.baseColor = lerp(poiFragData.baseColor, poiFragData.baseColor * finalSpecColor, finalSpecMask);
						break;
					}
				}
				
				//ifex (_LightingEnableLightVolumes==0 && isNotAnimated(_LightingEnableLightVolumes)) || (_LightingLightVolumesSpecular==0 && isNotAnimated(_LightingLightVolumesSpecular))
				#if (POI_PIPE == POI_BIRP) && defined(POI_PASS_BASE)
				if (_UdonLightVolumeEnabled && _LightingEnableLightVolumes >= 0.5 && _LightingLightVolumesSpecular > 0)
				{
					poiLight.finalLightAdd += LightVolumeSpecularDominant(specColorBase, saturate(_HighColor_Power), normalize(blendedNormal), poiCam.eyeViewDir, float3(PoiSHAr.w, PoiSHAg.w, PoiSHAb.w), PoiSHAr.xyz, PoiSHAg.xyz, PoiSHAb.xyz) * specularMask * _StylizedSpecularStrength * _LightingLightVolumesSpecular;
				}
				#endif
				//endex
				half vSpecMask = 0;
				if (poiFragData.toggleVertexLights)
				{
					#if defined(VERTEXLIGHT_ON)
					for (int index = 0; index < 4; index++)
					{
						if (!any(poiLight.vPosition[index])) continue;
						specArea = 0.5 * dot(blendedNormal, poiLight.vHalfDir[index]) + 0.5;
						if (_Is_SpecularToHighColor)
						{
							vSpecMask = pow(specArea, layer1Exp) * _Layer1Strength * poiLight.vAttenuation[index];
							vSpecMask = max(vSpecMask, pow(specArea, layer2Exp) * _Layer2Strength * poiLight.vAttenuation[index]);
						}
						else
						{
							vSpecMask = poiEdgeNonLinear(specArea, layer1Thresh, _StylizedSpecularFeather) * _Layer1Strength * poiLight.vAttenuation[index];
							vSpecMask = max(vSpecMask, poiEdgeNonLinear(specArea, layer2Thresh, _StylizedSpecular2Feather) * _Layer2Strength * poiLight.vAttenuation[index]);
						}
						
						vSpecMask *= specularMask;
						half vLightAttenuation = lerp(poiLight.vertexVDotNL[index], 1, _StylizedSpecularIgnoreNormal);
						half finalSpecMask = min(min(vSpecMask, poiLight.occlusion), vLightAttenuation) * _StylizedSpecularStrength;
						half3 vFinalSpecColor = specColorBase * lerp(1, poiLight.vColor[index], _UseLightColor);
						switch (_Is_BlendAddToHiColor)
						{
							case 0:
							{
								poiFragData.baseColor = lerp(poiFragData.baseColor, vFinalSpecColor, finalSpecMask);
								break;
							}
							case 1:
							{
								poiLight.finalLightAdd += max(0, vFinalSpecColor * finalSpecMask);
								break;
							}
							case 2:
							{
								poiFragData.baseColor = lerp(poiFragData.baseColor, blendScreen(poiFragData.baseColor, vFinalSpecColor), finalSpecMask);
								break;
							}
							case 3:
							{
								poiFragData.baseColor = lerp(poiFragData.baseColor, poiFragData.baseColor * vFinalSpecColor, finalSpecMask);
								break;
							}
						}
					}
					#endif
				}
			}
			#endif
			
			#ifdef _STYLIZEDREFLECTIONMODE_LILTOON
			void GSAA(inout float roughness, float3 N, float strength)
			{
				float3 dx = abs(ddx(N));
				float3 dy = abs(ddy(N));
				float dxy = max(dot(dx, dx), dot(dy, dy));
				half roughnessGSAA = dxy / (dxy * 5 + 0.002) * strength;
				roughness = max(roughness, roughnessGSAA);
			}
			
			float GSAAForSmoothness(float smoothness, float3 N, float strength)
			{
				half roughness = 0;
				GSAA(roughness, N, strength);
				smoothness = min(smoothness, saturate(1 - roughness));
				return smoothness;
			}
			
			float3 lilDecodeHDR(float4 data, float4 hdr)
			{
				half alpha = hdr.w * (data.a - 1.0) + 1.0;
				
				#if defined(UNITY_COLORSPACE_GAMMA)
				return (hdr.x * alpha) * data.rgb;
				#elif defined(UNITY_USE_NATIVE_HDR)
				return hdr.x * data.rgb;
				#else
				return (hdr.x * pow(abs(alpha), hdr.y)) * data.rgb;
				#endif
			}
			
			half3 lilFresnelTerm(half3 F0, half cosA)
			{
				float a = 1.0 - cosA;
				float a2 = a * a;
				return F0 + (1 - F0) * a2 * a2 * a;
			}
			
			half3 lilFresnelLerp(half3 F0, half3 F90, half cosA)
			{
				float a = 1.0 - cosA;
				float a2 = a * a;
				return lerp(F0, F90, a2 * a2 * a);
			}
			
			// lilToon tags _Metallic and _Reflectance [Gamma] and uses the raw value, letting Unity
			// convert on upload. We cannot use [Gamma] here: ShaderOptimizer bakes Float/Range
			// constants without applying the flag, so a locked material would inline the unconverted
			// value and diverge from the same material unlocked. Convert in-shader instead, matching
			// Mathf.GammaToLinearSpace exactly rather than the pow(x, 2.2) approximation.
			half lilGammaToLinear(half v)
			{
				#if defined(UNITY_COLORSPACE_GAMMA)
				return v;
				#else
				return v <= 0.04045h ? v / 12.92h : pow((v + 0.055h) / 1.055h, 2.4h);
				#endif
			}
			
			#if POI_PIPE == POI_BIRP
			Unity_GlossyEnvironmentData lilSetupGlossyEnvironmentData(float3 viewDirection, float3 normalDirection, float perceptualRoughness)
			{
				Unity_GlossyEnvironmentData glossIn;
				glossIn.roughness = perceptualRoughness;
				glossIn.reflUVW = reflect(-viewDirection, normalDirection);
				return glossIn;
			}
			
			UnityGIInput lilSetupGIInput(float3 positionWS)
			{
				UnityGIInput data;
				PoiInitStruct(UnityGIInput, data);
				data.worldPos = positionWS;
				data.probeHDR[0] = unity_SpecCube0_HDR;
				data.probeHDR[1] = unity_SpecCube1_HDR;
				#if defined(UNITY_SPECCUBE_BLENDING) || defined(UNITY_SPECCUBE_BOX_PROJECTION)
				data.boxMin[0] = unity_SpecCube0_BoxMin;
				#endif
				#ifdef UNITY_SPECCUBE_BOX_PROJECTION
				data.boxMax[0] = unity_SpecCube0_BoxMax;
				data.probePosition[0] = unity_SpecCube0_ProbePosition;
				data.boxMax[1] = unity_SpecCube1_BoxMax;
				data.boxMin[1] = unity_SpecCube1_BoxMin;
				data.probePosition[1] = unity_SpecCube1_ProbePosition;
				#endif
				return data;
			}
			
			float3 lilGetEnvReflection(float3 viewDirection, float3 normalDirection, float perceptualRoughness, float3 positionWS)
			{
				UnityGIInput data = lilSetupGIInput(positionWS);
				Unity_GlossyEnvironmentData glossIn = lilSetupGlossyEnvironmentData(viewDirection, normalDirection, perceptualRoughness);
				return UnityGI_IndirectSpecular(data, 1.0, glossIn);
			}
			#endif
			
			float3 lilCustomReflection(TextureCube tex, float4 hdr, float3 viewDirection, float3 normalDirection, float perceptualRoughness)
			{
				float mip = perceptualRoughness * (10.2 - 4.2 * perceptualRoughness);
				float3 refl = reflect(-viewDirection, normalDirection);
				return lilDecodeHDR(POI_SAMPLE_TEXCUBE_LOD(tex, sampler_linear_repeat, refl, mip), hdr);
			}
			
			float3 lilCalcSpecular(PoiMesh poiMesh, PoiCam poiCam, float3 L, float3 specular, float attenuation, float roughness, float3 N, float nv)
			{
				float3 H = normalize(poiCam.eyeViewDir + L);
				float nh = saturate(dot(N, H));
				
				if (_SpecularToon)
				{
					return poiEdgeLinear(pow(nh, 1.0 / max(roughness, 0.0001)), _SpecularBorder, _SpecularBlur);
				}
				
				float nl = saturate(dot(N, L));
				float lh = saturate(dot(L, H));
				
				float ggx, sjggx = 0.0;
				float lambdaV = 0.0;
				float lambdaL = 0.0;
				float d = 1.0;
				#if defined(LIL_FEATURE_ANISOTROPY)
				if (isAnisotropy)
				{
					half roughnessT = max(roughness * (1.0 + fd.anisotropy), 0.002);
					half roughnessB = max(roughness * (1.0 - fd.anisotropy), 0.002);
					
					float tv = dot(fd.T, fd.V);
					float bv = dot(fd.B, fd.V);
					float tl = dot(fd.T, L);
					float bl = dot(fd.B, L);
					
					lambdaV = nl * length(float3(roughnessT * tv, roughnessB * bv, nv));
					lambdaL = nv * length(float3(roughnessT * tl, roughnessB * bl, nl));
					
					half roughnessT1 = roughnessT * _AnisotropyTangentWidth;
					half roughnessB1 = roughnessB * _AnisotropyBitangentWidth;
					half roughnessT2 = roughnessT * _Anisotropy2ndTangentWidth;
					half roughnessB2 = roughnessB * _Anisotropy2ndBitangentWidth;
					
					float anisotropyShiftNoise = 0.5;
					#if defined(LIL_FEATURE_AnisotropyShiftNoiseMask)
					anisotropyShiftNoise = POI2D_SAMPLER(_AnisotropyShiftNoiseMask, _linear_repeat, fd.uvMain).r - 0.5;
					#endif
					float anisotropyShift = anisotropyShiftNoise * _AnisotropyShiftNoiseScale + _AnisotropyShift;
					float anisotropy2ndShift = anisotropyShiftNoise * _Anisotropy2ndShiftNoiseScale + _Anisotropy2ndShift;
					float3 T1 = normalize(fd.T - N * anisotropyShift);
					float3 B1 = normalize(fd.B - N * anisotropyShift);
					float3 T2 = normalize(fd.T - N * anisotropy2ndShift);
					float3 B2 = normalize(fd.B - N * anisotropy2ndShift);
					
					float th1 = dot(T1, H);
					float bh1 = dot(B1, H);
					float th2 = dot(T2, H);
					float bh2 = dot(B2, H);
					
					float r1 = roughnessT1 * roughnessB1;
					float r2 = roughnessT2 * roughnessB2;
					float3 v1 = float3(th1 * roughnessB1, bh1 * roughnessT1, nh * r1);
					float3 v2 = float3(th2 * roughnessB2, bh2 * roughnessT2, nh * r2);
					float w1 = r1 / dot(v1, v1);
					float w2 = r2 / dot(v2, v2);
					ggx = r1 * w1 * w1 * _AnisotropySpecularStrength + r2 * w2 * w2 * _Anisotropy2ndSpecularStrength;
				}
				else
				#endif
				{
					half roughness2 = max(roughness, 0.002);
					lambdaV = nl * (nv * (1.0 - roughness2) + roughness2);
					lambdaL = nv * (nl * (1.0 - roughness2) + roughness2);
					
					float r2 = roughness2 * roughness2;
					d = (nh * r2 - nh) * nh + 1.0;
					ggx = r2 / (d * d + 1e-7f);
				}
				
				#if defined(SHADER_API_MOBILE) || defined(SHADER_API_SWITCH)
				sjggx = 0.5 / (lambdaV + lambdaL + 1e-4f);
				#else
				sjggx = 0.5 / (lambdaV + lambdaL + 1e-5f);
				#endif
				
				half specularTerm = sjggx * ggx;
				#ifdef LIL_COLORSPACE_GAMMA
				specularTerm = sqrt(max(1e-4h, specularTerm));
				#endif
				specularTerm *= nl * attenuation;
				
				#if defined(LIL_FEATURE_ANISOTROPY)
				if (_SpecularToon) return poiEdgeLinear(specularTerm, 0.5);
				#endif
				return specularTerm * lilFresnelTerm(specular, lh);
			}
			
			void lilReflection(inout PoiFragData poiFragData, PoiCam poiCam, PoiLight poiLight, PoiMesh poiMesh, PoiMods poiMods)
			{
				half perceptualRoughness = 1.0;
				half roughness = 1.0;
				half smoothness = 1.0;
				
				smoothness = _Smoothness;
				#if defined(PROP_SMOOTHNESSTEX) || !defined(OPTIMIZER_ENABLED)
				smoothness *= POI2D_SAMPLER_PAN(_SmoothnessTex, _linear_repeat, poiUV(poiMesh.uv[_SmoothnessTexUV], _SmoothnessTex_ST), _SmoothnessTexPan).r;
				#endif
				smoothness = GSAAForSmoothness(smoothness, poiMesh.normals[1], _GSAAStrength);
				perceptualRoughness *= (1.0 - smoothness);
				roughness = perceptualRoughness * perceptualRoughness;
				
				half metallic = lilGammaToLinear(_Metallic);
				#if defined(PROP_METALLICGLOSSMAP) || !defined(OPTIMIZER_ENABLED)
				metallic *= POI2D_SAMPLER_PAN(_MetallicGlossMap, _linear_repeat, poiUV(poiMesh.uv[_MetallicGlossMapUV], _MetallicGlossMap_ST), _MetallicGlossMapPan).r;
				#endif
				half3 specular = lerp(lilGammaToLinear(_Reflectance), poiFragData.baseColor, metallic);
				
				half3 specularN = lerp(poiMesh.normals[0], poiMesh.normals[1], _SpecularNormalStrength);
				half specularNV = saturate(dot(specularN, poiCam.eyeViewDir));
				
				half4 reflectionColor = _ReflectionColor;
				#if defined(PROP_REFLECTIONCOLORTEX) || !defined(OPTIMIZER_ENABLED)
				reflectionColor *= POI2D_SAMPLER_PAN(_ReflectionColorTex, _linear_repeat, poiUV(poiMesh.uv[_ReflectionColorTexUV], _ReflectionColorTex_ST), _ReflectionColorTexPan);
				#endif
				if (_ReflectionApplyTransparency >= 0.5) reflectionColor.a *= poiFragData.alpha;
				
				#if POI_PIPE == POI_BIRP
				#if defined(POI_PASS_ADD)
				if (_UseReflection >= 0.5 && _ApplySpecular >= 0.5 && _ApplySpecularFA >= 0.5)
				#else
				if (_UseReflection >= 0.5)
				#endif
				#else
				bool skipBlock = true;
				if (poiLight.isAdditive && (_UseReflection >= 0.5 && _ApplySpecular >= 0.5 && _ApplySpecularFA >= 0.5))
				skipBlock = false;
				if (!poiLight.isAdditive && _UseReflection >= 0.5)
				skipBlock = false;
				if (!skipBlock)
				#endif
				{
					float3 reflectCol = 0;
					
					// lilToon subtracts this once per pass, unconditionally (lil_common_frag.hlsl).
					// The old `lightType == POI_DIRECTIONAL` gate was meant to read "base pass only",
					// but lightType is POI_POINT_SPOT only for point/spot ForwardAdd lights. A fully
					// metallic surface therefore kept its whole albedo in the add pass and popped it
					// back over the colored-out base pass, re-picked by Unity every frame.
					#if POI_PIPE == POI_BIRP
					poiFragData.baseColor = poiFragData.baseColor - metallic * poiFragData.baseColor;
					#else
					// URP calls this function once per light, so guard against compounding.
					if (!poiLight.isAdditive)
					{
						poiFragData.baseColor = poiFragData.baseColor - metallic * poiFragData.baseColor;
					}
					#endif
					
					// Specular
					#if POI_PIPE == POI_BIRP
					#if !defined(POI_PASS_ADD)
					if (_ApplySpecular >= 0.5)
					#endif
					#else
					if (poiLight.isAdditive || _ApplySpecular >= 0.5)
					#endif
					{
						float3 lightDirectionSpc = poiLight.direction;
						half3 lightColorSpc = poiLight.directColor;
						
						#if defined(POI_PASS_ADD)
						reflectCol = lilCalcSpecular(poiMesh, poiCam, lightDirectionSpc, specular, poiLight.lightMapNoAttenuation, roughness, specularN, specularNV);
						#elif defined(SHADOWS_SCREEN)
						reflectCol = lilCalcSpecular(poiMesh, poiCam, lightDirectionSpc, specular, poiLight.rampedLightMap, roughness, specularN, specularNV);
						#else
						reflectCol = lilCalcSpecular(poiMesh, poiCam, lightDirectionSpc, specular, 1.0, roughness, specularN, specularNV);
						#endif
						poiFragData.baseColor = lilBlendColor(poiFragData.baseColor, reflectionColor.rgb * lightColorSpc, reflectCol * reflectionColor.a, _ReflectionBlendMode);
					}
					
					// Reflection
					// lilToon strips this block from ForwardAdd entirely, it does not just drop the
					// condition there (lil_common_frag.hlsl: #if !defined(LIL_PASS_FORWARDADD)).
					#if !defined(POI_PASS_ADD)
					#if POI_PIPE == POI_BIRP
					if (_ApplyReflection >= 0.5)
					#else
					if (!poiLight.isAdditive && _ApplyReflection >= 0.5)
					#endif
					{
						float3 N = lerp(poiMesh.normals[0], poiMesh.normals[1], _ReflectionNormalStrength);
						
						#if POI_PIPE == POI_BIRP
						// lilToon: IsEmpty(unity_SpecCube0) || unity_SpecCube0_HDR.x == 0.
						// IsEmpty rejects anything narrower than 15px, catching Unity's placeholder
						// probes, where SceneHasReflections() only rejects 1x1. The HDR term catches
						// a probe bound at full size whose decode multiplier is 0, which renders
						// pure color and is per-frame state, so it flickers.
						float probeWidth, probeHeight;
						unity_SpecCube0.GetDimensions(probeWidth, probeHeight);
						bool probeIsUsable = probeWidth >= 15 && unity_SpecCube0_HDR.x != 0;
						#else
						bool probeIsUsable = SceneHasReflections();
						#endif
						
						half3 envReflectionColor = 0;
						if (!probeIsUsable || _ReflectionCubeOverride >= 0.5)
						{
							#if defined(PROP_REFLECTIONCUBETEX) || !defined(OPTIMIZER_ENABLED)
							envReflectionColor = lilCustomReflection(_ReflectionCubeTex, _ReflectionCubeTex_HDR, poiCam.eyeViewDir, N, perceptualRoughness);
							#else
							envReflectionColor = float4(0, 0, 0, 1);
							#endif
							envReflectionColor *= _ReflectionCubeColor.rgb * lerp(1.0, poiLight.directColor, _ReflectionCubeEnableLighting);
						}
						#if POI_PIPE == POI_BIRP
						else
						{
							envReflectionColor = lilGetEnvReflection(poiCam.eyeViewDir, N, perceptualRoughness, poiMesh.worldPos);
						}
						#elif POI_PIPE == POI_URP
						else
						{
							float3 reflectionDir = reflect(-poiCam.eyeViewDir, N);
							envReflectionColor = PoiGlossyEnvironmentReflection(reflectionDir, poiMesh.worldPos.xyz, perceptualRoughness, 1, poiCam.screenUV);
						}
						#endif
						
						float oneMinusReflectivity = DielectricSpec.a - metallic * DielectricSpec.a;
						float grazingTerm = saturate(smoothness + (1.0 - oneMinusReflectivity));
						#if defined(UNITY_COLORSPACE_GAMMA)
						float surfaceReduction = 1.0 - 0.28 * roughness * perceptualRoughness;
						#else
						float surfaceReduction = 1.0 / (roughness * roughness + 1.0);
						#endif
						
						reflectCol = surfaceReduction * envReflectionColor * lilFresnelLerp(specular, grazingTerm, poiLight.nDotV);
						poiFragData.baseColor = lilBlendColor(poiFragData.baseColor, reflectionColor.rgb, reflectCol * reflectionColor.a, _ReflectionBlendMode);
					}
					#endif
				}
				
				//ifex (_LightingEnableLightVolumes==0 && isNotAnimated(_LightingEnableLightVolumes)) || (_LightingLightVolumesSpecular==0 && isNotAnimated(_LightingLightVolumesSpecular))
				#if (POI_PIPE == POI_BIRP) && defined(POI_PASS_BASE)
				if (_UdonLightVolumeEnabled && _LightingEnableLightVolumes >= 0.5 && _LightingLightVolumesSpecular > 0)
				{
					poiFragData.baseColor += LightVolumeSpecularDominant(specular, smoothness, normalize(specularN), poiCam.eyeViewDir, float3(PoiSHAr.w, PoiSHAg.w, PoiSHAb.w), PoiSHAr.xyz, PoiSHAg.xyz, PoiSHAb.xyz) * reflectionColor.rgb * reflectionColor.a * _LightingLightVolumesSpecular;
				}
				#endif
				//endex
				
				// Vertex light specular
				#if defined(VERTEXLIGHT_ON)
				if (poiFragData.toggleVertexLights && _UseReflection >= 0.5 && _ApplySpecular >= 0.5 && _ApplySpecularFA >= 0.5)
				{
					[unroll]
					for (int vIdx = 0; vIdx < 4; vIdx++)
					{
						if (!any(poiLight.vPosition[vIdx])) continue;
						float3 vReflectCol = lilCalcSpecular(poiMesh, poiCam, poiLight.vDirection[vIdx], specular, poiLight.vAttenuation[vIdx], roughness, specularN, specularNV);
						poiFragData.baseColor = lilBlendColor(poiFragData.baseColor, reflectionColor.rgb * poiLight.vColor[vIdx], vReflectCol * reflectionColor.a, _ReflectionBlendMode);
					}
				}
				#endif
			}
			#endif
			#endif
			//endex
			
			//ifex _EnablePathing==0
			#ifdef POI_PATHING
			void applyPathing(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				// Sample path source: texture-based gradient or UV-derived
				half4 pathSourceOrMask = float4(1, 1, 1, 1);
				#if defined(PROP_PATHINGMAP) || !defined(OPTIMIZER_ENABLED)
				if (_PathPointSampling >= 0.5)
				{
					pathSourceOrMask = POI2D_SAMPLER_PAN(_PathingMap, _point_repeat, poiUV(poiMesh.uv[_PathingMapUV], _PathingMap_ST), _PathingMapPan);
				}
				else
				{
					pathSourceOrMask = POI2D_SAMPLER_PAN(_PathingMap, _linear_repeat, poiUV(poiMesh.uv[_PathingMapUV], _PathingMap_ST), _PathingMapPan);
				}
				#endif
				
				// Determine path values based on source type
				float4 path;
				if (_PathSource == 0)
				{
					path = pathSourceOrMask;
				}
				else
				{
					float2 uv = poiMesh.uv[_PathingUVSelect];
					float4 dirs = float4(_PathSourceDirR, _PathSourceDirG, _PathSourceDirB, _PathSourceDirA);
					path = lerp(uv.xxxx, uv.yyyy, dirs);
				}
				
				// Merge channels if selected for texture source
				if (_PathSource == 0 && _PathGradientType == 1)
				{
					path = dot(path, 0.25);
				}
				
				// Apply remapping if enabled: mask outside range and normalize inside
				half4 pathRemapMask = 1.0; // Default to full effect
				if (_EnablePathRemapping >= 0.5)
				{
					float4 remapStarts = float4(_PathRemapR.x, _PathRemapG.x, _PathRemapB.x, _PathRemapA.x);
					float4 remapEnds = float4(_PathRemapR.y, _PathRemapG.y, _PathRemapB.y, _PathRemapA.y);
					
					// Mask: 1 only within remap range
					pathRemapMask.r = step(remapStarts.r, path.r) * (1.0 - step(remapEnds.r, path.r));
					pathRemapMask.g = step(remapStarts.g, path.g) * (1.0 - step(remapEnds.g, path.g));
					pathRemapMask.b = step(remapStarts.b, path.b) * (1.0 - step(remapEnds.b, path.b));
					pathRemapMask.a = step(remapStarts.a, path.a) * (1.0 - step(remapEnds.a, path.a));
					
					// Remap values within range to 0-1
					path = saturate((path - remapStarts) / (remapEnds - remapStarts + 1e-6));
				}
				
				// Sample color map for additional tinting/masking
				#if defined(PROP_PATHINGCOLORMAP) || !defined(OPTIMIZER_ENABLED)
				half4 pathColorMap = POI2D_SAMPLER_PAN(_PathingColorMap, _MainTex, poiUV(poiMesh.uv[_PathingColorMapUV], _PathingColorMap_ST), _PathingColorMapPan);
				#else
				half4 pathColorMap = float4(1, 1, 1, 1);
				#endif
				
				// Array of per-channel colors (RGBA includes alpha for opacity control)
				half4 PathColor[4] = {
					_PathColorR, _PathColorG, _PathColorB, _PathColorA
				};
				float4 pathTypes = float4(_PathTypeR, _PathTypeG, _PathTypeB, _PathTypeA);
				// Per-channel global mask selection + blend mode, applied to each channel's color contribution
				half pathGlobalMaskIndices[4] = {
					_PathGlobalMaskR, _PathGlobalMaskG, _PathGlobalMaskB, _PathGlobalMaskA
				};
				half pathGlobalMaskBlends[4] = {
					_PathGlobalMaskRBlendType, _PathGlobalMaskGBlendType, _PathGlobalMaskBBlendType, _PathGlobalMaskABlendType
				};
				half4 finalPathAlpha = 0;
				half4 pathAudioLinkEmissionAdd = 0;
				
				#ifdef POI_AUDIOLINK
				float4 alTimeOffsets = 0;
				float4 alWidthOffsets = 0;
				if (poiMods.audioLinkAvailable)
				{
					if (_PathALTimeOffset >= 0.5)
					{
						float4 alTimeOffsetMins = float4(_AudioLinkPathTimeOffsetR.x, _AudioLinkPathTimeOffsetG.x, _AudioLinkPathTimeOffsetB.x, _AudioLinkPathTimeOffsetA.x);
						float4 alTimeOffsetMaxs = float4(_AudioLinkPathTimeOffsetR.y, _AudioLinkPathTimeOffsetG.y, _AudioLinkPathTimeOffsetB.y, _AudioLinkPathTimeOffsetA.y);
						float4 timeAudioValues;
						timeAudioValues.x = poiMods.audioLink[(int)_AudioLinkPathTimeOffsetBandR];
						timeAudioValues.y = poiMods.audioLink[(int)_AudioLinkPathTimeOffsetBandG];
						timeAudioValues.z = poiMods.audioLink[(int)_AudioLinkPathTimeOffsetBandB];
						timeAudioValues.w = poiMods.audioLink[(int)_AudioLinkPathTimeOffsetBandA];
						alTimeOffsets = lerp(alTimeOffsetMins, alTimeOffsetMaxs, timeAudioValues);
					}
					
					if (_PathALChrono >= 0.5)
					{
						alTimeOffsets.x += AudioLinkGetChronoTime(_PathChronoTypeR, _PathChronoBandR) * _PathChronoSpeedR;
						alTimeOffsets.y += AudioLinkGetChronoTime(_PathChronoTypeG, _PathChronoBandG) * _PathChronoSpeedG;
						alTimeOffsets.z += AudioLinkGetChronoTime(_PathChronoTypeB, _PathChronoBandB) * _PathChronoSpeedB;
						alTimeOffsets.w += AudioLinkGetChronoTime(_PathChronoTypeA, _PathChronoBandA) * _PathChronoSpeedA;
					}
					
					if (_PathALWidthOffset >= 0.5)
					{
						float4 alWidthOffsetMins = float4(_AudioLinkPathWidthOffsetR.x, _AudioLinkPathWidthOffsetG.x, _AudioLinkPathWidthOffsetB.x, _AudioLinkPathWidthOffsetA.x);
						float4 alWidthOffsetMaxs = float4(_AudioLinkPathWidthOffsetR.y, _AudioLinkPathWidthOffsetG.y, _AudioLinkPathWidthOffsetB.y, _AudioLinkPathWidthOffsetA.y);
						float4 widthAudioValues;
						widthAudioValues.x = poiMods.audioLink[(int)_AudioLinkPathWidthOffsetBandR];
						widthAudioValues.y = poiMods.audioLink[(int)_AudioLinkPathWidthOffsetBandG];
						widthAudioValues.z = poiMods.audioLink[(int)_AudioLinkPathWidthOffsetBandB];
						widthAudioValues.w = poiMods.audioLink[(int)_AudioLinkPathWidthOffsetBandA];
						alWidthOffsets = lerp(alWidthOffsetMins, alWidthOffsetMaxs, widthAudioValues);
					}
					
					if (_PathALEmissionOffset >= 0.5)
					{
						half4 alEmissionMins = float4(_AudioLinkPathEmissionAddR.x, _AudioLinkPathEmissionAddG.x, _AudioLinkPathEmissionAddB.x, _AudioLinkPathEmissionAddA.x);
						half4 alEmissionMaxs = float4(_AudioLinkPathEmissionAddR.y, _AudioLinkPathEmissionAddG.y, _AudioLinkPathEmissionAddB.y, _AudioLinkPathEmissionAddA.y);
						half4 emissionAudioValues;
						emissionAudioValues.x = poiMods.audioLink[(int)_AudioLinkPathEmissionAddBandR];
						emissionAudioValues.y = poiMods.audioLink[(int)_AudioLinkPathEmissionAddBandG];
						emissionAudioValues.z = poiMods.audioLink[(int)_AudioLinkPathEmissionAddBandB];
						emissionAudioValues.w = poiMods.audioLink[(int)_AudioLinkPathEmissionAddBandA];
						pathAudioLinkEmissionAdd = lerp(alEmissionMins, alEmissionMaxs, emissionAudioValues);
					}
					
					if (_PathALColorChord >= 0.5)
					{
						if (_PathALCCR >= 0.5) PathColor[0] *= AudioLinkLerp(ALPASS_CCSTRIP + float2(path.r * AUDIOLINK_WIDTH, 0));
						if (_PathALCCG >= 0.5) PathColor[1] *= AudioLinkLerp(ALPASS_CCSTRIP + float2(path.g * AUDIOLINK_WIDTH, 0));
						if (_PathALCCB >= 0.5) PathColor[2] *= AudioLinkLerp(ALPASS_CCSTRIP + float2(path.b * AUDIOLINK_WIDTH, 0));
						if (_PathALCCA >= 0.5) PathColor[3] *= AudioLinkLerp(ALPASS_CCSTRIP + float2(path.a * AUDIOLINK_WIDTH, 0));
					}
				}
				#endif
				
				[unroll]
				for (int i = 0; i < 4; i++)
				{
					// Calculate time with potential AudioLink offsets
					#ifdef POI_AUDIOLINK
					float timeOffset = _PathALTimeOffset || _PathALChrono >= 0.5 ? alTimeOffsets[i] : 0;
					#else
					float timeOffset = 0;
					#endif
					float currentTime = frac((_PathTime[i] == -999.0f ? POI_TIME.y * _PathSpeed[i] : _PathTime[i]) + _PathOffset[i] + timeOffset);
					
					// Segment time if enabled
					float pathSegments = abs(_PathSegments[i]);
					if (pathSegments > 0)
					{
						currentTime = (ceil(currentTime * pathSegments) - 0.5) * rcp(pathSegments);
					}
					
					// Compute path width with potential AudioLink adjustment
					#ifdef POI_AUDIOLINK
					half pathWidth = _PathWidth[i] * 0.5 + (_PathALWidthOffset >= 0.5 ? alWidthOffsets[i] : 0);
					#else
					half pathWidth = _PathWidth[i] * 0.5;
					#endif
					half rcpPathWidth = rcp(pathWidth + 1e-6);
					half softness = max(_PathSoftness[i], 0);
					
					// Compute alpha for Fill type
					half fillAlpha;
					if (softness > 1e-5)
					{
						float totalAnimationLength = 1 + softness;
						float timeAlongPath = currentTime * totalAnimationLength;
						fillAlpha = smoothstep(timeAlongPath, timeAlongPath - softness, path[i]);
					}
					else
					{
						fillAlpha = step(path[i], currentTime);
					}
					
					// Compute alpha for Path and Loop types
					half pathAlpha = saturate(1.0 - abs(lerp(-pathWidth, 1.0 + pathWidth, currentTime) - path[i]) * rcpPathWidth);
					half loopAlpha = saturate(1.0 - min(abs(currentTime - path[i]), 1.0 - abs(currentTime - path[i])) * rcpPathWidth);
					
					// Compute alpha for Dashed type
					half dashAlpha = 0;
					float totalDashLength = _PathWidth[i] + _PathGapLengths[i];
					if (totalDashLength > 1e-6)
					{
						float relativeDashLength = _PathWidth[i] / totalDashLength;
						float dashPattern = frac(path[i] / totalDashLength - currentTime);
						
						float dashSoftness = softness * 0.5 * relativeDashLength;
						dashSoftness = min(dashSoftness, relativeDashLength * 0.499);
						
						float rise = smoothstep(0, dashSoftness, dashPattern);
						float fall = smoothstep(relativeDashLength, relativeDashLength - dashSoftness, dashPattern);
						dashAlpha = rise * fall;
					}
					
					// Select alpha based on path type
					half currentAlpha = 0;
					if (pathTypes[i] == 0)      currentAlpha = fillAlpha;
					else if (pathTypes[i] == 1) currentAlpha = pathAlpha;
					else if (pathTypes[i] == 2) currentAlpha = loopAlpha;
					else if (pathTypes[i] == 3) currentAlpha = dashAlpha;
					
					// Apply remap mask
					currentAlpha *= pathRemapMask[i];
					
					// Avoid zero-path artifacts
					currentAlpha *= step(1e-6, path[i]);
					
					#ifdef POI_AUDIOLINK
					if (poiMods.audioLinkAvailable)
					{
						if (_PathALHistory >= 0.5)
						{
							float4 historyToggles = float4(_PathALHistoryR, _PathALHistoryG, _PathALHistoryB, _PathALHistoryA);
							if (historyToggles[i] > 0)
							{
								float historyBands[4] = {
									_PathALHistoryBandR, _PathALHistoryBandG, _PathALHistoryBandB, _PathALHistoryBandA
								};
								float2 historyRanges[4] = {
									_PathALHistoryRangeR.xy, _PathALHistoryRangeG.xy, _PathALHistoryRangeB.xy, _PathALHistoryRangeA.xy
								};
								
								float historyUV = lerp(historyRanges[i].x, historyRanges[i].y, path[i]);
								if (pathSegments > 0)
								{
									historyUV = (ceil(historyUV * pathSegments) - 0.5) * rcp(pathSegments);
								}
								
								float historyValue = AudioLinkLerp(ALPASS_AUDIOLINK + float2(historyUV * AUDIOLINK_WIDTH, historyBands[i]))[0];
								currentAlpha = lerp(currentAlpha * historyValue, historyValue, _PathALHistoryMode);
							}
						}
						
						if (_PathALAutoCorrelator >= 0.5)
						{
							float acTypes[4] = {
								_PathALAutoCorrelatorR, _PathALAutoCorrelatorG, _PathALAutoCorrelatorB, _PathALAutoCorrelatorA
							};
							if (acTypes[i] > 0 && path[i] > 0)
							{
								float2 acRanges[4] = {
									_PathALAutoCorrelatorRangeR.xy, _PathALAutoCorrelatorRangeG.xy, _PathALAutoCorrelatorRangeB.xy, _PathALAutoCorrelatorRangeA.xy
								};
								float acUV = lerp(acRanges[i].x, acRanges[i].y, path[i]);
								if (acTypes[i] == 2) acUV = abs(1.0 - acUV * 2.0);
								if (pathSegments > 0)
								{
									acUV = (ceil(acUV * pathSegments) - 0.5) * rcp(pathSegments);
								}
								float acValue = AudioLinkLerp(ALPASS_AUTOCORRELATOR + float2(acUV * AUDIOLINK_WIDTH, 0))[0];
								//acValue = saturate(abs(acValue) * rcp(AudioLinkLerp(ALPASS_AUTOCORRELATOR)));  // Optional: Uncomment if you want this normalization
								//acValue *= smoothstep(0.01, 0.2, AudioLinkData(ALPASS_FILTEREDVU_INTENSITY + uint2(0, 0)));  // Optional: Uncomment for VU intensity gating
								currentAlpha = lerp(currentAlpha * acValue, acValue, _PathALAutoCorrelatorMode);
							}
						}
					}
					#endif
					
					// Adjust alpha for Dash/Fill types vs. others
					if (pathTypes[i] == 3 || pathTypes[i] == 0)
					{
						finalPathAlpha[i] = currentAlpha;
					}
					else
					{
						finalPathAlpha[i] = smoothstep(0, softness + 1e-6, currentAlpha);
					}
					
					if (path[i] <= 0)
					{
						finalPathAlpha[i] = 0;
					}
					
					// Apply this channel's global mask to its color/alpha contribution
					finalPathAlpha[i] = globalMaskBlend(finalPathAlpha[i], pathGlobalMaskIndices[i], pathGlobalMaskBlends[i], poiMods);
				}
				
				// Multiply by source mask if UV-based
				if (_PathSource == 1)
				{
					finalPathAlpha *= pathSourceOrMask;
				}
				
				// Compute emission (ignores color alpha)
				half3 pathEmission = 0;
				pathEmission += finalPathAlpha.r * poiThemeColor(poiMods, PathColor[0].rgb, _PathColorRThemeIndex) * (_PathEmissionStrength.r + pathAudioLinkEmissionAdd.r);
				pathEmission += finalPathAlpha.g * poiThemeColor(poiMods, PathColor[1].rgb, _PathColorGThemeIndex) * (_PathEmissionStrength.g + pathAudioLinkEmissionAdd.g);
				pathEmission += finalPathAlpha.b * poiThemeColor(poiMods, PathColor[2].rgb, _PathColorBThemeIndex) * (_PathEmissionStrength.b + pathAudioLinkEmissionAdd.b);
				pathEmission += finalPathAlpha.a * poiThemeColor(poiMods, PathColor[3].rgb, _PathColorAThemeIndex) * (_PathEmissionStrength.a + pathAudioLinkEmissionAdd.a);
				
				half3 albedo = poiFragData.baseColor;
				half3 finalPathColor = 0;
				half finalAlpha = 0;
				
				// Apply themed color and scale opacity alphas by color alpha (affects color contribution and blending, but not emission)
				half3 colorR = poiThemeColor(poiMods, PathColor[0].rgb, _PathColorRThemeIndex);
				half alphaR = finalPathAlpha.r * PathColor[0].a;
				finalPathColor = colorR * alphaR;
				finalAlpha = alphaR;
				
				half3 colorG = poiThemeColor(poiMods, PathColor[1].rgb, _PathColorGThemeIndex);
				half alphaG = finalPathAlpha.g * PathColor[1].a;
				finalPathColor = (colorG * alphaG) + finalPathColor * (1.0 - alphaG);
				finalAlpha = alphaG + finalAlpha * (1.0 - alphaG);
				
				half3 colorB = poiThemeColor(poiMods, PathColor[2].rgb, _PathColorBThemeIndex);
				half alphaB = finalPathAlpha.b * PathColor[2].a;
				finalPathColor = (colorB * alphaB) + finalPathColor * (1.0 - alphaB);
				finalAlpha = alphaB + finalAlpha * (1.0 - alphaB);
				
				half3 colorA = poiThemeColor(poiMods, PathColor[3].rgb, _PathColorAThemeIndex);
				half alphaA = finalPathAlpha.a * PathColor[3].a;
				finalPathColor = (colorA * alphaA) + finalPathColor * (1.0 - alphaA);
				finalAlpha = alphaA + finalAlpha * (1.0 - alphaA);
				
				// Apply color map to final color and alpha
				finalPathColor *= pathColorMap.rgb;
				finalAlpha *= pathColorMap.a;
				finalPathColor *= pathColorMap.a;
				pathEmission *= pathColorMap.rgb * pathColorMap.a;
				
				// Blend path color onto base albedo based on mode
				if (_PathSurfaceBlendMode == 0)
				{
					albedo = albedo * (1.0 - finalAlpha) + finalPathColor;
				}
				else if (_PathSurfaceBlendMode == 1)
				{
					albedo += finalPathColor;
				}
				else
				{
					albedo *= (finalPathColor + (1.0 - finalAlpha));
				}
				
				// Override alpha if enabled
				poiFragData.alpha = lerp(poiFragData.alpha, finalAlpha, _PathingOverrideAlpha);
				poiFragData.baseColor = albedo;
				poiFragData.emission += pathEmission;
			}
			#endif
			//endex
			
