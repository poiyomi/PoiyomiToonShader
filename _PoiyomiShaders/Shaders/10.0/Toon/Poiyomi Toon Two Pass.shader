			//ifex _EnableOutlines!=1
			#ifdef POI_PASS_OUTLINE
			// Shared by the outline body and the highlight so both stay in step under Color Adjust
			half3 poiOutlineColorAdjust(half3 color)
			{
				float hue = frac(_OutlineHue + _OutlineHueOffsetSpeed * POI_TIME.x);
				color = hueShift(color, hue, _OutlineHueShiftColorSpace, 1.0);
				[flatten]
				switch ((int)_OutlineSaturationMethod)
				{
					// Saturation/Value (old)
					case 0:
					{
						color = ModifyViaHSV(color, 0.0, _OutlineSaturation, _OutlineValue);
						break;
					}
					// Saturation/Brightness (new)
					case 1:
					{
						color = lerp(color, dot(color, float3(0.3, 0.59, 0.11)), -_OutlineSaturation);
						color = saturate(color * (_OutlineBrightness + 1));
						break;
					}
				}
				return pow(abs(color), _OutlineGamma);
			}
			void applyOutlineColor(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiLight poiLight, in PoiMods poiMods, in PoiCam poiCam)
			{
				clip(_EnableOutlines - 0.01);
				#if defined(PROP_OUTLINEMASK) || !defined(OPTIMIZER_ENABLED)
				half OutlineMask = UNITY_SAMPLE_TEX2D_SAMPLER(_OutlineMask, _linear_repeat, TRANSFORM_TEX(poiMesh.uv[_OutlineMaskUV], _OutlineMask) + POI_TIME.x * _OutlineMaskPan)[_OutlineMaskChannel];
				#else
				half OutlineMask = 1;
				#endif
				if (_OutlineVertexColorMask > 0)
				{
					OutlineMask *= lerp(1, poiMesh.vertexColor[_OutlineVertexColorMask - 1], _OutlineVertexColorMaskStrength);
				}
				if (_OutlineClipAtZeroWidth >= 0.5)
				{
					float lineWidth = _LineWidth;
					#ifdef POI_AUDIOLINK
					//UNITY_BRANCH
					if (poiMods.audioLinkAvailable)
					{
						lineWidth += lerp(_AudioLinkOutlineSize.x, _AudioLinkOutlineSize.y, poiMods.audioLink[_AudioLinkOutlineSizeBand]);
					}
					#endif
					clip(OutlineMask * lineWidth - 0.001);
				}
				#if defined(PROP_OUTLINETEXTURE) || !defined(OPTIMIZER_ENABLED)
				float4 col = POI2D_SAMPLER_PAN(_OutlineTexture, _MainTex, poiUV(poiMesh.uv[_OutlineTextureUV], _OutlineTexture_ST), _OutlineTexturePan);
				#else
				float4 col = float4(1, 1, 1, 1);
				#endif
				poiFragData.baseColor = lerp(col.rgb, col.rgb * poiFragData.baseColor * lerp(1, poiFragData.baseColor, _PoiUTSStyleOutlineBlend), _OutlineTintMix);
				half4 outlineColor = _LineColor;
				#ifdef POI_AUDIOLINK
				if (_OutlineALColorEnabled >= 0.5 && poiMods.audioLinkAvailable)
				{
					half alColorOverrideIntensity = poiMods.audioLink[_AudioLinkOutlineColorBand];
					half alColorOverrideBlend = evalRamp4(alColorOverrideIntensity, _AudioLinkOutlineColorRamp);
					if(alColorOverrideBlend > 0)
					{
						half3 alOverrideColor = _AudioLinkOutlineColor.rgb;
						if(_AudioLinkOutlineColorThemeIndex > 0)
						{
							alOverrideColor = poiThemeColor(poiMods, alOverrideColor, _AudioLinkOutlineColorThemeIndex);
						}
						outlineColor.rgb = lerp(outlineColor.rgb, alOverrideColor, alColorOverrideBlend);
					}
				}
				#endif
				
				// Untinted outline color, used as the optional tint source for the highlight below
				half3 outlineHighlightTint = poiFragData.baseColor;
				
				poiFragData.baseColor *= poiThemeColor(poiMods, outlineColor.rgb, _LineColorThemeIndex);
				col.a *= outlineColor.a;
				if (_OutlineHueShift >= 0.5)
				{
					poiFragData.baseColor.rgb = poiOutlineColorAdjust(poiFragData.baseColor.rgb);
				}
				
				if (_OutlineExpansionMode == 2)
				{
					poiFragData.baseColor = lerp(poiFragData.baseColor, poiLight.directColor, _OutlineRimLightBlend);
				}
				
				half outlineHighlight = 0;
				if (_OutlineHighlightEnabled >= 0.5)
				{
					// Screen space N dot L: the outline is a hull with no visible shading of its own,
					// so the highlight is driven by where the light sits around the silhouette.
					float3 viewNormal = mul((float3x3)UNITY_MATRIX_V, poiMesh.normals[0]);
					float3 viewLight = mul((float3x3)UNITY_MATRIX_V, poiLight.direction);
					float2 highlightN = length(viewNormal.xy) > 1e-6 ? normalize(viewNormal.xy) : float2(0, 1);
					float2 highlightL = length(viewLight.xy) > 1e-6 ? normalize(viewLight.xy) : float2(0, 1);
					half highlightNDotL = dot(highlightN, highlightL) * 0.5 + 0.5;
					outlineHighlight = poiEdgeLinear(highlightNDotL, _OutlineHighlightBorder, _OutlineHighlightBlur) * _OutlineHighlightColor.a;
					if (_OutlineHighlightReceiveShadow >= 0.5)
					{
						outlineHighlight *= poiLight.attenShadowsStrength;
					}
					half3 highlightColor = _OutlineHighlightColor.rgb;
					#ifdef POI_AUDIOLINK
					if (_OutlineHighlightALColorEnabled >= 0.5 && poiMods.audioLinkAvailable)
					{
						half alHighlightOverrideIntensity = poiMods.audioLink[_AudioLinkOutlineHighlightColorBand];
						half alHighlightOverrideBlend = evalRamp4(alHighlightOverrideIntensity, _AudioLinkOutlineHighlightColorRamp);
						if (alHighlightOverrideBlend > 0)
						{
							half3 alHighlightOverrideColor = _AudioLinkOutlineHighlightColor.rgb;
							if (_AudioLinkOutlineHighlightColorThemeIndex > 0)
							{
								alHighlightOverrideColor = poiThemeColor(poiMods, alHighlightOverrideColor, _AudioLinkOutlineHighlightColorThemeIndex);
							}
							highlightColor = lerp(highlightColor, alHighlightOverrideColor, alHighlightOverrideBlend);
						}
					}
					#endif
					highlightColor = poiThemeColor(poiMods, highlightColor, _OutlineHighlightColorThemeIndex);
					if (_OutlineHighlightApplyTex >= 0.5)
					{
						highlightColor *= outlineHighlightTint;
					}
					// Applied here rather than earlier so the highlight sees the same tex * color input the body does
					if (_OutlineHueShift >= 0.5)
					{
						highlightColor = poiOutlineColorAdjust(highlightColor);
					}
					poiFragData.baseColor = lerp(poiFragData.baseColor, highlightColor, outlineHighlight);
				}
				
				if (_OutlineOverrideAlpha >= 0.5)
				{
					poiFragData.alpha = col.a;
				}
				else
				{
					poiFragData.alpha *= col.a;
				}
				
				if (_OutlineAlphaDistanceFade >= 0.5)
				{
					float3 position = _OutlineAlphaDistanceFadeType ? poiMesh.worldPos : poiMesh.objectPosition;
					poiFragData.alpha *= lerp(_OutlineAlphaDistanceFadeMinAlpha, _OutlineAlphaDistanceFadeMaxAlpha, smoothstep(_OutlineAlphaDistanceFadeMin, _OutlineAlphaDistanceFadeMax, distance(position, poiCam.worldPos)));
				}
				
				half emission = _OutlineEmission;
				half highlightEmission = _OutlineHighlightEmission;
				#ifdef POI_AUDIOLINK
				//UNITY_BRANCH
				if (poiMods.audioLinkAvailable)
				{
					emission += lerp(_AudioLinkOutlineEmission.x, _AudioLinkOutlineEmission.y, poiMods.audioLink[_AudioLinkOutlineEmissionBand]);
					highlightEmission += lerp(_AudioLinkOutlineHighlightEmission.x, _AudioLinkOutlineHighlightEmission.y, poiMods.audioLink[_AudioLinkOutlineHighlightEmissionBand]);
				}
				#endif
				
				// Stacks on top of the outline emission so the highlight can glow on a non-emissive outline
				emission += highlightEmission * outlineHighlight;
				
				poiFragData.emission += poiFragData.baseColor * emission;
			}
			#endif
			//endex
			
			// Saturation for theme colors. Below 0 this is a plain OKLab chroma reduction toward grey.
			// From 0 to 1 it strips the achromatic content out of the color, which is what "more saturated"
			// conventionally means. Past 1 there is no chroma left for sRGB to give at this hue, so the
			// remainder deepens the color by dropping its level instead of the slider going dead.
			half3 poiThemeSaturation(half3 color, half amount)
			{
				if (amount <= 0.0)
				{
					return PoiApplyChromatize(color, amount);
				}
				half minRgb = min(color.r, min(color.g, color.b));
				half maxRgb = max(color.r, max(color.g, color.b));
				half rangeRgb = maxRgb - minRgb;
				// A greyscale color has no hue to push toward, so leave it alone.
				half3 pureHue = (rangeRgb > 0.0001) ? ((color - minRgb) / rangeRgb) * maxRgb : color;
				half3 saturated = lerp(color, pureHue, saturate(amount));
				return saturated / (1.0 + 0.35 * max(amount - 1.0, 0.0));
			}
			
			void calculateGlobalThemes(inout PoiMods poiMods)
			{
				// Theme colors are defined as HDR; convert to SDR and do the HSV adjustment, then re-apply exposure
				half4 themeColorExposures = 0;
				half4 themeColor0, themeColor1, themeColor2, themeColor3 = 0;
				
				DecomposeHDRColor(_GlobalThemeColor0.rgb, themeColor0.rgb, themeColorExposures.x);
				DecomposeHDRColor(_GlobalThemeColor1.rgb, themeColor1.rgb, themeColorExposures.y);
				DecomposeHDRColor(_GlobalThemeColor2.rgb, themeColor2.rgb, themeColorExposures.z);
				DecomposeHDRColor(_GlobalThemeColor3.rgb, themeColor3.rgb, themeColorExposures.w);
				
				// Global Theme 0
				float themeHue0 = frac(_GlobalThemeHue0 + _GlobalThemeHueSpeed0 * POI_TIME.x);
				[flatten]
				switch((int)_GlobalThemeSaturationMethod0)
				{
					// Saturation/Value (old)
					case 0:
					{
						themeColor0.rgb = ModifyViaHSV(themeColor0.rgb, 0.0, _GlobalThemeSaturation0, _GlobalThemeValue0);
						themeColor0.rgb = hueShift(themeColor0.rgb, themeHue0, _GlobalThemeHueShiftColorSpace0, 1.0);
						break;
					}
					// Saturation/Brightness (new)
					case 1:
					{
						themeColor0.rgb = hueShift(themeColor0.rgb, themeHue0, _GlobalThemeHueShiftColorSpace0, 1.0);
						// Hue shifting in OKLab can land outside the sRGB gamut; clamp first so a negative channel
						// never reaches linear_srgb_to_oklab (pow of a negative is NaN).
						themeColor0.rgb = max(0.0, themeColor0.rgb);
						themeColor0.rgb = poiThemeSaturation(themeColor0.rgb, _GlobalThemeSaturation0);
						// Brightness rides on the exposure rather than the color. Scaling the color here instead was
						// undone by the peak rescale below - for a color already peaking at 1, multiplying by k and
						// then dividing by k left the original exactly, so the slider could darken but never brighten.
						// The exposure is applied after that rescale, which is the only place a gain survives.
						themeColorExposures.x += log2(max(_GlobalThemeBrightness0 + 1.0, 0.0001));
						themeColor0.rgb = max(0.0, themeColor0.rgb);
						break;
					}
					default:
					{
						themeColor0.rgb = float3(1.0, 0.0, 0.0);
						break;
					}
				}
				// DecomposeHDRColor guarantees max(channel) <= 1 on the normalized color; hue shifting, saturation
				// and brightness can each break that. Rescale by the peak instead of clamping per channel, so the hue
				// survives and the authored HDR intensity in themeColorExposures stays the only source of overbrightness.
				themeColor0.rgb = max(0.0, themeColor0.rgb);
				themeColor0.rgb /= max(1.0, max(themeColor0.r, max(themeColor0.g, themeColor0.b)));
				poiMods.globalColorTheme[0] = float4(ApplyHDRExposure(themeColor0.rgb, themeColorExposures.x), _GlobalThemeColor0.a);
				
				// Global Theme 1
				float themeHue1 = frac(_GlobalThemeHue1 + _GlobalThemeHueSpeed1 * POI_TIME.x);
				[flatten]
				switch((int)_GlobalThemeSaturationMethod1)
				{
					// Saturation/Value (old)
					case 0:
					{
						themeColor1.rgb = ModifyViaHSV(themeColor1.rgb, 0.0, _GlobalThemeSaturation1, _GlobalThemeValue1);
						themeColor1.rgb = hueShift(themeColor1.rgb, themeHue1, _GlobalThemeHueShiftColorSpace1, 1.0);
						break;
					}
					// Saturation/Brightness (new)
					case 1:
					{
						themeColor1.rgb = hueShift(themeColor1.rgb, themeHue1, _GlobalThemeHueShiftColorSpace1, 1.0);
						themeColor1.rgb = max(0.0, themeColor1.rgb);
						themeColor1.rgb = poiThemeSaturation(themeColor1.rgb, _GlobalThemeSaturation1);
						// See the note on theme 0: brightness has to go through the exposure to survive the rescale.
						themeColorExposures.y += log2(max(_GlobalThemeBrightness1 + 1.0, 0.0001));
						themeColor1.rgb = max(0.0, themeColor1.rgb);
						break;
					}
					default:
					{
						themeColor1.rgb = float3(1.0, 0.0, 0.0);
						break;
					}
				}
				themeColor1.rgb = max(0.0, themeColor1.rgb);
				themeColor1.rgb /= max(1.0, max(themeColor1.r, max(themeColor1.g, themeColor1.b)));
				poiMods.globalColorTheme[1] = float4(ApplyHDRExposure(themeColor1.rgb, themeColorExposures.y), _GlobalThemeColor1.a);
				
				// Global Theme 2
				float themeHue2 = frac(_GlobalThemeHue2 + _GlobalThemeHueSpeed2 * POI_TIME.x);
				[flatten]
				switch((int)_GlobalThemeSaturationMethod2)
				{
					// Saturation/Value (old)
					case 0:
					{
						themeColor2.rgb = ModifyViaHSV(themeColor2.rgb, 0.0, _GlobalThemeSaturation2, _GlobalThemeValue2);
						themeColor2.rgb = hueShift(themeColor2.rgb, themeHue2, _GlobalThemeHueShiftColorSpace2, 1.0);
						break;
					}
					// Saturation/Brightness (new)
					case 1:
					{
						themeColor2.rgb = hueShift(themeColor2.rgb, themeHue2, _GlobalThemeHueShiftColorSpace2, 1.0);
						themeColor2.rgb = max(0.0, themeColor2.rgb);
						themeColor2.rgb = poiThemeSaturation(themeColor2.rgb, _GlobalThemeSaturation2);
						// See the note on theme 0: brightness has to go through the exposure to survive the rescale.
						themeColorExposures.z += log2(max(_GlobalThemeBrightness2 + 1.0, 0.0001));
						themeColor2.rgb = max(0.0, themeColor2.rgb);
						break;
					}
					default:
					{
						themeColor2.rgb = float3(1.0, 0.0, 0.0);
						break;
					}
				}
				themeColor2.rgb = max(0.0, themeColor2.rgb);
				themeColor2.rgb /= max(1.0, max(themeColor2.r, max(themeColor2.g, themeColor2.b)));
				poiMods.globalColorTheme[2] = float4(ApplyHDRExposure(themeColor2.rgb, themeColorExposures.z), _GlobalThemeColor2.a);
				
				// Global Theme 3
				float themeHue3 = frac(_GlobalThemeHue3 + _GlobalThemeHueSpeed3 * POI_TIME.x);
				[flatten]
				switch((int)_GlobalThemeSaturationMethod3)
				{
					// Saturation/Value (old)
					case 0:
					{
						themeColor3.rgb = ModifyViaHSV(themeColor3.rgb, 0.0, _GlobalThemeSaturation3, _GlobalThemeValue3);
						themeColor3.rgb = hueShift(themeColor3.rgb, themeHue3, _GlobalThemeHueShiftColorSpace3, 1.0);
						break;
					}
					// Saturation/Brightness (new)
					case 1:
					{
						themeColor3.rgb = hueShift(themeColor3.rgb, themeHue3, _GlobalThemeHueShiftColorSpace3, 1.0);
						themeColor3.rgb = max(0.0, themeColor3.rgb);
						themeColor3.rgb = poiThemeSaturation(themeColor3.rgb, _GlobalThemeSaturation3);
						// See the note on theme 0: brightness has to go through the exposure to survive the rescale.
						themeColorExposures.w += log2(max(_GlobalThemeBrightness3 + 1.0, 0.0001));
						themeColor3.rgb = max(0.0, themeColor3.rgb);
						break;
					}
					default:
					{
						themeColor3.rgb = float3(1.0, 0.0, 0.0);
						break;
					}
				}
				themeColor3.rgb = max(0.0, themeColor3.rgb);
				themeColor3.rgb /= max(1.0, max(themeColor3.r, max(themeColor3.g, themeColor3.b)));
				poiMods.globalColorTheme[3] = float4(ApplyHDRExposure(themeColor3.rgb, themeColorExposures.w), _GlobalThemeColor3.a);
			}
			
