				#else
				half flipBookMask__1 = 1;
				#endif
				if (_FlipbookMaskGlobalMask1 > 0)
				{
					flipBookMask__1 = maskBlend(flipBookMask__1, poiMods.globalMask[_FlipbookMaskGlobalMask1 - 1], _FlipbookMaskGlobalMaskBlendType1);
