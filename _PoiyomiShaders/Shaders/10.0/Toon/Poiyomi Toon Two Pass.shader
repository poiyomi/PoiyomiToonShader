			//ifex _EnableAniso==0
			#ifdef POI_ANISOTROPICS
			
			static const float ANISO_POWER_SCALE = 1000.0;
			static const float3 LUMA_COEFFS = float3(0.299, 0.587, 0.114);
			
			struct AnisoLayerData
			{
				float strength;
				float power;
				float offset;
				float switchDirection;
				half4 tint;
				float tintIndex;
				half offsetMapStrength;
				float toonMode;
				float edge;
				float blur;
			};
			
			struct AnisoGeometry
			{
				float3 tangent;
				float3 binormal;
				float3 normal;
			};
			
			struct AnisoLightData
			{
				float3 direction;
				half3 color;
				half shadowMask;
				float nDotL;
			};
			
			half calculateAnisoShadowMask(in PoiLight poiLight, in PoiMods poiMods)
			{
				half anisoLightMap = poiLight.lightMap;
				half3 anisoRampedLightMap = poiLight.rampedLightMap / max(poiLight.attenDistance, 1e-4);
				half mask = lerp(1.0, poiMax(anisoRampedLightMap * anisoLightMap), _AnisoHideInShadow);
				mask *= lerp(1.0, poiLight.nDotL, _AnisoFadeByLightDirection);
				if (_AnisoGlobalMask > 0)
				{
					mask = customBlend(mask, poiMods.globalMask[_AnisoGlobalMask - 1], _AnisoGlobalMaskBlendType);
				}
				return mask;
			}
			
			AnisoGeometry getAnisoGeometry(in PoiMesh poiMesh)
			{
				AnisoGeometry geom;
				geom.binormal = lerp(poiMesh.binormal[0], poiMesh.binormal[1], _AnisoNormalBlend);
				geom.tangent = lerp(poiMesh.tangent[0], poiMesh.tangent[1], _AnisoNormalBlend);
				geom.normal = lerp(poiMesh.normals[0], poiMesh.normals[1], _AnisoNormalBlend);
				return geom;
			}
			
			half3 getAnisoLightColor(half3 lightColor)
			{
				return lerp(dot(lightColor, LUMA_COEFFS), lightColor, _AnisoUseLightColor);
			}
			
			half3 getAnisoBaseColor(half3 baseColor)
			{
				return lerp(float3(1, 1, 1), baseColor, _AnisoUseBaseColor);
			}
			
			half calculateAnisoSpecular(
			in AnisoGeometry geom,
			in float offset,
			in float switchDirection,
			in float3 viewDir,
			in float3 lightDir,
			in float power,
			in float strength,
			in float shadowMask
			)
			{
				float3 anisoDir = lerp(geom.binormal, geom.tangent, switchDirection);
				float3 shiftedTangent = normalize(anisoDir + offset * geom.normal);
				float3 halfVec = normalize(lightDir + viewDir);
				half dotTH = dot(shiftedTangent, halfVec);
				float sinTH = sqrt(max(0.0, 1.0 - dotTH * dotTH));
				float dirAtten = smoothstep(-1.0, 0.0, dotTH);
				return saturate(dirAtten * pow(sinTH, power * ANISO_POWER_SCALE) * strength) * shadowMask;
			}
			
			float applyAnisoStylization(float specular, float edge, float blur)
			{
				half edgeMin = saturate(edge - blur * 0.5);
				half edgeMax = saturate(edge + blur * 0.5);
				return saturate((specular - edgeMin) / max(edgeMax - edgeMin + fwidth(specular), 0.001));
			}
			
			float3 calculateAnisoLayer(
			in AnisoGeometry geom,
			in AnisoLayerData layer,
			in float3 viewDir,
			in AnisoLightData light,
			in float offsetMap,
			in float3 specMapColor,
			in PoiMods poiMods
			)
			{
				float offset = layer.offset + layer.offsetMapStrength * offsetMap;
				half specular = calculateAnisoSpecular(geom, offset, layer.switchDirection, viewDir, light.direction, layer.power, layer.strength, light.shadowMask);
				specular = lerp(specular, applyAnisoStylization(specular, layer.edge, layer.blur), layer.toonMode);
				return specular * specMapColor * poiThemeColor(poiMods, layer.tint.rgb, layer.tintIndex);
			}
			
			void processAnisoLight(
			inout PoiFragData poiFragData,
			inout PoiLight poiLight,
			in PoiCam poiCam,
			in PoiMods poiMods,
			in AnisoGeometry geom,
			in float3 specMapColor,
			in float offsetMap,
			in AnisoLayerData layer0,
			in AnisoLayerData layer1,
			in AnisoLightData lightData
			)
			{
				half3 layer0Color = calculateAnisoLayer(geom, layer0, poiCam.eyeViewDir, lightData, offsetMap, specMapColor, poiMods);
				half3 layer1Color = calculateAnisoLayer(geom, layer1, poiCam.eyeViewDir, lightData, offsetMap, specMapColor, poiMods);
				
				half3 baseColorMix = getAnisoBaseColor(poiFragData.baseColor);
				half3 lightColorMix = getAnisoLightColor(lightData.color);
				float3 finalSpec = (layer0Color + layer1Color) * baseColorMix * lightColorMix;
				
				poiLight.finalLightAdd += max(0.0, finalSpec * _AnisoAdd);
				
				if (_AnisoReplace > 0.0)
				{
					half3 replaceColor = (layer0Color + layer1Color) * baseColorMix * lightColorMix;
					half replaceMask = saturate(poiMax(replaceColor));
					poiFragData.baseColor = lerp(poiFragData.baseColor, replaceColor, _AnisoReplace * replaceMask);
				}
			}
			
			void applyAnisotropics(inout PoiFragData poiFragData, inout PoiLight poiLight, in PoiCam poiCam, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				#if defined(PROP_ANISOCOLORMAP) || !defined(OPTIMIZER_ENABLED)
				float4 specMap = POI2D_SAMPLER_PAN(_AnisoColorMap, _MainTex, poiUV(poiMesh.uv[_AnisoColorMapUV], _AnisoColorMap_ST), _AnisoColorMapPan);
				#else
				float4 specMap = float4(1, 1, 1, 0);
				#endif
				
				half shadowMask = calculateAnisoShadowMask(poiLight, poiMods);
				AnisoGeometry geom = getAnisoGeometry(poiMesh);
				
				AnisoLayerData layer0 = {
					_Aniso0Strength, _Aniso0Power, _Aniso0Offset, _Aniso0SwitchDirection,
					_Aniso0Tint, _Aniso0TintIndex, _Aniso0OffsetMapStrength,
					_Aniso0ToonMode, _Aniso0Edge, _Aniso0Blur
				};
				
				AnisoLayerData layer1 = {
					_Aniso1Strength, _Aniso1Power, _Aniso1Offset, _Aniso1SwitchDirection,
					_Aniso1Tint, _Aniso1TintIndex, _Aniso1OffsetMapStrength,
					_Aniso1ToonMode, _Aniso1Edge, _Aniso1Blur
				};
				
				AnisoLightData mainLight = {
					poiLight.direction,
					poiLight.directColor,
					shadowMask,
					poiLight.nDotL
				};
				
				processAnisoLight(poiFragData, poiLight, poiCam, poiMods, geom, specMap.rgb, specMap.a, layer0, layer1, mainLight);
				
				if (poiFragData.toggleVertexLights)
				{
					#if defined(VERTEXLIGHT_ON)
					for (int i = 0; i < 4; i++)
					{
						AnisoLightData vLight = {
							poiLight.vDirection[i],
							poiLight.vColor[i],
							poiLight.vSaturatedDotNL[i],
							poiLight.vSaturatedDotNL[i]
						};
						processAnisoLight(poiFragData, poiLight, poiCam, poiMods, geom, specMap.rgb, specMap.a, layer0, layer1, vLight);
					}
					#endif
				}
			}
			#endif
			//endex
			
			//ifex _MatcapEnable==0 && _Matcap2Enable==0 && _Matcap3Enable==0 && _Matcap4Enable==0
			void blendMatcap(inout PoiLight poiLight, inout PoiFragData poiFragData, in PoiMods poiMods, float add, float lightAdd, float multiply, float replace, float mixed, float screen, float4 matcapColor, float matcapMask, float emissionStrength, float matcapLightMask, uint globalMaskIndex, float globalMaskBlendType, in MatcapAudioLinkData matcapALD)
			{
				if (matcapLightMask)
				{
					matcapMask *= lerp(1, poiMax(poiLight.rampedLightMap * poiLight.lightMap), matcapLightMask);
				}
				if (globalMaskIndex > 0)
				{
					matcapMask = maskBlend(matcapMask, poiMods.globalMask[globalMaskIndex - 1], globalMaskBlendType);
				}
				
				#ifdef POI_AUDIOLINK
				if (matcapALD.matcapALEnabled > 0)
				{
					matcapColor.a = saturate(matcapColor.a + lerp(matcapALD.matcapALAlphaAdd.x, matcapALD.matcapALAlphaAdd.y, poiMods.audioLink[matcapALD.matcapALAlphaAddBand]));
					emissionStrength += lerp(matcapALD.matcapALEmissionAdd.x, matcapALD.matcapALEmissionAdd.y, poiMods.audioLink[matcapALD.matcapALEmissionAddBand]);
				}
				#endif
				
				half matcapAlpha = matcapColor.a * matcapMask;
				poiFragData.baseColor.rgb = lerp(poiFragData.baseColor.rgb, matcapColor.rgb, replace * matcapAlpha * .999999);
				poiFragData.baseColor.rgb *= lerp(1, matcapColor.rgb, multiply * matcapAlpha);
				poiFragData.baseColor.rgb += matcapColor.rgb * add * matcapAlpha;
				poiFragData.baseColor.rgb = lerp(poiFragData.baseColor.rgb, blendScreen(poiFragData.baseColor.rgb, matcapColor.rgb), screen * matcapAlpha);
				#if defined(POI_PASS_BASE)
				poiLight.finalLightAdd += matcapColor.rgb * lightAdd * matcapAlpha;
				#endif
				poiFragData.baseColor.rgb *= 1 + matcapColor.rgb * (mixed * matcapAlpha);
				poiFragData.emission += matcapColor.rgb * emissionStrength * matcapAlpha;
			}
			
			void getMatcapUV(inout float2 matcapUV, out float2 matcapMaskUV, in float2 matcapPan, in float matcapUVMode, in float matcapUVToBlend, in float2 matCapBlendUV, in float matcapRotation, in float matcapBorder, in float3 normal, in PoiCam poiCam, in PoiLight poiLight, in PoiMesh poiMesh, in float matcapNormalStrength, in float matcapVRParallaxStrength, in MatcapAudioLinkData matcapALD)
			{
				float2 uvPan = matcapPan * POI_TIME.x;
				// 0 = center eye (stable across both eyes), 1 = per eye (lilToon's VR Parallax Strength)
				float3 matcapViewDir = normalize(lerp(poiCam.viewDir, poiCam.eyeViewDir, matcapVRParallaxStrength));
				switch(matcapUVMode)
				{
					// Normal / UTS
					case 0:
					{
						float3 viewNormal = (mul(UNITY_MATRIX_V, float4(normal, 0))).rgb;
						float3 NormalBlend_MatCapUV_Detail = viewNormal.rgb * float3(-1, -1, 1);
						float3 NormalBlend_MatCapUV_Base = (mul(UNITY_MATRIX_V, float4(matcapViewDir, 0)).rgb * float3(-1, -1, 1)) + float3(0, 0, 1);
						float3 noSknewViewNormal = NormalBlend_MatCapUV_Base * dot(NormalBlend_MatCapUV_Base, NormalBlend_MatCapUV_Detail) / NormalBlend_MatCapUV_Base.b - NormalBlend_MatCapUV_Detail;
						
						matcapUV = noSknewViewNormal.rg * matcapBorder + 0.5;
						break;
					}
					// Top Pinch
					case 1:
					{
						float3 worldViewUp = normalize(float3(0, 1, 0) - matcapViewDir * dot(matcapViewDir, float3(0, 1, 0)));
						float3 worldViewRight = normalize(cross(matcapViewDir, worldViewUp));
						matcapUV = float2(dot(worldViewRight, normal), dot(worldViewUp, normal)) * matcapBorder + 0.5;
						break;
					}
					// Custom Double Sided
					case 2:
					{
						float3 reflection = reflect(-matcapViewDir, normal);
						float2 uv = float2(dot(reflection, float3(1, 0, 0)), dot(reflection, float3(0, 1, 0)));
						matcapUV = uv * matcapBorder + 0.5;
						break;
					}
					// Gradient
					case 3:
					{
						matcapUV = 1 - abs(dot(normal, matcapViewDir));
						#ifdef POI_AUDIOLINK
						if (matcapALD.matcapALEnabled)
						{
							uvPan += AudioLinkGetChronoTime(matcapALD.matcapALChronoPanType, matcapALD.matcapALChronoPanBand) * matcapALD.matcapALChronoPanSpeed;
						}
						#endif
						break;
					}
					case 4:
					{
						// A solution to top pinch would be so awesome
						
						float3 worldUp = float3(0, 1, 0);
						float3 tangent = normalize(cross(normal, worldUp));
						
						float3 bitangent = normalize(cross(normal, tangent));
						float2 projection;
						float3 matcapHalfDir = normalize(poiLight.direction + matcapViewDir);
						projection.x = dot(matcapHalfDir, tangent);
						projection.y = dot(matcapHalfDir, bitangent);
						matcapUV = projection * matcapBorder + 0.5;
						break;
					}
				}
				matcapUV = lerp(matcapUV, poiMesh.uv[matcapUVToBlend], matCapBlendUV);
				// don't pan the mask UV
				matcapMaskUV = matcapUV;
				matcapUV += uvPan;
				matcapUV = RotateUV(matcapUV, matcapRotation * UNITY_PI, float2(.5, .5), 1.0f);
				
				if (IsInMirror() && matcapUVMode != 3)
				{
					matcapUV.x = 1 - matcapUV.x;
				}
			}
			
			//endex
			//ifex _MatcapEnable==0 && _Matcap2Enable==0 && _Matcap3Enable==0 && _Matcap4Enable==0
			#if defined(POI_MATCAP0) || defined(COLOR_GRADING_HDR_3D) || defined(POI_MATCAP2) || defined(POI_MATCAP3)
			void applyMatcap(inout PoiFragData poiFragData, in PoiCam poiCam, in PoiMesh poiMesh, inout PoiLight poiLight, in PoiMods poiMods)
			{
				bool sceneHasReflections = SceneHasReflections();
				bool isOutlinePass = false;
				#ifdef POI_PASS_OUTLINE
				isOutlinePass = true;
				#endif
				float4 matcap = 0;
				half matcapMask = 0;
				float4 matcap2 = 0;
				half matcap2Mask = 0;
				float4 matcap3 = 0;
				half matcap3Mask = 0;
				float4 matcap4 = 0;
				half matcap4Mask = 0;
				float2 matcapUV = 0;
				float2 matcapMaskUV = 0;
				half matcapIntensity;
				struct MatcapAudioLinkData matcapALD;
				//endex
				
				//ifex _MatcapEnable==0
				// Matcap 1
				#ifdef POI_MATCAP0
				UNITY_BRANCH
				if (!(_MatcapHideWithReflProbe >= 0.5 && sceneHasReflections) && (!isOutlinePass || _MatcapShowInOutline >= 0.5))
				{
					matcapALD.matcapALEnabled = _Matcap0ALEnabled;
					matcapALD.matcapALAlphaAddBand = _Matcap0ALAlphaAddBand;
					matcapALD.matcapALAlphaAdd = _Matcap0ALAlphaAdd;
					matcapALD.matcapALEmissionAddBand = _Matcap0ALEmissionAddBand;
					matcapALD.matcapALEmissionAdd = _Matcap0ALEmissionAdd;
					matcapALD.matcapALIntensityAddBand = _Matcap0ALIntensityAddBand;
					matcapALD.matcapALIntensityAdd = _Matcap0ALIntensityAdd;
					matcapALD.matcapALChronoPanType = _Matcap0ALChronoPanType;
					matcapALD.matcapALChronoPanBand = _Matcap0ALChronoPanBand;
					matcapALD.matcapALChronoPanSpeed = _Matcap0ALChronoPanSpeed;
					
					float3 normal0 = lerp(poiMesh.normals[0], poiMesh.normals[1], _MatcapNormal);
					#ifdef POI_MATCAP0_CUSTOM_NORMAL
					#if defined(PROP_MATCAP0NORMALMAP) || !defined(OPTIMIZER_ENABLED)
					normal0 = calculateNormal(poiMesh.normals[_MatcapNormal], poiMesh, _Matcap0NormalMap, sampler_MainTex, _Matcap0NormalMap_ST, _Matcap0NormalMapPan, _Matcap0NormalMapUV, _Matcap0NormalMapScale);
					#endif
					#endif
					
					#if defined(PROP_MATCAP) || !defined(OPTIMIZER_ENABLED)
					getMatcapUV(matcapUV, matcapMaskUV, _MatcapPan.xy, _MatcapUVMode, _MatcapUVToBlend, _MatCapBlendUV1.xy, _MatcapRotation, _MatcapBorder, normal0, poiCam, poiLight, poiMesh, _MatcapNormal, _MatCapVRParallaxStrength, matcapALD);
					#else
					UNITY_BRANCH
					if (_Matcap0CircleMaskEnabled >= 0.5)
					{
						getMatcapUV(matcapUV, matcapMaskUV, _MatcapPan.xy, _MatcapUVMode, _MatcapUVToBlend, _MatCapBlendUV1.xy, _MatcapRotation, _MatcapBorder, normal0, poiCam, poiLight, poiMesh, _MatcapNormal, _MatCapVRParallaxStrength, matcapALD);
					}
					#endif
					
					half4 matcapMaskSample = 1;
					#if defined(PROP_MATCAPMASK) || !defined(OPTIMIZER_ENABLED)
					matcapMaskSample = POI2D_SAMPLER_PAN(_MatcapMask, _MainTex, poiUV(poiMesh.uv[_MatcapMaskUV], _MatcapMask_ST), _MatcapMaskPan);
					#endif
					
					#if defined(PROP_MATCAP) || !defined(OPTIMIZER_ENABLED)
					float2 matcapSampleUV = TRANSFORM_TEX(matcapUV, _Matcap);
					float mipCount0 = floor(log2(max(_Matcap_TexelSize.z, _Matcap_TexelSize.w)));
					
					half matcapSmoothness = _MatcapSmoothness;
					
					if (_MatcapMaskSmoothnessApply >= 0.5)
					{
						matcapSmoothness *= matcapMaskSample[_MatcapMaskSmoothnessChannel];
					}
					matcapSmoothness = (1 - matcapSmoothness) * mipCount0;
					matcap = UNITY_SAMPLE_TEX2D_SAMPLER_LOD(_Matcap, _trilinear_repeat, matcapSampleUV, matcapSmoothness) * float4(poiThemeColor(poiMods, _MatcapColor.rgb, _MatcapColorThemeIndex), _MatcapColor.a);
					
					#else
					matcap = float4(poiThemeColor(poiMods, _MatcapColor.rgb, _MatcapColorThemeIndex), _MatcapColor.a);
					#endif
					matcap.rgb *= lerp(1, poiLight.directColor, _MatcapLightColorMix);
					
					matcapIntensity = _MatcapIntensity;
					#ifdef POI_AUDIOLINK
					if (matcapALD.matcapALEnabled > 0)
					{
						matcapIntensity += lerp(matcapALD.matcapALIntensityAdd.x, matcapALD.matcapALIntensityAdd.y, poiMods.audioLink[matcapALD.matcapALIntensityAddBand]);
						matcapIntensity = max(0, matcapIntensity);
					}
					#endif
					matcap.rgb *= matcapIntensity;
					#ifndef POI_GRABPASS
					matcap.rgb = lerp(matcap.rgb, matcap.rgb * poiFragData.baseColor.rgb, _MatcapBaseColorMix);
					#endif
					
					//UNITY_BRANCH
					if (_MatcapHueShiftEnabled >= 0.5)
					{
						matcap.rgb = hueShift(matcap.rgb, _MatcapHueShift + POI_TIME.x * _MatcapHueShiftSpeed, _MatcapHueShiftColorSpace, _MatcapHueSelectOrShift);
					}
					
					#if defined(PROP_MATCAPMASK) || !defined(OPTIMIZER_ENABLED)
					matcapMask = matcapMaskSample[_MatcapMaskChannel];
					#else
					matcapMask = 1;
					#endif
					
					if (_MatcapMaskInvert >= 0.5)
					{
						matcapMask = 1 - matcapMask;
					}
					
					#ifdef TPS_Penetrator
					if (_MatcapTPSDepthEnabled >= 0.5)
					{
						matcapMask = lerp(0, matcapMask * TPSBufferedDepth(poiMesh.localPos, poiMesh.vertexColor), _MatcapTPSMaskStrength);
					}
					#endif
					
					if(_Matcap0CircleMaskEnabled >= 0.5)
					{
						matcapMask *= 1-poiEdgeNonLinear(distance(float2(0.5,0.5), matcapMaskUV), _Matcap0CircleMaskBorder, _Matcap0CircleMaskBlur);
					}
					poiFragData.alpha *= lerp(1, matcap.a, matcapMask * _MatcapAlphaOverride);
					
					if (_MatcapApplyToAlphaEnabled >= 0.5)
					{
						half matcapAlphaApplyValue = dot(matcap.rgb, float3(0.299, 0.587, 0.114)); // Greyscale
						if (_MatcapApplyToAlphaSourceBlend == 1) // Max
						
						{
							matcapAlphaApplyValue = poiMax(matcap.rgb);
						}
						if (_MatcapApplyToAlphaBlendType == 0) // Add
						
						{
							poiFragData.alpha += lerp(0, matcapAlphaApplyValue, _MatcapApplyToAlphaBlending);
							poiFragData.alpha = saturate(poiFragData.alpha);
						}
						else if (_MatcapApplyToAlphaBlendType == 1) // Multiply
						
						{
							poiFragData.alpha *= lerp(1, matcapAlphaApplyValue, _MatcapApplyToAlphaBlending);
						}
					}
					
					#ifdef POI_AUDIOLINK
					if (matcapALD.matcapALEnabled > 0 && _Matcap0ALColorOverrideEnabled >= 0.5)
					{
						// Color Override
						half alColorOverrideIntensity = poiMods.audioLink[_Matcap0ALColorOverrideBand];
						half alColorOverrideBlend = evalRamp4(alColorOverrideIntensity, _Matcap0ALColorOverrideRamp);
						if(alColorOverrideBlend > 0)
						{
							half3 alOverrideColor = _Matcap0ALColorOverride.rgb;
							if(_Matcap0ALColorOverrideThemeIndex > 0)
							{
								alOverrideColor = poiThemeColor(poiMods, alOverrideColor, _Matcap0ALColorOverrideThemeIndex);
							}
							matcap.rgb = lerp(matcap.rgb, alOverrideColor, alColorOverrideBlend);
						}
					}
					#endif
					
					blendMatcap(poiLight, poiFragData, poiMods, _MatcapAdd, _MatcapAddToLight, _MatcapMultiply, _MatcapReplace, _MatcapMixed, _MatcapScreen, matcap, matcapMask, _MatcapEmissionStrength, _MatcapLightMask, _MatcapMaskGlobalMask, _MatcapMaskGlobalMaskBlendType, matcapALD);
				}
				#endif
				//endex
				//ifex _Matcap2Enable==0
				// Matcap 2
				#ifdef COLOR_GRADING_HDR_3D
				UNITY_BRANCH
				if (!(_Matcap2HideWithReflProbe >= 0.5 && sceneHasReflections) && (!isOutlinePass || _Matcap2ShowInOutline >= 0.5))
				{
					matcapALD.matcapALEnabled = _Matcap1ALEnabled;
					matcapALD.matcapALAlphaAddBand = _Matcap1ALAlphaAddBand;
					matcapALD.matcapALAlphaAdd = _Matcap1ALAlphaAdd;
					matcapALD.matcapALEmissionAddBand = _Matcap1ALEmissionAddBand;
					matcapALD.matcapALEmissionAdd = _Matcap1ALEmissionAdd;
					matcapALD.matcapALIntensityAddBand = _Matcap1ALIntensityAddBand;
					matcapALD.matcapALIntensityAdd = _Matcap1ALIntensityAdd;
					matcapALD.matcapALChronoPanType = _Matcap1ALChronoPanType;
					matcapALD.matcapALChronoPanBand = _Matcap1ALChronoPanBand;
					matcapALD.matcapALChronoPanSpeed = _Matcap1ALChronoPanSpeed;
					
					float3 normal1 = lerp(poiMesh.normals[0], poiMesh.normals[1], _Matcap2Normal);
					#ifdef POI_MATCAP1_CUSTOM_NORMAL
					#if defined(PROP_MATCAP1NORMALMAP) || !defined(OPTIMIZER_ENABLED)
					normal1 = calculateNormal(poiMesh.normals[_Matcap2Normal], poiMesh, _Matcap1NormalMap, sampler_MainTex, _Matcap1NormalMap_ST, _Matcap1NormalMapPan, _Matcap1NormalMapUV, _Matcap1NormalMapScale);
					#endif
					#endif
					
					#if defined(PROP_MATCAP2) || !defined(OPTIMIZER_ENABLED)
					getMatcapUV(matcapUV, matcapMaskUV, _Matcap2Pan.xy, _Matcap2UVMode, _Matcap2UVToBlend, _MatCap2ndBlendUV1.xy, _Matcap2Rotation, _Matcap2Border, normal1, poiCam, poiLight, poiMesh, _Matcap2Normal, _MatCap2ndVRParallaxStrength, matcapALD);
					#else
					UNITY_BRANCH
					if (_Matcap2CircleMaskEnabled >= 0.5)
					{
						getMatcapUV(matcapUV, matcapMaskUV, _Matcap2Pan.xy, _Matcap2UVMode, _Matcap2UVToBlend, _MatCap2ndBlendUV1.xy, _Matcap2Rotation, _Matcap2Border, normal1, poiCam, poiLight, poiMesh, _Matcap2Normal, _MatCap2ndVRParallaxStrength, matcapALD);
					}
					#endif
					
					half4 matcap2MaskSample = 1;
					#if defined(PROP_MATCAP2MASK) || !defined(OPTIMIZER_ENABLED)
					matcap2MaskSample = POI2D_SAMPLER_PAN(_Matcap2Mask, _MainTex, poiUV(poiMesh.uv[_Matcap2MaskUV], _Matcap2Mask_ST), _Matcap2MaskPan);
					#endif
					
					#if defined(PROP_MATCAP2) || !defined(OPTIMIZER_ENABLED)
					float2 matcapSampleUV2 = TRANSFORM_TEX(matcapUV, _Matcap2);
					float mipCount2 = floor(log2(max(_Matcap2_TexelSize.z, _Matcap2_TexelSize.w)));
					
					half matcap2Smoothness = _Matcap2Smoothness;
					
					if (_Matcap2MaskSmoothnessApply >= 0.5)
					{
						matcap2Smoothness *= matcap2MaskSample[_Matcap2MaskSmoothnessChannel];
					}
					matcap2Smoothness = (1 - matcap2Smoothness) * mipCount2;
					matcap2 = UNITY_SAMPLE_TEX2D_SAMPLER_LOD(_Matcap2, _trilinear_repeat, matcapSampleUV2, matcap2Smoothness) * float4(poiThemeColor(poiMods, _Matcap2Color.rgb, _Matcap2ColorThemeIndex), _Matcap2Color.a);
					
					#else
					matcap2 = float4(poiThemeColor(poiMods, _Matcap2Color.rgb, _Matcap2ColorThemeIndex), _Matcap2Color.a);
					#endif
					matcap2.rgb *= lerp(1, poiLight.directColor, _Matcap2LightColorMix);
					
					matcapIntensity = _Matcap2Intensity;
					#ifdef POI_AUDIOLINK
					if (matcapALD.matcapALEnabled > 0)
					{
						matcapIntensity += lerp(matcapALD.matcapALIntensityAdd.x, matcapALD.matcapALIntensityAdd.y, poiMods.audioLink[matcapALD.matcapALIntensityAddBand]);
						matcapIntensity = max(0, matcapIntensity);
					}
					#endif
					matcap2.rgb *= matcapIntensity;
					#ifndef POI_GRABPASS
					matcap2.rgb = lerp(matcap2.rgb, matcap2.rgb * poiFragData.baseColor.rgb, _Matcap2BaseColorMix);
					#endif
					
					//UNITY_BRANCH
					if (_Matcap2HueShiftEnabled >= 0.5)
					{
						matcap2.rgb = hueShift(matcap2.rgb, _Matcap2HueShift + POI_TIME.x * _Matcap2HueShiftSpeed, _Matcap2HueShiftColorSpace, _Matcap2HueSelectOrShift);
					}
					
					#if defined(PROP_MATCAP2MASK) || !defined(OPTIMIZER_ENABLED)
					matcap2Mask = matcap2MaskSample[_Matcap2MaskChannel];
					#else
					matcap2Mask = 1;
					#endif
					if (_Matcap2MaskInvert >= 0.5)
					{
						matcap2Mask = 1 - matcap2Mask;
					}
					
					#ifdef TPS_Penetrator
					if (_Matcap2TPSDepthEnabled >= 0.5)
					{
						matcap2Mask = lerp(0, matcap2Mask * TPSBufferedDepth(poiMesh.localPos, poiMesh.vertexColor), _Matcap2TPSMaskStrength);
					}
					#endif
					
					if(_Matcap2CircleMaskEnabled >= 0.5)
					{
