			#ifdef _CUBEMAP
			#if defined(PROP_CUBEMAP) || !defined(OPTIMIZER_ENABLED)
			// From Unity's MIT'd Skybox-Cubed.shader
			float3 RotateAroundYInDegrees(float3 dir, float degrees)
			{
				half alpha = degrees * UNITY_PI / 180.0;
				float sina, cosa;
				sincos(alpha, sina, cosa);
				float2x2 m = float2x2(cosa, -sina, sina, cosa);
				return float3(mul(m, dir.xz), dir.y).xzy;
			}
			#endif
			void applyCubemap(inout PoiFragData poiFragData, in PoiCam poiCam, in PoiMesh poiMesh, in PoiLight poiLight, in PoiMods poiMods)
			{
				float3 CubeMapUV = 0;
				
				switch(_CubeMapUVMode)
				{
					case 0: // Skybox
					{
						CubeMapUV = -poiCam.eyeViewDir;
						break;
					}
					case 1: // Reflection
					{
						CubeMapUV = lerp(poiCam.vertexReflectionDir, poiCam.reflectionDir, _CubeMapNormal);
						break;
					}
					case 2: // World Normal Direction
					{
						CubeMapUV = lerp(poiMesh.normals[0], poiMesh.normals[1], _CubeMapWorldNormalsStrength);
						break;
					}
					case 3: // Local Normal Direction
					{
						CubeMapUV = poiMesh.objNormal;
						break;
					}
				}
				
				#if defined(PROP_CUBEMAP) || !defined(OPTIMIZER_ENABLED)
				if (any(_CubeMapRotation.xyz) || any(_CubeMapRotationPan.xyz))
				{
					// Do funny swizzle so we don't have to make a new function for every direction
					CubeMapUV = RotateAroundYInDegrees(CubeMapUV.yxz, _CubeMapRotation.x + (_CubeMapRotationPan.x * POI_TIME.y)).yxz;
					CubeMapUV = RotateAroundYInDegrees(CubeMapUV.xyz, _CubeMapRotation.y + (_CubeMapRotationPan.y * POI_TIME.y)).xyz;
					CubeMapUV = RotateAroundYInDegrees(CubeMapUV.xzy, _CubeMapRotation.z + (_CubeMapRotationPan.z * POI_TIME.y)).xzy;
				}
				//float4 cubeMap = texCUBElod(_CubeMap, float4(CubeMapUV, (1 - _CubeMapSmoothness) * (1 - _CubeMapSmoothness) * 8));
				float mipLevel = (1 - _CubeMapSmoothness) * (1 - _CubeMapSmoothness) * 8;
				float4 cubeMap = POI_SAMPLE_TEXCUBE_LOD(_CubeMap, sampler_linear_clamp, CubeMapUV, mipLevel);
				
				cubeMap.rgb *= poiThemeColor(poiMods, _CubeMapColor.rgb, _CubeMapColorThemeIndex);
				#else
				float4 cubeMap = float4(0.21763764082, 0.21763764082, 0.21763764082, .5) * float4(poiThemeColor(poiMods, _CubeMapColor.rgb, _CubeMapColorThemeIndex), 1);
				#endif
				
				cubeMap.rgb *= _CubeMapIntensity;
				#if defined(PROP_CUBEMAPMASK) || !defined(OPTIMIZER_ENABLED)
				half CubeMapMask = POI2D_SAMPLER_PAN(_CubeMapMask, _MainTex, poiUV(poiMesh.uv[_CubeMapMaskUV], _CubeMapMask_ST), _CubeMapMaskPan)[_CubeMapMaskChannel];
				#else
				half CubeMapMask = 1;
				#endif
				
				if (_CubeMapMaskGlobalMask > 0)
				{
					CubeMapMask = maskBlend(CubeMapMask, poiMods.globalMask[_CubeMapMaskGlobalMask - 1], _CubeMapMaskGlobalMaskBlendType);
				}
				
				if (_CubeMapMaskInvert >= 0.5)
				{
					CubeMapMask = 1 - CubeMapMask;
				}
				
				//UNITY_BRANCH
				if (_CubeMapHueShiftEnabled >= 0.5)
				{
					cubeMap.rgb = hueShift(cubeMap.rgb, _CubeMapHueShift + POI_TIME.x * _CubeMapHueShiftSpeed, _CubeMapHueShiftColorSpace, _CubeMapHueSelectOrShift);
					cubeMap = PoiColorBCS(cubeMap, _CubeMapBrightness, _CubeMapContrast, _CubeMapSaturation);
					//cubeMap.rgb = ModifyViaHSV(cubeMap.rgb, _CubeMapHueShift + POI_TIME.x * _CubeMapHueShiftSpeed, _CubeMapSaturation, _CubeMapValue);
					
				}
				CubeMapMask = min(CubeMapMask, lerp(1, poiLight.rampedLightMap * poiLight.lightMap, _CubeMapLightMask));
				half cubeMapAlpha = CubeMapMask * cubeMap.a * _CubeMapBlendAmount;
				poiFragData.baseColor.rgb = lerp(poiFragData.baseColor.rgb, cubeMap.rgb, cubeMapAlpha * (_CubemapBlendType == 0));
				poiFragData.baseColor.rgb *= lerp(1, cubeMap.rgb, cubeMapAlpha * (_CubemapBlendType == 1));
				poiFragData.baseColor.rgb += cubeMap.rgb * cubeMapAlpha * (_CubemapBlendType == 2);
				poiFragData.emission += cubeMap.rgb * _CubeMapEmissionStrength * CubeMapMask * cubeMap.a;
			}
			#endif
			//endex
			
			//ifex _EnableALDecal==0
			#ifdef POI_AUDIOLINK
			#ifdef POI_AL_DECAL
			void ApplyAudioLinkDecal(in PoiMesh poiMesh, in PoiCam poiCam, inout PoiFragData poiFragData, in PoiMods poiMods)
			{
				half4 colorAndMask = float4(1, 1, 1, 1);
				#if defined(PROP_ALDECALCOLORMASK) || !defined(OPTIMIZER_ENABLED)
				colorAndMask = POI2D_SAMPLER_PAN(_ALDecalColorMask, _MainTex, poiUV(poiMesh.uv[_ALDecalColorMaskUV], _ALDecalColorMask_ST), _ALDecalColorMaskPan);
				#endif
				if (_ALDecalGlobalMask > 0)
				{
					colorAndMask.a = customBlend(colorAndMask.a, poiMods.globalMask[_ALDecalGlobalMask-1], _ALDecalGlobalMaskBlendType);
				}
				
				float4 scaleOffset = float4(-_ALDecalSideOffset.x, _ALDecalSideOffset.y, -_ALDecalSideOffset.z, _ALDecalSideOffset.w);
				float2 centerOffset = float2((scaleOffset.x + scaleOffset.y) / 2, (scaleOffset.z + scaleOffset.w) / 2);
				float2 uv = poiMesh.uv[_ALDecalUV];
				float tilingClip = 1;
				// Symmetry
				if (_ALDecalSymmetryMode == 1) uv.x = abs(uv.x - 0.5) + 0.5;
				if (_ALDecalSymmetryMode == 2 && uv.x < 0.5) uv.x = uv.x + 0.5;
				// Mirrored UV
				if ((_ALDecalMirroredUVMode == 1 || _ALDecalMirroredUVMode == 4) && poiMesh.isRightHand) uv.x = 1.0 - uv.x;
				if (_ALDecalMirroredUVMode == 2 && poiMesh.isRightHand) tilingClip = 0;
				if ((_ALDecalMirroredUVMode == 3 || _ALDecalMirroredUVMode == 4) && !poiMesh.isRightHand) tilingClip = 0;
				
				float2 decalCenter = _ALDecalPosition + centerOffset;
				float theta = radians(_ALDecalRotation + POI_TIME.z * _ALDecalRotationSpeed);
				float cs = cos(theta);
				float sn = sin(theta);
				uv = float2((uv.x - decalCenter.x) * cs - (uv.y - decalCenter.y) * sn + decalCenter.x, (uv.x - decalCenter.x) * sn + (uv.y - decalCenter.y) * cs + decalCenter.y);
				uv = remap(uv, float2(0, 0) - _ALDecalScale / 2 + _ALDecalPosition + scaleOffset.xz, _ALDecalScale / 2 + _ALDecalPosition + scaleOffset.yw, float2(0, 0), float2(1, 1));
				// Tiling Clip
				if (_ALDecalTiled < 0.5)
				{
					if (uv.x > 1 || uv.y > 1 || uv.x < 0 || uv.y < 0)
					{
						tilingClip = 0;
					}
				}
				uv = tilingClip > 0 ? frac(uv) : uv;
				
				// Mask
				half3 audioLinkMask = 1.0;
				
				// UV
				float2 aluv = uv;
				half maskY = aluv.y;
				half maskX = aluv.x;
				if (_ALDecalUVMode == 1)
				{
					float2 uvdir = uv * 2 - 1;
					aluv.x = frac(atan2(uvdir.y, uvdir.x) * UNITY_INV_TWO_PI);
					aluv.y = length(uvdir);
					maskY = remap(aluv.y, _ALDecaldCircleDimensions.x, _ALDecaldCircleDimensions.y, 0, 1);
					maskX = remap(aluv.x, _ALDecaldCircleDimensions.z, _ALDecaldCircleDimensions.w, 0, 1);
				}
				
				half maskVolume = _ALDecalVolumeStep != 0.0 ? floor(maskY * _ALDecalVolumeStep + 1e-4) / _ALDecalVolumeStep : maskY;
				half maskBand = _ALDecalBandStep != 0.0 ? floor(maskX * _ALDecalBandStep + 1e-4) / _ALDecalBandStep : maskX;
				
				// Mirror band axis (0->1->0 or 1->0->1)
				if (_ALDecalMirrorBand == 1)
				{
					maskBand = 1.0 - abs(maskBand * 2.0 - 1.0);
				}
				else if (_ALDecalMirrorBand == 2)
				{
					maskBand = abs(maskBand * 2.0 - 1.0);
				}
				
				// Copy
				audioLinkMask.r = maskVolume;
				audioLinkMask.g = maskBand;
				
				// Clip
				audioLinkMask.b = maskVolume < _ALDecalVolumeClipMin || maskVolume > _ALDecalVolumeClipMax ? 0.0 : audioLinkMask.b;
				audioLinkMask.b = maskBand < _ALDecalBandClipMin || maskBand > _ALDecalBandClipMax ? 0.0 : audioLinkMask.b;
				
				// Shape Clip (analytical filtered pulse for proper AA on all edges)
				if (_ALDecalShapeClip >= 0.5)
				{
					if (_ALDecalVolumeStep != 0.0)
					{
						float vw = _ALDecalShapeClipVolumeWidth;
						float gw = 1.0 - vw;
						// Center the bar in each step so the gap straddles the step boundary
						float volInput = maskY * _ALDecalVolumeStep - gw * 0.5;
						float vdx = max(fwidth(volInput), 0.0001);
						float vx0 = volInput - vdx * 0.5;
						float vx1 = volInput + vdx * 0.5;
						float vI0 = floor(vx0) * vw + min(frac(vx0), vw);
						float vI1 = floor(vx1) * vw + min(frac(vx1), vw);
						audioLinkMask.b *= saturate((vI1 - vI0) / vdx);
					}
					
					float bandwidth = _ALDecalUVMode == 1 ? _ALDecalShapeClipBandWidth / aluv.y : _ALDecalShapeClipBandWidth;
					float bandth = 1.0 - bandwidth;
					if (_ALDecalBandStep != 0.0)
					{
						float bandInput = maskX * _ALDecalBandStep + bandth * 0.5;
						float bdx = max(fwidth(bandInput), 0.0001);
						float bx0 = bandInput - bdx * 0.5;
						float bx1 = bandInput + bdx * 0.5;
						float bI0 = floor(bx0) * bandth + min(frac(bx0), bandth);
						float bI1 = floor(bx1) * bandth + min(frac(bx1), bandth);
						audioLinkMask.b *= 1.0 - saturate((bI1 - bI0) / bdx);
					}
				}
				
				// Bilateral Mode
				float bilateralVolume = maskVolume;
				if (_ALDecalBilateral >= 0.5)
				{
					bilateralVolume = abs(maskVolume - 0.5) * 2.0;
				}
				
				// AudioLink
				float bandScale = 4.0 * _ALDecalBandRange;
				float alBandIndex = min(floor(audioLinkMask.g * bandScale), 3.0);
				float2 audioLinkUV = float2(frac(audioLinkMask.g * bandScale), (4.5 + alBandIndex) / 64.0);
				
				float audioVal;
				if (_ALDecalDebug >= 0.5)
				{
					float bandPos = maskBand;
					float bandHash = frac(sin(floor(bandPos * 128.0) * 43.7585) * 2847.15);
					half bassWeight = saturate(1.0 - bandPos * 2.0);
					half trebWeight = saturate(bandPos * 2.0 - 1.0);
					half midWeight = 1.0 - bassWeight - trebWeight;
					float speed = lerp(1.5, 6.0, bandPos);
					float t = POI_TIME.y;
					half pulse = saturate(sin(t * speed + bandHash * 6.283) * 0.7 + 0.3);
					pulse *= saturate(sin(t * speed * 0.37 + bandHash * 3.14) + 0.5);
					float beat = pow(saturate(sin(t * 1.8 + bandHash * 2.0) * 0.5 + 0.5), 2.0);
					audioVal = lerp(pulse, beat, bassWeight) * lerp(0.8, 0.3, trebWeight);
					audioVal *= _ALDecalVolume * lerp(_ALDecalBaseBoost, _ALDecalTrebleBoost, audioLinkMask.g);
				}
				else
				{
					float4 audioTexture = _AudioTexture.Sample(sampler_linear_clamp, audioLinkUV);
					audioVal = audioTexture.b * _ALDecalVolume * lerp(_ALDecalBaseBoost, _ALDecalTrebleBoost, audioLinkMask.g);
				}
				audioVal = tanh(audioVal);
				
				float audioLinkValue;
				if (_ALDecalLineWidth < 1.0 && _ALDecalVolumeStep != 0.0)
				{
					// Step percentage mode: lineWidth = percentage of total steps shown from top down (min 1 step)
					float stepSize = 1.0 / _ALDecalVolumeStep;
					float threshold = audioVal - max(_ALDecalLineWidth, stepSize);
					audioLinkValue = (audioVal > bilateralVolume && bilateralVolume >= threshold) ? 1.0 : 0.0;
				}
				else if (_ALDecalLineWidth < 1.0)
				{
					// Line mode (no steps active)
					float pixelSize = max(length(float2(ddx(bilateralVolume), ddy(bilateralVolume))), 0.0001);
					float thickness = _ALDecalLineWidth * 64.0;
					float marginUV = (thickness + 1.0) * pixelSize;
					float remappedAudio = lerp(marginUV, 1.0 - marginUV, audioVal);
					float d = abs(remappedAudio - bilateralVolume);
					float pixelDist = d / pixelSize;
					audioLinkValue = smoothstep(thickness + 1.0, thickness, pixelDist);
				}
				else
				{
					audioLinkValue = audioVal > bilateralVolume ? 1.0 : 0.0;
				}
				audioLinkValue = saturate(audioLinkValue) * audioLinkMask.b * tilingClip;
				//clip(audioLinkValue - .5);
				audioLinkValue *= colorAndMask.a;
				
				if (_ALDecalDebug < 0.5 && !poiMods.audioLinkAvailable)
				{
					audioLinkValue = 0;
				}
				
				// Debug: draw perimeter border
				float debugBorder = 0;
				if (_ALDecalDebug >= 0.5 && tilingClip > 0)
				{
					float bw = _ALDecalDebugBorderWidth;
					if (uv.x < bw || uv.x > 1 - bw || uv.y < bw || uv.y > 1 - bw)
					{
						debugBorder = 1;
					}
				}
				
				half3 alColorChord = float3(0, 0, 0);
				if (_ALDecalColorMode == 1)
				{
					if (_ALDecalDebug >= 0.5)
					{
						alColorChord = float3(
						saturate(sin(POI_TIME.y * 2.1 + maskBand * 13.0) * 0.5 + 0.5),
						saturate(sin(POI_TIME.y * 3.3 + maskBand * 7.7) * 0.5 + 0.5),
						saturate(sin(POI_TIME.y * 4.7 + maskBand * 19.1) * 0.5 + 0.5)
						);
					}
					else
					{
						alColorChord = _AudioTexture.Sample(sampler_linear_clamp, float2(maskBand, 24.5 / 64.0)).rgb;
					}
				}
				half volumeColorSrc = audioLinkMask.g;
				if (_ALDecalVolumeColorSource == 1) volumeColorSrc = bilateralVolume;
				if (_ALDecalVolumeColorSource == 2) volumeColorSrc = audioVal;
				
				half3 volumeColor = float3(0, 0, 0);
				half3 emissionColor = float3(0, 0, 0);
				if (_ALDecalColorMode == 1)
				{
					volumeColor = alColorChord;
					emissionColor = alColorChord * _ALDecalColorChordEmission;
				}
				else
				{
					half3 lowColor = poiThemeColor(poiMods, _ALDecalVolumeColorLow.rgb, _ALDecalVolumeColorLowThemeIndex);
					half3 midColor = poiThemeColor(poiMods, _ALDecalVolumeColorMid.rgb, _ALDecalVolumeColorMidThemeIndex);
					half3 highColor = poiThemeColor(poiMods, _ALDecalVolumeColorHigh.rgb, _ALDecalVolumeColorHighThemeIndex);
					
					volumeColor = lerp(lowColor, midColor, saturate(volumeColorSrc * 2));
					volumeColor = lerp(volumeColor, highColor, saturate(volumeColorSrc * 2 - 1));
					
					emissionColor = lerp(lowColor * _ALDecalLowEmission, midColor * _ALDecalMidEmission, saturate(volumeColorSrc * 2));
					emissionColor = lerp(emissionColor, highColor * _ALDecalHighEmission, saturate(volumeColorSrc * 2 - 1));
				}
				
				//poiFragData.baseColor = lerp(poiFragData.baseColor, volumeColor, audioLinkValue);
				half3 alColor = volumeColor * colorAndMask.rgb;
				half alCoverage = saturate(_ALDecalBlendAlpha * audioLinkValue);
				
				// --- Video Effects screen look (shared poiApplyScreenEffect helper) ---
				bool alScreenActive = false;
				half3 alScreenEmission = 0;
				#if defined(POI_VIDEO_EFFECTS) && (defined(POI_PASS_BASE) || defined(POI_PASS_ADD) || defined(POI_PASS_META))
				if (_ALDecalUseVideoEffects >= 0.5 && _VideoEffectsEnable >= 0.5)
				{
					PoiScreenEffect se;
					se.type = _VideoType;
					se.backlight = _VideoBacklight;
					se.contrast = _VideoContrast;
					se.saturation = _VideoSaturation;
					se.resolution = _VideoResolution;
					se.crtRefreshRate = _VideoCRTRefreshRate;
					se.crtPixelEnergizedTime = _VideoCRTPixelEnergizedTime;
					
					half3 pixels = 1.0h;
					#if defined(PROP_VIDEOPIXELTEXTURE) || !defined(OPTIMIZER_ENABLED)
					pixels = POI2D_SAMPLER(_VideoPixelTexture, _MainTex, poiUV(poiMesh.uv[_VideoPixelTextureUV], _VideoPixelTexture_ST) * se.resolution);
					#endif
					float2 screenUV = poiUV(poiMesh.uv[_MainTexUV], _MainTex_ST) + POI_TIME.x * _MainTexPan;
					
					half4 screenColor = float4(alColor, 1);
					poiApplyScreenEffect(screenColor, se, pixels, screenUV, poiCam, poiMesh);
					alColor = screenColor.rgb;
					alScreenActive = true;
					alScreenEmission = _VideoEmissionEnabled ? screenColor.rgb : (float3)0;
				}
				#endif
				
				// A screen occludes the emission already on the surface (incl. the main Video Effects glow)
				// so the spectrum reads as a solid screen; otherwise keep the original additive emission.
				if (alScreenActive)
				poiFragData.emission = lerp(poiFragData.emission, alScreenEmission, alCoverage);
				else
				poiFragData.emission += emissionColor * audioLinkValue;
				
				poiFragData.baseColor.rgb = lerp(poiFragData.baseColor, customBlend(poiFragData.baseColor, alColor, _ALDecalBlendType), alCoverage);
				if (debugBorder)
				{
					poiFragData.baseColor.rgb = float3(0, 1, 0);
					poiFragData.emission += float3(0, 1, 0);
				}
				poiFragData.alpha = lerp(poiFragData.alpha, poiFragData.alpha * audioLinkValue, _ALDecalControlsAlpha);
				
			}
			#endif
			#endif
			//endex
			
			//ifex _EnableFlipbook==0
			#ifdef _SUNDISK_HIGH_QUALITY
			
			void applyFlipbook(inout PoiFragData poiFragData, in PoiMesh poiMesh, in PoiMods poiMods)
			{
				#if defined(PROP_FLIPBOOKTEXARRAY) || !defined(OPTIMIZER_ENABLED)
				float4 flipBookPixel = float4(0, 0, 0, 0);
				#if defined(PROP_FLIPBOOKMASK) || !defined(OPTIMIZER_ENABLED)
				half flipBookMask = POI2D_SAMPLER_PAN(_FlipbookMask, _MainTex, poiUV(poiMesh.uv[_FlipbookMaskUV], _FlipbookMask_ST), _FlipbookMaskPan)[_FlipbookMaskChannel];
				#else
				half flipBookMask = 1;
				#endif
				if (_FlipbookMaskGlobalMask > 0)
				{
					flipBookMask = maskBlend(flipBookMask, poiMods.globalMask[_FlipbookMaskGlobalMask - 1], _FlipbookMaskGlobalMaskBlendType);
				}
				
				float2 flipbookScale = _FlipbookScale.xy;
				#ifdef POI_AUDIOLINK
				if (poiMods.audioLinkAvailable)
				{
					flipbookScale += lerp(_AudioLinkFlipbookScale.xy, _AudioLinkFlipbookScale.zw, poiMods.audioLink[_AudioLinkFlipbookScaleBand]);
				}
				#endif
				
				// Aspect ratio correction
				if (_FlipbookAspectRatioMode > 0)
				{
					float texWidth;
					float texHeight;
					float texFrames;
					_FlipbookTexArray.GetDimensions(texWidth, texHeight, texFrames);
					
					if (_FlipbookAspectRatioMode == 1) // Shrink to Fit
					{
						if (texWidth > texHeight)
						flipbookScale *= float2(1, texHeight / texWidth);
						else
						flipbookScale *= float2(texWidth / texHeight, 1);
					}
					else // Grow to Fit
					{
						if (texWidth > texHeight)
						flipbookScale *= float2(texWidth / texHeight, 1);
						else
						flipbookScale *= float2(1, texHeight / texWidth);
					}
				}
				
				float4 sideOffset = float4(-_FlipbookSideOffset.x, _FlipbookSideOffset.y, -_FlipbookSideOffset.z, _FlipbookSideOffset.w);
				float2 centerOffset = float2((sideOffset.x + sideOffset.y) / 2, (sideOffset.z + sideOffset.w) / 2);
				float2 uv = poiMesh.uv[_FlipbookTexArrayUV];
				
				// Symmetry mode
				if (_FlipbookSymmetryMode == 1) uv.x = abs(uv.x - 0.5) + 0.5;
				if (_FlipbookSymmetryMode == 2 && uv.x < 0.5) uv.x = uv.x + 0.5;
				
				// Mirrored UV mode
				if ((_FlipbookMirroredUVMode == 1 || _FlipbookMirroredUVMode == 4) && poiMesh.isRightHand) uv.x = 1.0 - uv.x;
				if (_FlipbookMirroredUVMode == 2 && poiMesh.isRightHand) uv.x = -1.0;
				if ((_FlipbookMirroredUVMode == 3 || _FlipbookMirroredUVMode == 4) && !poiMesh.isRightHand) uv.x = -1.0;
				
				float2 flipbookCenter = _FlipbookPosition + centerOffset;
				float theta = radians(_FlipbookRotation + POI_TIME.z * _FlipbookRotationSpeed);
				float cs = cos(theta);
				float sn = sin(theta);
				uv = float2((uv.x - flipbookCenter.x) * cs - (uv.y - flipbookCenter.y) * sn + flipbookCenter.x, (uv.x - flipbookCenter.x) * sn + (uv.y - flipbookCenter.y) * cs + flipbookCenter.y);
				float2 newUV = remap(uv, float2(0, 0) - flipbookScale / 2 + _FlipbookPosition + sideOffset.xz, flipbookScale / 2 + _FlipbookPosition + sideOffset.yw, float2(0, 0), float2(1, 1));
				
				half edgeAlpha = 1.0;
				
				if (_FlipbookTiled == 0)
				{
					float2 pixelWidth = fwidth(newUV) + 1.0e-7;
					float2 edgeFactor = (1.0 - abs(newUV * 2.0 - 1.0)) / pixelWidth;
					edgeAlpha = saturate(min(edgeFactor.x, edgeFactor.y));
				}
				else if (_FlipbookTiled == 2)
				{
					float2 tiledUVs = frac(newUV);
					float2 pixelWidth = fwidth(newUV) + 1.0e-7;
					float2 edgeFactor = (1.0 - abs(tiledUVs * 2.0 - 1.0)) / pixelWidth;
					edgeAlpha = saturate(min(edgeFactor.x, edgeFactor.y));
				}
				
				float currentFrame = 0;
				float width;
				float height;
				float totalFrames;
				_FlipbookTexArray.GetDimensions(width, height, totalFrames);
				
				if (_FlipbookStartAndEnd >= 0.5)
				{
					totalFrames -= (totalFrames - min(max(_FlipbookStartFrame, _FlipbookEndFrame), totalFrames));
					totalFrames -= max(0, _FlipbookStartFrame);
				}
				if (_FlipbookManualFrameControl < 0.5)
				{
					if (_FlipbookFPS != 0)
					{
						currentFrame = ((POI_TIME.y / (1 / _FlipbookFPS)) + _FlipbookFrameOffset) % totalFrames;
						if (_FlipbookStartAndEnd >= 0.5)
						{
							currentFrame += _FlipbookStartFrame;
						}
					}
				}
				else
				{
					currentFrame = fmod(_FlipbookCurrentFrame, totalFrames);
				}
				#ifdef POI_AUDIOLINK
				if (poiMods.audioLinkAvailable)
				{
					if (_FlipbookChronotensityEnabled >= 0.5)
					{
						currentFrame += AudioLinkGetChronoTime(_FlipbookChronoType, _FlipbookChronotensityBand) * _FlipbookChronotensitySpeed;
					}
					currentFrame += lerp(_AudioLinkFlipbookFrame.x, _AudioLinkFlipbookFrame.y, poiMods.audioLink[_AudioLinkFlipbookFrameBand]);
					float totalFramesAL = totalFrames;
					if (_FlipbookStartAndEnd >= 0.5)
					{
						totalFramesAL += max(0, _FlipbookStartFrame);
					}
					currentFrame %= totalFramesAL;
				}
				#endif
				
				float2 finalUV = TRANSFORM_TEX(newUV, _FlipbookTexArray) + POI_TIME.x * _FlipbookTexArrayPan;
				float2 ddxUV = ddx(finalUV);
				float2 ddyUV = ddy(finalUV);
				flipBookPixel = _FlipbookTexArray.SampleGrad(sampler_FlipbookTexArray, float3(finalUV, floor(currentFrame)), ddxUV, ddyUV);
				
				UNITY_BRANCH
				if (_FlipbookCrossfadeEnabled >= 0.5)
				{
					float totalFramesCF = totalFrames;
					if (_FlipbookStartAndEnd >= 0.5)
					{
						totalFramesCF += max(0, _FlipbookStartFrame);
					}
					float4 flipbookNextPixel = _FlipbookTexArray.SampleGrad(sampler_FlipbookTexArray, float3(finalUV, floor((currentFrame + 1) % totalFramesCF)), ddxUV, ddyUV);
					flipBookPixel = lerp(flipBookPixel, flipbookNextPixel, smoothstep(_FlipbookCrossfadeRange.x, _FlipbookCrossfadeRange.y, frac(currentFrame)));
				}
				
				UNITY_BRANCH
				if (_FlipbookIntensityControlsAlpha >= 0.5)
				{
					flipBookPixel.a = poiMax(flipBookPixel.rgb) * edgeAlpha;
				}
				else
				{
					flipBookPixel.a *= edgeAlpha;
				}
				UNITY_BRANCH
				if (_FlipbookColorReplaces >= 0.5)
				{
					flipBookPixel.rgb = poiThemeColor(poiMods, _FlipbookColor.rgb, _FlipbookColorThemeIndex);
				}
				else
				{
					flipBookPixel.rgb *= poiThemeColor(poiMods, _FlipbookColor.rgb, _FlipbookColorThemeIndex);
				}
				
				UNITY_BRANCH
				if (_FlipbookHueShiftEnabled >= 0.5)
				{
					flipBookPixel.rgb = hueShift(flipBookPixel.rgb, _FlipbookHueShift + POI_TIME.x * _FlipbookHueShiftSpeed, _FlipbookHueShiftColorSpace, _FlipbookHueSelectOrShift);
				}
				#ifdef POI_AUDIOLINK
				if (poiMods.audioLinkAvailable && _FlipbookALColorOverrideEnabled >= 0.5)
				{
					half alColorOverrideIntensity = poiMods.audioLink[_FlipbookALColorOverrideBand];
					half alColorOverrideBlend = evalRamp4(alColorOverrideIntensity, _FlipbookALColorOverrideRamp);
					if (alColorOverrideBlend > 0)
					{
						half3 alOverrideColor = _FlipbookALColorOverride.rgb;
						if (_FlipbookALColorOverrideThemeIndex > 0)
						{
							alOverrideColor = poiThemeColor(poiMods, alOverrideColor, _FlipbookALColorOverrideThemeIndex);
						}
